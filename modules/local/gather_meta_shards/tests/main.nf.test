nextflow_process {

    name "Test Process GATHER_META_SHARDS"
    script "../main.nf"
    process "GATHER_META_SHARDS"

    tag "modules"
    tag "modules_local"
    tag "gather_meta_shards"

    def header = 'SNPID\tCHR\tPOS\tEA\tNEA\tSTATUS\tEAF\tBETA\tSE\tP\tN\tMETA_VARIANT_KEY'

    def shard = { directory, stem, rows, columns = header ->
        def target = new File(directory.toString(), "${stem}.candidate.tsv.gz")
        target.withOutputStream { stream ->
            def gzip = new java.util.zip.GZIPOutputStream(stream)
            def body = rows.isEmpty() ? '' : rows.collect { row -> row.join('\t') }.join('\n') + '\n'
            gzip.write((columns + '\n' + body).bytes)
            gzip.close()
        }
        target
    }

    def record = { directory, stem, chromosome, eligible ->
        def target = new File(directory.toString(), "${stem}.qc.json")
        target.text = groovy.json.JsonOutput.toJson([chromosome: chromosome, fixed_eligible_variants: eligible]) + '\n'
        target
    }

    def readGzip = { path ->
        new java.util.zip.GZIPInputStream(new FileInputStream(path.toString())).getText('UTF-8')
    }

    def row = { name, chromosome, position ->
        [name, chromosome, position, 'A', 'G', '1999999', '3.0e-01', '1.0e-01', '2.0e-02', '5.0e-07', 1000, "${chromosome}:${position}:A:G"]
    }

    test("shards are concatenated in numeric chromosome order regardless of channel order") {
        when {
            // deliberately supplied out of order, and with X after the autosomes
            def two = shard(outputDir, 'req_chr2', [row('rs3', 2, 300), row('rs4', 2, 400)])
            def ten = shard(outputDir, 'req_chr10', [row('rs5', 10, 500)])
            def one = shard(outputDir, 'req_chr1', [row('rs1', 1, 100), row('rs2', 1, 200)])
            def x = shard(outputDir, 'req_chrX', [row('rs6', 'X', 600)])
            def rTwo = record(outputDir, 'req_chr2', '2', 2)
            def rTen = record(outputDir, 'req_chr10', '10', 1)
            def rOne = record(outputDir, 'req_chr1', '1', 2)
            def rX = record(outputDir, 'req_chrX', 'X', 1)
            process {
                """
                input[0] = [
                    [id: 'request'],
                    [file('${two}', checkIfExists: true), file('${ten}', checkIfExists: true), file('${one}', checkIfExists: true), file('${x}', checkIfExists: true)],
                    [file('${rTwo}', checkIfExists: true), file('${rTen}', checkIfExists: true), file('${rOne}', checkIfExists: true), file('${rX}', checkIfExists: true)],
                    ['1', '2', '10', 'X'],
                ]
                """
            }
        }

        then {
            def lines = readGzip(process.out.gathered.get(0).get(1)).readLines()
            def report = new groovy.json.JsonSlurper().parse(new File(process.out.report.get(0).get(1).toString()))
            assertAll(
                { assert process.success },
                { assert lines[0] == header },
                // 10 sorts numerically after 2, and X after every autosome
                { assert lines.drop(1).collect { line -> line.split('\t')[1] } == ['1', '1', '2', '2', '10', 'X'] },
                { assert lines.size() == 7 },
                { assert report.total_variants == 6 },
                { assert report.requested_chromosomes == ['1', '2', '10', 'X'] },
                { assert report.shards_gathered == 4 },
                { assert report.empty_chromosomes == [] },
                { assert report.per_chromosome.collect { entry -> entry.variants } == [2, 2, 1, 1] },
            )
        }
    }

    test("a legitimately empty chromosome is gathered as a header-only shard and recorded") {
        when {
            def one = shard(outputDir, 'empty_chr1', [row('rs1', 1, 100)])
            def two = shard(outputDir, 'empty_chr2', [])
            def rOne = record(outputDir, 'empty_chr1', '1', 1)
            def rTwo = record(outputDir, 'empty_chr2', '2', 0)
            process {
                """
                input[0] = [
                    [id: 'empty'],
                    [file('${one}', checkIfExists: true), file('${two}', checkIfExists: true)],
                    [file('${rOne}', checkIfExists: true), file('${rTwo}', checkIfExists: true)],
                    ['1', '2'],
                ]
                """
            }
        }

        then {
            def lines = readGzip(process.out.gathered.get(0).get(1)).readLines()
            def report = new groovy.json.JsonSlurper().parse(new File(process.out.report.get(0).get(1).toString()))
            assertAll(
                { assert process.success },
                { assert lines.size() == 2 },
                { assert report.total_variants == 1 },
                // the distinction that matters: empty is reported, not inferred from absence
                { assert report.empty_chromosomes == ['2'] },
                { assert report.shards_gathered == 2 },
            )
        }
    }

    test("a missing chromosome is refused rather than silently dropped") {
        when {
            def one = shard(outputDir, 'gap_chr1', [row('rs1', 1, 100)])
            def rOne = record(outputDir, 'gap_chr1', '1', 1)
            process {
                """
                input[0] = [
                    [id: 'gap'],
                    [file('${one}', checkIfExists: true)],
                    [file('${rOne}', checkIfExists: true)],
                    ['1', '2'],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('no shard completed for chromosome(s) 2') },
                { assert process.errorReport.contains('an absent output is never an empty chromosome') },
            )
        }
    }

    test("two shards claiming the same chromosome are refused") {
        when {
            def one = shard(outputDir, 'dupa_chr1', [row('rs1', 1, 100)])
            def two = shard(outputDir, 'dupb_chr1', [row('rs2', 1, 200)])
            def rOne = record(outputDir, 'dupa_chr1', '1', 1)
            def rTwo = record(outputDir, 'dupb_chr1', '1', 1)
            process {
                """
                input[0] = [
                    [id: 'dup'],
                    [file('${one}', checkIfExists: true), file('${two}', checkIfExists: true)],
                    [file('${rOne}', checkIfExists: true), file('${rTwo}', checkIfExists: true)],
                    ['1'],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('chromosome 1 was produced by more than one shard') },
            )
        }
    }

    test("an unexpected chromosome is refused") {
        when {
            def one = shard(outputDir, 'extra_chr1', [row('rs1', 1, 100)])
            def three = shard(outputDir, 'extra_chr3', [row('rs2', 3, 300)])
            def rOne = record(outputDir, 'extra_chr1', '1', 1)
            def rThree = record(outputDir, 'extra_chr3', '3', 1)
            process {
                """
                input[0] = [
                    [id: 'extra'],
                    [file('${one}', checkIfExists: true), file('${three}', checkIfExists: true)],
                    [file('${rOne}', checkIfExists: true), file('${rThree}', checkIfExists: true)],
                    ['1'],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('reports chromosome 3, which was not requested') },
            )
        }
    }

    test("a row labelled with the wrong chromosome is refused") {
        when {
            def one = shard(outputDir, 'wrong_chr1', [row('rs1', 1, 100), row('rs2', 2, 200)])
            def rOne = record(outputDir, 'wrong_chr1', '1', 2)
            process {
                """
                input[0] = [
                    [id: 'wrong'],
                    [file('${one}', checkIfExists: true)],
                    [file('${rOne}', checkIfExists: true)],
                    ['1'],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('row labelled chromosome 2 but the shard is chromosome 1') },
            )
        }
    }

    test("a variant duplicated across shards is refused") {
        when {
            def one = shard(outputDir, 'cross_chr1', [row('rs1', 1, 100)])
            def two = shard(outputDir, 'cross_chr2', [row('rs1', 1, 100)])
            def rOne = record(outputDir, 'cross_chr1', '1', 1)
            def rTwo = record(outputDir, 'cross_chr2', '2', 1)
            process {
                """
                input[0] = [
                    [id: 'cross'],
                    [file('${one}', checkIfExists: true), file('${two}', checkIfExists: true)],
                    [file('${rOne}', checkIfExists: true), file('${rTwo}', checkIfExists: true)],
                    ['1', '2'],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                // caught as a wrong-chromosome row first, which is the same corruption seen earlier
                { assert process.errorReport.contains('shard is chromosome 2') },
            )
        }
    }

    test("shards with incompatible headers are refused") {
        when {
            def one = shard(outputDir, 'hdr_chr1', [row('rs1', 1, 100)])
            def two = shard(outputDir, 'hdr_chr2', [], header + '\tEXTRA')
            def rOne = record(outputDir, 'hdr_chr1', '1', 1)
            def rTwo = record(outputDir, 'hdr_chr2', '2', 0)
            process {
                """
                input[0] = [
                    [id: 'hdr'],
                    [file('${one}', checkIfExists: true), file('${two}', checkIfExists: true)],
                    [file('${rOne}', checkIfExists: true), file('${rTwo}', checkIfExists: true)],
                    ['1', '2'],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('different header from the first shard') },
            )
        }
    }

    test("a shard whose row count disagrees with its completion record is refused") {
        when {
            def one = shard(outputDir, 'count_chr1', [row('rs1', 1, 100), row('rs2', 1, 200)])
            def rOne = record(outputDir, 'count_chr1', '1', 1)
            process {
                """
                input[0] = [
                    [id: 'count'],
                    [file('${one}', checkIfExists: true)],
                    [file('${rOne}', checkIfExists: true)],
                    ['1'],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('wrote 2 rows but its completion record reports 1') },
            )
        }
    }

    test("stub emits a valid gzip stream and version metadata") {
        options "-stub"

        when {
            def one = shard(outputDir, 'stub_chr1', [row('rs1', 1, 100)])
            def rOne = record(outputDir, 'stub_chr1', '1', 1)
            process {
                """
                input[0] = [
                    [id: 'stub'],
                    [file('${one}', checkIfExists: true)],
                    [file('${rOne}', checkIfExists: true)],
                    ['1'],
                ]
                """
            }
        }

        then {
            def versions = new File(process.out.versions.get(0).toString())
            assertAll(
                { assert process.success },
                { assert readGzip(process.out.gathered.get(0).get(1)).startsWith('SNPID\tCHR\tPOS') },
                { assert new File(process.out.report.get(0).get(1).toString()).exists() },
                { assert versions.readLines().first().endsWith(':') },
                { assert versions.text.contains('python:') },
            )
        }
    }
}

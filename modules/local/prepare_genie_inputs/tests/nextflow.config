process {
    // The pipeline's own bare `withName: 'PREPARE_GENIE_INPUTS'` block matches this scope too, because nf-test
    // loads the root `nextflow.config` for every test. Its publication closure would evaluate an unset
    // `params.outdir` into a literal `null/` tree beside the test, and its prefix belongs to the route rather
    // than to this component, so both are restated here.
    withName: 'PREPARE_GENIE_INPUTS' {
        ext.prefix = { meta.id }
        publishDir = []
    }
}

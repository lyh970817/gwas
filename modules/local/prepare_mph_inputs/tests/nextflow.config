process {
    // The pipeline's own bare `withName: 'PREPARE_MPH_INPUTS'` block matches this scope too, because nf-test
    // loads the root `nextflow.config` for every test, and its prefix closure reads the route-local selected
    // token this component test does not mint. It is restated here for that reason alone; the pipeline block
    // publishes nothing, so there is no publication policy to suppress.
    withName: 'PREPARE_MPH_INPUTS' {
        ext.prefix = { meta.id }
    }
}

nextflow_process {

    name "Test Process PREPARE_MPH_INPUTS"
    config "./nextflow.config"
    script "../main.nf"
    process "PREPARE_MPH_INPUTS"

    tag "modules"
    tag "modules_local"
    tag "prepare_mph_inputs"

    // Twelve samples is enough for every rule this module owns, and a hand-written cohort is the only way to
    // spell the inputs the rules exist for: an IID absent from the matrix, a family identifier that disagrees
    // with the FAM, a matrix sample list in the wrong order. Nothing here is shipped, because every file is
    // derived from the same twelve identities and a shipped copy would go stale beside them in silence.
    def pad = { index -> String.format('%02d', index) }
    def trait = { index -> String.format('%.4f', Math.sin(index * 0.7d) * 2.0d) }

    // The one order that matters. MPH indexes the relationship matrix by the *position* of an entry in
    // `.grm.iid`, so the FAM's IID column, the matrix sample list and the rows this module writes are all the
    // same sequence, and every fixture below keeps them that way unless the case under test is that they differ.
    def famText = (1..12).collect { index -> "f${pad(index)} s${pad(index)} 0 0 0 -9" }.join('\n') + '\n'
    def grmText = (1..12).collect { index -> "s${pad(index)}" }.join('\n') + '\n'
    def completePhenoText = (1..12).collect { index -> "f${pad(index)} s${pad(index)} ${trait(index)}" }.join('\n') + '\n'
    def completeQcovarText = "FID\tIID\tage\tpc1\n" + (1..12).collect { index -> "f${pad(index)}\ts${pad(index)}\t${30 + index}\t${String.format('%.4f', index * 0.011d)}" }.join('\n') + '\n'

    def sha256 = { bytes -> java.security.MessageDigest.getInstance('SHA-256').digest(bytes).encodeHex().toString() }
    def digestOf = { produced -> sha256(new File(produced.toString()).bytes) }
    def jsonOf = { produced -> new groovy.json.JsonSlurper().parseText(path(produced).text) }

    // The route-local keys `ROUTE_MPH_HERITABILITY` mints, built by hand so this test states the contract
    // rather than inheriting it. The default is the stratified family, because two components are what makes
    // `vc_name` matching by name rather than by row position observable at all.
    def metaTemplate = """
                    [
                        id: 'analysis',
                        trait: 'QT',
                        mph_estimator: 'mph_reml_ldms',
                        mph_capability: [
                            option_family: 'mph',
                            estimator_family: 'reml',
                            input_backend: 'mph_grm_family',
                            component_model: 'ld_maf_stratified',
                            stochastic: true,
                        ],
                        mph_trait_names: DECLARED_TRAITS,
                        mph_result: DECLARED_RESULT,
                        mph_matrix: [
                            key: 'mph_ldms.ab12cd34',
                            layer: 'cohort',
                            artifact_type: 'mph_ldms',
                            plan_key: DECLARED_PLAN_KEY,
                            plan_settings: [ ld_bins: 1, maf_bins: 2 ],
                            settings: [ variant_universe: 'autosomes' ],
                            components: DECLARED_COMPONENTS,
                            variant_counts: [ bim_rows: 2400, assigned: 2200, unassigned: 200 ],
                        ],
                        mph_grm_prefixes: DECLARED_PREFIXES,
                        mph_effective: [
                            seed: 7,
                            random_vectors: 100,
                            save_memory: false,
                            iterations: 20,
                            tolerance: 0.01,
                            requested: [ seed: 7, random_vectors: null, save_memory: false, iterations: null, tolerance: null ],
                            native_defaults_apply: ['random_vectors', 'iterations', 'tolerance'],
                            native_arguments: ['--seed 7'],
                        ],
                    ]
    """

    def defaultComponents = "[[ordinal: 1, name: 'ldms_1', plan_predictor_count: 1500], [ordinal: 2, name: 'ldms_2', plan_predictor_count: 700]]"
    def defaultPrefixes = "['grm_ldms_1', 'grm_ldms_2']"

    // The identity of the result this fit will produce, minted by the route and copied into the record
    // verbatim. Whether a fit is a unary heritability estimate or an oriented pair is a routing fact, so it is
    // declared here in both shapes rather than inferred from how many traits a case happens to name.
    def heritabilityResult = """[
                            kind: 'heritability',
                            analysis_id: 'analysis',
                            request_id: null,
                            relationship_id: null,
                            method: 'mph_reml_ldms',
                            left_analysis_id: null,
                            right_analysis_id: null,
                        ]"""
    def pairwiseResult = """[
                            kind: 'pairwise',
                            analysis_id: null,
                            request_id: 'mph_reml_ldms--rel_left_right',
                            relationship_id: 'rel_left_right',
                            method: 'mph_reml_ldms',
                            left_analysis_id: 'left',
                            right_analysis_id: 'right',
                        ]"""

    def declared = { knobs ->
        def settings = [traits: "['PHENO']", components: defaultComponents, prefixes: defaultPrefixes, plan_key: "'mph_ldms.plan.ef56'", result: heritabilityResult] + (knobs ?: [:])
        metaTemplate
            .replace('DECLARED_TRAITS', settings.traits)
            .replace('DECLARED_COMPONENTS', settings.components)
            .replace('DECLARED_PREFIXES', settings.prefixes)
            .replace('DECLARED_PLAN_KEY', settings.plan_key)
            .replace('DECLARED_RESULT', settings.result)
    }

    // Every file this module reads, written into the test's own output directory. `null` for a covariate table
    // means the analysis supplied none, which is a different model to an empty one and has to stage nothing.
    def fixtures = { directory, name, overrides ->
        def spec = [fam: famText, grm: grmText, pheno: completePhenoText, qcovar: completeQcovarText, catcovar: null] + (overrides ?: [:])
        def root = new File(directory.toString(), "mph_inputs_${name}")
        root.mkdirs()
        def write = { fileName, text ->
            def target = new File(root, fileName)
            target.text = text
            target
        }
        [
            root: root,
            write: write,
            fam: write('cohort.fam', spec.fam),
            grm: write('cohort.grm.iid', spec.grm),
            pheno: write('analysis.noheader.pheno', spec.pheno),
            qcovar: spec.qcovar == null ? null : write('analysis.qcovar', spec.qcovar),
            catcovar: spec.catcovar == null ? null : write('analysis.catcovar', spec.catcovar),
        ]
    }

    def staged = { produced -> produced == null ? '[]' : "file('${produced}', checkIfExists: true)" }

    // A `setup { run(...) }` process publishes its outputs to no channel a `then` block can read, so the one
    // file the parity case needs from it is found by name under the run's own work tree. It is produced once
    // and staged nowhere, so the match is unique and the assertion below fails loudly if it ever is not.
    def producedBeside = { anchor, fileName ->
        def work = new File(anchor.toString()).parentFile.parentFile.parentFile
        def found = []
        work.eachFileRecurse(groovy.io.FileType.FILES) { candidate ->
            if (candidate.name == fileName) {
                found << candidate
            }
        }
        assert found.size() == 1
        found.first()
    }

    def inputs = { fixture, meta ->
        """
                input[0] = [
                    ${meta},
                    file('${fixture.pheno}', checkIfExists: true),
                    ${staged(fixture.qcovar)},
                    ${staged(fixture.catcovar)}
                ]
                input[1] = [[ id: 'analysis' ], file('${fixture.grm}', checkIfExists: true), file('${fixture.fam}', checkIfExists: true)]
        """
    }

    test("the CSVs are written in matrix order and every missing spelling becomes an empty field") {

        when {
            // The source table is in the reverse of the matrix order, names one individual the cohort does not
            // contain, omits one the cohort does, and spells a missing trait in each of the three ways the
            // pipeline accepts.
            def fixture = fixtures(outputDir, 'aligned', [
                pheno: ((1..11).collect { index ->
                    def value = index == 2 ? 'NA' : index == 3 ? '-9' : index == 4 ? 'nan' : trait(index)
                    "f${pad(index)} s${pad(index)} ${value}"
                }.reverse() + ['f99 ghost 1.2500']).join('\n') + '\n',
            ])
            process {
                inputs(fixture, declared(null))
            }
        }

        then {
            def phenotype = path(process.out.phenotype.get(0).get(1))
            def covariates = path(process.out.covariates.get(0).get(1))
            def record = jsonOf(process.out.serialization.get(0).get(1))
            assertAll(
                { assert process.success },
                // MPH keys these files by IID and the matrix by position, so the header is the IID column plus
                // the declared trait names and the row order is the matrix sample list's, never the source's.
                { assert phenotype.readLines().first() == 'IID,PHENO' },
                { assert phenotype.readLines().size() == 12 },
                { assert phenotype.readLines()[1] == "s01,${trait(1)}" },
                { assert phenotype.readLines()[11] == "s11,${trait(11)}" },
                { assert phenotype.readLines().drop(1).collect { line -> line.split(',', -1).first() } == (1..11).collect { index -> "s${pad(index)}" } },
                // An empty field is MPH's only missing representation: a literal `NA` aborts it at exit 139 and
                // `-9` is read as the number minus nine.
                { assert phenotype.readLines()[2] == 's02,' },
                { assert phenotype.readLines()[3] == 's03,' },
                { assert phenotype.readLines()[4] == 's04,' },
                // The individual with no phenotype row is not written at all, rather than written empty.
                { assert !phenotype.text.contains('s12') },
                { assert !phenotype.text.contains('ghost') },
                // MPH synthesises an intercept only when no covariate is named, so the explicit column of ones
                // is written first and named first.
                { assert covariates.readLines().first() == 'IID,intercept,age,pc1' },
                { assert covariates.readLines().size() == 12 },
                { assert covariates.readLines().drop(1).every { line -> line.split(',', -1)[1] == '1' } },
                { assert covariates.readLines()[1] == 's01,1,31,0.0110' },
                // The sample accounting the sidecar publishes, every number of it computed here and once.
                // `retained` is the shared core key across every route's sidecar and means the sample the
                // estimate is computed on, so it is the complete-case count -- eight here, because three of
                // the eleven rows written carry a missing cell -- and not the eleven rows handed to MPH. That
                // count is `detail.written`.
                { assert record.inputs.samples.order_source == 'grm_iid' },
                { assert record.inputs.samples.retained == 8 },
                { assert record.inputs.samples.dropped == 4 },
                { assert record.inputs.samples.retained + record.inputs.samples.dropped == record.inputs.samples.detail.fam },
                { assert record.inputs.samples.detail.written == 11 },
                { assert record.inputs.samples.detail.fam == 12 },
                { assert record.inputs.samples.detail.grm == 12 },
                { assert record.inputs.samples.detail.phenotype_rows == 12 },
                { assert record.inputs.samples.detail.dropped_not_in_grm == 1 },
                { assert record.inputs.samples.detail.per_trait_nonmissing == [PHENO: 8] },
                { assert record.inputs.samples.detail.all_traits_nonmissing == 8 },
                { assert record.inputs.samples.detail.covariate_complete == 11 },
                { assert record.inputs.samples.detail.analysis_set_expected == 8 },
                // The pair overlap keys belong to an oriented pair result and say nothing about a single
                // trait, so a heritability result leaves all four null rather than restating `retained`.
                { assert record.inputs.samples.left_nonmissing == null },
                { assert record.inputs.samples.right_nonmissing == null },
                { assert record.inputs.samples.both == null },
                { assert record.inputs.samples.union == null },
                // MPH fits individuals with every named trait and every named covariate observed, which is not
                // what the other estimators do with the same tables, so the policy is named rather than implied.
                { assert record.inputs.samples.detail.sample_policy == 'complete_case_intersection' },
                // One trait names one primary result file: MPH writes the correlation table only for a fit
                // that names more than one.
                { assert record.result.primary_files == ['analysis.mq.vc.csv'] },
                // Only the post-fit writer can fill these, and it is the one component that does.
                { assert record.inputs.samples.detail.analysis_set_observed == null },
                { assert record.inputs.variants.retained == null },
                { assert record.solver_settings.iterations_run == null },
                { assert record.solver_settings.final_dLLpred == null },
                { assert record.stochastic_settings.num_threads == null },
                { assert record.classification == null },
                // The digests are over the bytes that were actually written, not over the sources.
                { assert record.inputs.samples.detail.order_sha256 == sha256((1..11).collect { index -> "s${pad(index)}\n" }.join('').getBytes('UTF-8')) },
                { assert record.inputs.sha256.phenotype == digestOf(process.out.phenotype.get(0).get(1)) },
                { assert record.inputs.sha256.covariates == digestOf(process.out.covariates.get(0).get(1)) },
                { assert record.inputs.sha256.grm_iid == sha256(grmText.getBytes('UTF-8')) },
                { assert record.inputs.sha256.annotation == null },
                { assert record.covariate_names == ['intercept', 'age', 'pc1'] },
                { assert record.trait_names == ['PHENO'] },
                // MPH copies each `--grm_list` entry verbatim into the matching result row's `vc_name`, so the
                // staged prefix is recorded per component and is the only key the post-fit writer can use.
                { assert record.component_plan.components == [
                    [ordinal: 1, name: 'ldms_1', vc_name: 'grm_ldms_1', plan_predictor_count: 1500, native_predictor_count: null],
                    [ordinal: 2, name: 'ldms_2', vc_name: 'grm_ldms_2', plan_predictor_count: 700, native_predictor_count: null],
                ] },
                { assert record.component_plan.plan_key == 'mph_ldms.plan.ef56' },
                { assert record.component_plan.matrix_key == 'mph_ldms.ab12cd34' },
                // A family built under a shared plan records the plan's settings as the ones that decided its
                // components, and the variant universe still comes from the matrix's own settings.
                { assert record.component_plan.settings == [ld_bins: 1, maf_bins: 2] },
                { assert record.inputs.variants.universe == 'autosomes' },
                { assert record.inputs.variants.bim_rows == 2400 },
                { assert record.inputs.variants.assigned == 2200 },
                { assert record.inputs.variants.unassigned == 200 },
                { assert record.result.method == 'mph_reml_ldms' },
                { assert record.estimator.input_backend == 'mph_grm_family' },
                { assert record.warnings == [
                    'complete_case_attrition: 3 of 11 individuals written have a missing trait or covariate cell and are dropped by MPH',
                    'dropped_not_in_grm: 1 phenotype row(s) name an individual absent from the matrix sample list',
                ] },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("a categorical covariate is dummy-encoded against its lexically first observed level") {

        when {
            // Two factors, so a missing value in one has to stay inside that factor's own dummies. `batch` is
            // observed at a, b and c; `site` at x and y.
            def fixture = fixtures(outputDir, 'factors', [
                qcovar: null,
                catcovar: "FID\tIID\tbatch\tsite\n" + (1..12).collect { index ->
                    def batch = index == 5 ? 'NA' : ['a', 'b', 'c'][index % 3]
                    "f${pad(index)}\ts${pad(index)}\t${batch}\t${index % 2 == 0 ? 'x' : 'y'}"
                }.join('\n') + '\n',
            ])
            process {
                inputs(fixture, declared(null))
            }
        }

        then {
            def covariates = path(process.out.covariates.get(0).get(1))
            def record = jsonOf(process.out.serialization.get(0).get(1))
            def rowOf = { iid -> covariates.readLines().find { line -> line.startsWith("${iid},") }.split(',', -1) }
            assertAll(
                { assert process.success },
                // MPH never expands a factor: a level column passed through verbatim is read as a magnitude and
                // the resulting rank deficiency is only a warning at exit 0. The reference level is the lexically
                // first observed one and gets no column, exactly as `prepare_phenotype_inputs` encodes it.
                { assert covariates.readLines().first() == 'IID,intercept,batch_b,batch_c,site_y' },
                { assert rowOf('s03') == ['s03', '1', '0', '0', '1'] },
                { assert rowOf('s04') == ['s04', '1', '1', '0', '0'] },
                { assert rowOf('s02') == ['s02', '1', '0', '1', '0'] },
                // A missing factor value is missing across every dummy of that factor and across no others.
                { assert rowOf('s05') == ['s05', '1', '', '', '1'] },
                { assert record.covariate_names == ['intercept', 'batch_b', 'batch_c', 'site_y'] },
                { assert record.inputs.samples.detail.covariate_complete == 11 },
                { assert record.inputs.samples.detail.analysis_set_expected == 11 },
                { assert record.warnings == ['complete_case_attrition: 1 of 12 individuals written have a missing trait or covariate cell and are dropped by MPH'] },
            )
        }
    }

    test("an analysis with no covariates emits no covariate file at all") {

        when {
            def fixture = fixtures(outputDir, 'nocovar', [qcovar: null])
            process {
                inputs(fixture, declared(null))
            }
        }

        then {
            def record = jsonOf(process.out.serialization.get(0).get(1))
            assertAll(
                { assert process.success },
                // Absence is a missing file, never an empty column list: MPH synthesises its own intercept only
                // when no covariate is named, so the two spell different models.
                { assert process.out.covariates.size() == 0 },
                { assert record.covariate_names == [] },
                { assert record.inputs.sha256.covariates == null },
                { assert record.inputs.samples.detail.covariate_complete == null },
                { assert record.inputs.samples.detail.analysis_set_expected == 12 },
                { assert record.warnings == [] },
            )
        }
    }

    test("a family with no plan above it records its own settings as the ones that decided its components") {

        when {
            // The single-component dense family: one matrix, one prefix, and no shared plan, so the settings
            // that decided the component are the matrix's own.
            def fixture = fixtures(outputDir, 'unplanned', [qcovar: null])
            process {
                inputs(fixture, declared([
                    plan_key: 'null',
                    components: "[[ordinal: 1, name: 'all_variants', plan_predictor_count: 2200]]",
                    prefixes: "['grm_all']",
                ]))
            }
        }

        then {
            def record = jsonOf(process.out.serialization.get(0).get(1))
            assertAll(
                { assert process.success },
                { assert record.component_plan.plan_key == null },
                { assert record.component_plan.settings == [variant_universe: 'autosomes'] },
                { assert record.component_plan.components == [
                    [ordinal: 1, name: 'all_variants', vc_name: 'grm_all', plan_predictor_count: 2200, native_predictor_count: null],
                ] },
            )
        }
    }

    test("an oriented pair is written under both declared trait names and carries the pair's own overlap") {

        when {
            def fixture = fixtures(outputDir, 'bivariate', [
                qcovar: null,
                pheno: (1..12).collect { index -> "f${pad(index)} s${pad(index)} ${trait(index)} ${trait(index + 20)}" }.join('\n') + '\n',
            ])
            process {
                inputs(fixture, declared([traits: "['L', 'R']", result: pairwiseResult]))
            }
        }

        then {
            def phenotype = path(process.out.phenotype.get(0).get(1))
            def record = jsonOf(process.out.serialization.get(0).get(1))
            assertAll(
                { assert process.success },
                // The declared order becomes `--trait_names` in this order and is what fixes which endpoint is
                // the left one in every native output, so the header is the route's order and not a sorted one.
                { assert phenotype.readLines().first() == 'IID,L,R' },
                { assert phenotype.readLines()[1] == "s01,${trait(1)},${trait(21)}" },
                // MPH indexes the matrix by the position of an entry in `.grm.iid`, so a pair's rows follow the
                // same sequence a single trait's do.
                { assert phenotype.readLines().drop(1).collect { line -> line.split(',', -1).first() } == (1..12).collect { index -> "s${pad(index)}" } },
                { assert record.trait_names == ['L', 'R'] },
                // The identity is the route's and is copied through: this module never reads the trait count to
                // decide which kind of result it is serialising for.
                { assert record.result.kind == 'pairwise' },
                { assert record.result.analysis_id == null },
                { assert record.result.request_id == 'mph_reml_ldms--rel_left_right' },
                { assert record.result.relationship_id == 'rel_left_right' },
                { assert record.result.left_analysis_id == 'left' },
                { assert record.result.right_analysis_id == 'right' },
                // MPH writes the correlation result if and only if more than one trait is named, so it is a
                // declared primary file of this fit exactly when the pair is fitted.
                { assert record.result.primary_files == ['analysis.mq.vc.csv', 'analysis.mq.cor.csv'] },
                // Complete on both endpoints here, so the four counts coincide. The case below is the one that
                // separates them.
                { assert record.inputs.samples.left_nonmissing == 12 },
                { assert record.inputs.samples.right_nonmissing == 12 },
                { assert record.inputs.samples.both == 12 },
                { assert record.inputs.samples.union == 12 },
                { assert record.inputs.samples.retained == 12 },
                { assert record.inputs.samples.detail.per_trait_nonmissing == [L: 12, R: 12] },
                { assert record.inputs.samples.detail.sample_policy == 'complete_case_intersection' },
            )
        }
    }

    test("a pair whose endpoints were measured on overlapping subsets records the overlap and the attrition") {

        when {
            // Two endpoints observed on different, overlapping parts of one cohort, which is what an ordinary
            // pair of manifest analyses looks like rather than an exception: `s01` and `s02` carry the right
            // endpoint only, `s03` to `s05` the left only, `s06` neither, and `s07` has a blank covariate cell.
            def fixture = fixtures(outputDir, 'bivariate_partial', [
                pheno: (1..12).collect { index ->
                    def left = index in [1, 2, 6] ? 'NA' : trait(index)
                    def right = index in [3, 4, 5, 6] ? 'NA' : trait(index + 20)
                    "f${pad(index)} s${pad(index)} ${left} ${right}"
                }.join('\n') + '\n',
                qcovar: "FID\tIID\tage\tpc1\n" + (1..12).collect { index ->
                    "f${pad(index)}\ts${pad(index)}\t${index == 7 ? '' : (30 + index).toString()}\t${String.format('%.4f', index * 0.011d)}"
                }.join('\n') + '\n',
            ])
            process {
                inputs(fixture, declared([traits: "['L', 'R']", result: pairwiseResult]))
            }
        }

        then {
            def record = jsonOf(process.out.serialization.get(0).get(1))
            assertAll(
                { assert process.success },
                // The fact a reader comparing two pair results needs: MPH fits the complete-case intersection
                // of both endpoints and every named covariate, so the sample the estimate describes can be far
                // smaller than the sample either endpoint was measured on, and nothing else published says so.
                { assert record.inputs.samples.left_nonmissing == 9 },
                { assert record.inputs.samples.right_nonmissing == 8 },
                { assert record.inputs.samples.both == 6 },
                { assert record.inputs.samples.union == 11 },
                { assert record.inputs.samples.both < record.inputs.samples.union },
                // `retained` is the shared core key and means the sample the estimate is computed on: the six
                // individuals complete on both endpoints, less the one whose covariate cell is blank.
                { assert record.inputs.samples.retained == 5 },
                { assert record.inputs.samples.dropped == 7 },
                { assert record.inputs.samples.detail.written == 12 },
                { assert record.inputs.samples.detail.covariate_complete == 11 },
                { assert record.inputs.samples.detail.all_traits_nonmissing == 6 },
                { assert record.inputs.samples.detail.analysis_set_expected == 5 },
                { assert record.inputs.samples.detail.sample_policy == 'complete_case_intersection' },
                { assert record.warnings == [
                    'complete_case_attrition: 7 of 12 individuals written have a missing trait or covariate cell and are dropped by MPH',
                ] },
            )
        }
    }

    test("the declared trait order is the route's own and is never sorted") {

        when {
            // Names that sort the other way round, so an implementation that ordered the columns itself would
            // write the endpoints the wrong way about and every native label would be reversed with it. The two
            // endpoints are deliberately observed on different numbers of individuals, so the left and right
            // counts distinguish which column is which as well as the header does.
            def fixture = fixtures(outputDir, 'bivariate_declared_order', [
                qcovar: null,
                pheno: (1..12).collect { index ->
                    def first = index == 1 ? 'NA' : trait(index)
                    def second = index in [2, 3] ? 'NA' : trait(index + 20)
                    "f${pad(index)} s${pad(index)} ${first} ${second}"
                }.join('\n') + '\n',
            ])
            process {
                inputs(fixture, declared([traits: "['ZTRAIT', 'ATRAIT']", result: pairwiseResult]))
            }
        }

        then {
            def phenotype = path(process.out.phenotype.get(0).get(1))
            def record = jsonOf(process.out.serialization.get(0).get(1))
            assertAll(
                { assert process.success },
                { assert phenotype.readLines().first() == 'IID,ZTRAIT,ATRAIT' },
                { assert record.trait_names == ['ZTRAIT', 'ATRAIT'] },
                // The declared first column is the one whose cell is empty for `s01`, which is what proves the
                // values travel under the names they were declared with.
                { assert phenotype.readLines()[1] == "s01,,${trait(21)}" },
                { assert record.inputs.samples.left_nonmissing == 11 },
                { assert record.inputs.samples.right_nonmissing == 10 },
                { assert record.inputs.samples.detail.per_trait_nonmissing == [ZTRAIT: 11, ATRAIT: 10] },
            )
        }
    }

    test("the covariate encoding is the one prepare_phenotype_inputs applies") {

        // The two modules encode covariates in two places for two consumers, so the rule is duplicated and this
        // is the test that pins the copies together. The wiring is the pipeline's own: the headered `.qcovar`
        // and `.catcovar` this module reads are the same files `PREPARE_PHENOTYPE_INPUTS` derived its LDAK
        // matrix-adjustment design from, so the numeric columns of both designs must agree cell for cell.
        setup {
            def parity = fixtures(outputDir, 'parity', [
                qcovar: "FID\tIID\tage\tpc1\n" + (1..12).collect { index ->
                    "f${pad(index)}\ts${pad(index)}\t${index == 7 ? 'NA' : (30 + index).toString()}\t${String.format('%.4f', index * 0.011d)}"
                }.join('\n') + '\n',
                catcovar: "FID\tIID\tbatch\n" + (1..12).collect { index ->
                    "f${pad(index)}\ts${pad(index)}\t${index == 4 ? '-9' : ['a', 'b', 'c'][index % 3]}"
                }.join('\n') + '\n',
            ])
            def source = parity.write('analysis.source.pheno', "FID\tIID\tQT\n" + (1..12).collect { index -> "f${pad(index)}\ts${pad(index)}\t${trait(index)}" }.join('\n') + '\n')
            run("PREPARE_PHENOTYPE_INPUTS") {
                script "../../prepare_phenotype_inputs/main.nf"
                process {
                    """
                    input[0] = [
                        [ id: 'analysis', phenotype_column: 'QT', is_binary: false, case_value: null, control_value: null, requires_complete_covariates: false ],
                        file('${source}', checkIfExists: true),
                        file('${parity.qcovar}', checkIfExists: true),
                        file('${parity.catcovar}', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            // The cohort identity only; the tables under test are the ones the setup module wrote.
            def parity = fixtures(outputDir, 'parity_identity', [qcovar: null])
            process {
                """
                input[0] = PREPARE_PHENOTYPE_INPUTS.out.phenotype_headerless
                    .join(PREPARE_PHENOTYPE_INPUTS.out.quant_covariates)
                    .join(PREPARE_PHENOTYPE_INPUTS.out.cat_covariates)
                    .map { _preparation_meta, headerless_phenotype, quant_covariates, cat_covariates ->
                        [ ${declared(null)}, headerless_phenotype, quant_covariates, cat_covariates ]
                    }
                input[1] = [[ id: 'analysis' ], file('${parity.grm}', checkIfExists: true), file('${parity.fam}', checkIfExists: true)]
                """
            }
        }

        then {
            def covariates = path(process.out.covariates.get(0).get(1)).readLines()
            def adjustment = producedBeside(process.out.covariates.get(0).get(1), 'analysis.adjustcovar').readLines()
            def record = jsonOf(process.out.serialization.get(0).get(1))
            // `.adjustcovar` is headerless `FID IID <design>`; this module's file is `IID intercept <design>`.
            // Both are in cohort order here, so the designs compare row for row after their own identifier
            // columns and the intercept are removed. The only permitted difference is the missing token: LDAK
            // reads `NA` and MPH reads an empty field, and nothing else may differ.
            def expected = adjustment.collect { line -> line.split('\t', -1).drop(2).collect { value -> value == 'NA' ? '' : value } }
            def observed = covariates.drop(1).collect { line -> line.split(',', -1).drop(2) }
            assertAll(
                { assert process.success },
                { assert adjustment.size() == 12 },
                { assert observed.size() == 12 },
                { assert covariates.first() == 'IID,intercept,age,pc1,batch_b,batch_c' },
                { assert record.covariate_names == ['intercept', 'age', 'pc1', 'batch_b', 'batch_c'] },
                // The rule under test, stated once outright so that two copies agreeing on a wrong encoding
                // would still fail here: quantitative columns verbatim, factors treatment-coded against the
                // lexically first observed level, a missing factor value missing across that factor's dummies
                // and across no others.
                { assert observed[6] == ['', '0.0770', '1', '0'] },
                { assert observed[3] == ['34', '0.0440', '', ''] },
                { assert observed == expected },
            )
        }
    }

    def rejections = [
        [
            name: 'a genotype FAM that lists one IID twice',
            overrides: { text -> [fam: text.split('\n').toList().with { rows -> (rows[0..3] + ['f05 s04 0 0 0 -9'] + rows[5..11]).join('\n') + '\n' }] },
            message: "lists IID 's04' more than once",
        ],
        [
            name: 'a matrix sample list in a different order to the FAM',
            overrides: { _text -> [grm: (1..12).collect { index -> "s${pad(index)}" }.reverse().join('\n') + '\n'] },
            message: 'the matrix was not built from this genotype bundle',
        ],
        [
            name: 'a phenotype row pairing an IID with a different family',
            overrides: { _text -> [pheno: (1..12).collect { index -> "${index == 5 ? 'zzz' : 'f' + pad(index)} s${pad(index)} ${trait(index)}" }.join('\n') + '\n'] },
            message: "phenotype row 'zzz s05' does not match the genotype FAM row 'f05 s05'",
        ],
        [
            name: 'a quantitative covariate cell that is not a number',
            overrides: { _text -> [qcovar: "FID\tIID\tage\tpc1\n" + (1..12).collect { index -> "f${pad(index)}\ts${pad(index)}\t${index == 3 ? 'abc' : (30 + index).toString()}\t0.5" }.join('\n') + '\n'] },
            message: "quantitative covariate 'age' of sample 'f03 s03' is 'abc', which is not a number",
        ],
        [
            name: 'a phenotype value that parses as a number but is not finite',
            overrides: { _text -> [pheno: (1..12).collect { index -> "f${pad(index)} s${pad(index)} ${index == 4 ? 'inf' : trait(index)}" }.join('\n') + '\n'] },
            message: "trait 'PHENO' of sample 'f04 s04' is 'inf', which is not finite",
        ],
        [
            name: 'a dummy column name carrying a comma',
            overrides: { _text -> [
                qcovar: null,
                catcovar: "FID\tIID\tbatch\n" + (1..12).collect { index -> "f${pad(index)}\ts${pad(index)}\t${index % 2 == 0 ? 'a' : 'z,q'}" }.join('\n') + '\n',
            ] },
            message: "covariate column name 'batch_z,q' contains a comma or whitespace",
        ],
    ]

    rejections.each { scenario ->
        test("preparation refuses ${scenario.name}") {

            when {
                def fixture = fixtures(outputDir, "reject_${scenario.name.replaceAll(/[^A-Za-z0-9]+/, '_')}", scenario.overrides(famText))
                process {
                    inputs(fixture, declared(null))
                }
            }

            then {
                // Every one of these runs to exit 0 inside MPH and returns a number that is either wrong or
                // never returned at all: a duplicate IID collapses the sample map, a reordered `.grm.iid`
                // moved the measured proportion of variance explained from 0.1156 to -0.2995 with nothing in
                // the output saying so, a name carrying a comma addresses a different column, `NA` aborts the
                // process at exit 139 and a `nan` phenotype makes the solver loop without bound.
                assertAll(
                    { assert !process.success },
                    { assert process.exitStatus != 0 },
                    { assert process.stdout.join('\n').contains("analysis 'analysis'") },
                    { assert process.stdout.join('\n').contains(scenario.message) }
                )
            }
        }
    }

    test("preparation refuses a trait name carrying a comma") {

        when {
            def fixture = fixtures(outputDir, 'reject_trait_comma', [qcovar: null])
            process {
                inputs(fixture, declared([traits: "['A,B']"]))
            }
        }

        then {
            assertAll(
                { assert !process.success },
                { assert process.stdout.join('\n').contains("trait name 'A,B' contains a comma or whitespace") },
                { assert process.stdout.join('\n').contains('MPH splits its name lists on commas') }
            )
        }
    }

    test("preparation refuses a matrix family that stages a different number of prefixes to the plan") {

        when {
            def fixture = fixtures(outputDir, 'reject_prefix_count', [qcovar: null])
            process {
                inputs(fixture, declared([prefixes: "['grm_ldms_1']"]))
            }
        }

        then {
            // The prefixes are the only key between the plan this pipeline built and the result MPH writes, so
            // a family that stages fewer of them than the plan declares would silently pair the wrong component
            // with the wrong count.
            assertAll(
                { assert !process.success },
                { assert process.stdout.join('\n').contains('stages 1 component prefix(es) but the plan declares 2 component(s)') }
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            def fixture = fixtures(outputDir, 'stub', null)
            process {
                inputs(fixture, declared(null))
            }
        }

        then {
            // The record is read on the head node by the writer that publishes the sidecar, so the stub has to
            // write a document that parses and whose covariate names are the ones its own covariate file
            // declares -- a stub that disagreed with itself would pass a route test that a real run fails.
            def record = jsonOf(process.out.serialization.get(0).get(1))
            def covariates = path(process.out.covariates.get(0).get(1))
            assertAll(
                { assert process.success },
                { assert record.covariate_names == covariates.readLines().first().split(',').drop(1).toList() },
                { assert record.trait_names == ['PHENO'] },
                { assert path(process.out.phenotype.get(0).get(1)).readLines().first() == 'IID,PHENO' },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("an empty tab-delimited covariate cell is a missing value and not a row shift") {

        when {
            // The ordinary way a tab-delimited file spells a missing value. Splitting such a line on arbitrary
            // whitespace would collapse the run of tabs, so `pc1` would be emitted under the name `age` and
            // every row would go one column short. The reader therefore splits a tab-carrying line on tabs,
            // which is the rule `prepare_phenotype_inputs` already applies to the same researcher-supplied
            // tables.
            def fixture = fixtures(outputDir, 'empty_cell', [
                qcovar: "FID\tIID\tage\tpc1\n" + (1..12).collect { index -> "f${pad(index)}\ts${pad(index)}\t${index == 6 ? '' : (30 + index).toString()}\t${String.format('%.4f', index * 0.011d)}" }.join('\n') + '\n',
            ])
            process {
                inputs(fixture, declared(null))
            }
        }

        then {
            def covariates = path(process.out.covariates.get(0).get(1)).readLines()
            def record = jsonOf(process.out.serialization.get(0).get(1))
            def emptied = covariates.find { line -> line.startsWith('s06,') }
            assertAll(
                { assert process.success },
                { assert covariates.first() == 'IID,intercept,age,pc1' },
                // The cell is empty and the value to its right is still under its own name.
                { assert emptied == 's06,1,,0.0660' },
                { assert covariates.every { line -> line.split(',', -1).size() == 4 } },
                // An incomplete covariate record is not part of the analysis set, and the accounting says so
                // rather than leaving the discrepancy to be discovered downstream.
                { assert record.inputs.samples.retained == 11 },
                { assert record.inputs.samples.detail.written == 12 },
                { assert record.inputs.samples.detail.covariate_complete == 11 },
                { assert record.inputs.samples.detail.analysis_set_expected == 11 },
                { assert record.warnings.any { warning -> warning.startsWith('complete_case_attrition:') } },
            )
        }
    }

    test("preparation refuses a covariate row carrying fewer fields than its header") {

        when {
            def fixture = fixtures(outputDir, 'ragged_covariates', [
                qcovar: "FID\tIID\tage\tpc1\n" + (1..12).collect { index -> index == 4 ? "f${pad(index)}\ts${pad(index)}\t${30 + index}" : "f${pad(index)}\ts${pad(index)}\t${30 + index}\t${String.format('%.4f', index * 0.011d)}" }.join('\n') + '\n',
            ])
            process {
                inputs(fixture, declared(null))
            }
        }

        then {
            // A ragged researcher-supplied table cannot be serialised without deciding which column each
            // field belongs to, so it is named and refused here rather than emitted as a short CSV row under
            // a full-width header. This is the check `prepare_phenotype_inputs` applies to the same tables.
            assertAll(
                { assert !process.success },
                { assert process.exitStatus != 0 },
                { assert process.stdout.join('\n').contains("analysis 'analysis'") },
                { assert process.stdout.join('\n').contains('declares 4 columns but line 5 carries 3 fields') },
            )
        }
    }
}

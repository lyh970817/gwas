params {
    module_args = ""
}

process {
    withName: REGENIE_SPLITL0 {
        ext.args = { params.module_args ?: "" }
    }
}

process {
    withName: 'REGENIE_STEP1.*|REGENIE_SPLITL0.*|REGENIE_RUNL0.*|REGENIE_RUNL1.*|REGENIE_STEP2' {
        ext.prefix = null
    }
}

// The public popgen fixture has 200 samples and 220 variants.
process {
    withName: 'REGENIE_.*' {
        cpus = 1
        memory = '2.GB'
    }
}

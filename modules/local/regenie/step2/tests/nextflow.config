params {
    module_args = ""
}

process {
    withName: 'REGENIE_STEP1_QUANTITATIVE|REGENIE_STEP1_QUANTITATIVE_PGEN' {
        ext.args = "--phenoColList QuantitativeTrait"
    }
    withName: REGENIE_STEP1_BINARY {
        ext.args = "--phenoColList BinaryTrait --bt"
    }
    withName: REGENIE_STEP2 {
        ext.args = { params.module_args ?: "" }
    }
}

process {
    withName: 'REGENIE_STEP1.*|REGENIE_SPLITL0.*|REGENIE_RUNL0.*|REGENIE_RUNL1.*|REGENIE_STEP2' {
        ext.prefix = null
    }
}

process {
    withName: REGENIE_STEP1_MULTITRAIT {
        ext.args = '--phenoColList QuantitativeTrait,QuantitativeTrait2 --use-relative-path'
    }
}

nextflow_process {

    name "Test Process GENIE_G"
    config "./nextflow.config"
    script "../main.nf"
    process "GENIE_G"

    tag "modules"
    tag "modules_local"
    tag "genie"
    tag "genie/g"

    // The shipped popgen trio is 200 samples by 220 variants with the FAM ordered `per0..per199`, and its
    // phenotype and covariate fixtures already carry a header row in that same order -- which is exactly the
    // shape GENIE demands, so they are passed through unchanged. `-jn 20` is mandatory on this fixture:
    // GENIE's own default of 1000 jackknife blocks exceeds 220 variants and raises a floating-point exception.
    def genotypes = """
                [
                    [ id: 'plink_simulated' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                ]
    """

    def phenotype = "file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_quantitative_phenoname.phe', checkIfExists: true)"
    def covariates = "file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated_covariates.txt', checkIfExists: true)"

    // The annotation, the count contract and the degenerate phenotype are written here rather than shipped,
    // because each is derived from the fixture's own dimensions and would go stale silently beside it.
    def inputs = { outputDir, name ->
        def root = new File(outputDir.toString(), "genie_${name}")
        root.mkdirs()
        def single = new File(root, 'annotation_single.txt')
        single.text = '1\n' * 220
        def paired = new File(root, 'annotation_paired.txt')
        paired.text = (0..<220).collect { index -> index % 2 == 0 ? '1 0' : '0 1' }.join('\n') + '\n'
        def constant = new File(root, 'constant.phe')
        constant.text = 'FID IID QuantitativeTrait\n' + (0..<200).collect { index -> "per${index} per${index} 1.5" }.join('\n') + '\n'
        def counts = { label, lines ->
            def target = new File(root, "expected_${label}.tsv")
            target.text = lines.collect { line -> line.join('\t') }.join('\n') + '\n'
            target
        }
        [
            single: single,
            paired: paired,
            constant: constant,
            covariates: counts('covariates', [['individuals', 200], ['covariates', 5], ['bin_0', 220]]),
            plain: counts('plain', [['individuals', 200], ['covariates', 1], ['bin_0', 220]]),
            paired_counts: counts('paired', [['individuals', 200], ['covariates', 5], ['bin_0', 110], ['bin_1', 110]]),
            wrong_individuals: counts('wrong_individuals', [['individuals', 199], ['covariates', 5], ['bin_0', 220]]),
            wrong_covariates: counts('wrong_covariates', [['individuals', 200], ['covariates', 4], ['bin_0', 220]]),
        ]
    }

    // The native invocation alone, with its line continuations collapsed. The interpreter line and the
    // post-run guards below the invocation are deliberately cut away: the shebang carries `-e`, and the
    // guards' own comments name several of the flags these cases assert are never emitted, so searching the
    // whole script would make every negative assertion answer about the wrong text.
    def command = { results ->
        def script = path(results).parent.resolve('.command.sh').text
        script.substring(script.indexOf('GENIE'), script.indexOf('| tee')).replaceAll(/\\\s+/, ' ').replaceAll(/\s+/, ' ')
    }

    def estimate = { results, label ->
        path(results).text.readLines().find { line -> line.startsWith(label) }.split(':')[1].trim().split(/\s+/)[0] as Double
    }

    test("homo_sapiens popgen - quantitative trait with covariates") {

        when {
            params {
                module_args = "-jn 20 -s 1"
            }
            process {
                """
                input[0] = ${genotypes}
                input[1] = [
                    [ id: 'plink_simulated' ],
                    ${phenotype},
                    ${covariates},
                    file('${inputs(outputDir, 'covariates').single}', checkIfExists: true),
                    file('${inputs(outputDir, 'covariates').covariates}', checkIfExists: true),
                    false
                ]
                """
            }
        }

        then {
            def results = process.out.results.get(0).get(1)
            assertAll(
                { assert process.success },
                // The model, projection and intercept flags are the module's own literals, and the four that
                // would change the estimand are unreachable: the pipeline exposes no native-argument surface
                // for GENIE, so `-e`, `-eXannot`, `-js` and `-tr` can never appear.
                { assert command(results).contains('GENIE -g "plink_simulated"') },
                { assert !command(results).contains('GENIE_mem') },
                { assert command(results).contains('-m G') },
                { assert command(results).contains('-np 0') },
                { assert command(results).contains('-i 1') },
                { assert command(results).contains('-t "2"') },
                { assert command(results).contains('-o "plink_simulated.out"') },
                { assert command(results).contains('-c "plink_simulated_covariates.txt"') },
                { assert !command(results).contains(' -e ') },
                { assert !command(results).contains('-eXannot') },
                { assert !command(results).contains('-js') },
                { assert !command(results).contains('-tr') },
                // GENIE always adds its own intercept, so five covariate columns are reported for the four
                // the file declares. Both counts are the ones the expected-count contract asserted against.
                { assert path(results).text.contains('Number of individuals after filtering: 200') },
                { assert path(results).text.contains('Number of covariates: 5') },
                { assert path(results).text.contains('Total h2') },
                { assert !path(results).text.contains('nan') },
                { assert process.out.versions_genie.get(0).get(1) == 'genie' },
                { assert process.out.versions_genie.get(0).get(2) == '1.1.1' },
                { assert process.out.xsum.size() == 0 },
                { assert process.out.wgxsum.size() == 0 },
                // The result is seeded and its thread echo is pinned by the configured `cpus`, so it is
                // content-stable. The log repeats it with per-block progress and is not.
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("homo_sapiens popgen - quantitative trait without covariates") {

        when {
            params {
                module_args = "-jn 20 -s 1"
            }
            process {
                """
                input[0] = ${genotypes}
                input[1] = [
                    [ id: 'plink_simulated' ],
                    ${phenotype},
                    [],
                    file('${inputs(outputDir, 'plain').single}', checkIfExists: true),
                    file('${inputs(outputDir, 'plain').plain}', checkIfExists: true),
                    false
                ]
                """
            }
        }

        then {
            def results = process.out.results.get(0).get(1)
            assertAll(
                { assert process.success },
                { assert !command(results).contains('-c ') },
                // One covariate with no covariate file at all: that one is GENIE's own intercept, which is
                // what makes the expected-count contract read `covariate columns + 1` rather than the width
                // of the file.
                { assert path(results).text.contains('Number of covariates: 1') },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("homo_sapiens popgen - the memory-efficient executable agrees with the in-memory one") {

        when {
            params {
                module_args = "-jn 20 -s 1"
            }
            process {
                """
                input[0] = ${genotypes}
                input[1] = [
                    [ id: 'plink_simulated' ],
                    ${phenotype},
                    ${covariates},
                    file('${inputs(outputDir, 'memory').single}', checkIfExists: true),
                    file('${inputs(outputDir, 'memory').covariates}', checkIfExists: true),
                    true
                ]
                """
            }
        }

        then {
            def results = process.out.results.get(0).get(1)
            assertAll(
                { assert process.success },
                { assert command(results).contains('GENIE_mem -g "plink_simulated"') },
                { assert process.out.xsum.size() == 1 },
                { assert process.out.wgxsum.size() == 1 },
                // The two executables write the same numbers in two header dialects: `GENIE_mem` separates
                // with `=` rather than `:` and calls the per-bin count "SNPs" rather than "features", under a
                // different self-reported banner version. The module's count assertion tolerates both, which
                // is the only reason this case reaches its result at all.
                { assert path(results).text.contains('Number of individuals after filtering = 200') },
                { assert path(results).text.contains('Number of SNPs in bin 0 = 220') },
                // The estimate is the same to well within the tolerance -- at this seed and this random-vector
                // count it is bit-identical. The tolerance is valid only at an identical seed and an identical
                // `-k`: across seeds at GENIE's native ten vectors the same estimate moves by about a third
                // of its own size.
                { assert Math.abs(estimate(results, 'h2_g[0]') - -0.0858201) < 1e-5 },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("homo_sapiens popgen - a two-component annotation fits two genetic variance components") {

        when {
            params {
                module_args = "-jn 20 -s 1"
            }
            process {
                """
                input[0] = ${genotypes}
                input[1] = [
                    [ id: 'plink_simulated' ],
                    ${phenotype},
                    ${covariates},
                    file('${inputs(outputDir, 'paired').paired}', checkIfExists: true),
                    file('${inputs(outputDir, 'paired').paired_counts}', checkIfExists: true),
                    false
                ]
                """
            }
        }

        then {
            def results = process.out.results.get(0).get(1)
            assertAll(
                { assert process.success },
                // The annotation decides how many components GENIE fits, and the per-bin counts it echoes are
                // asserted against the caller's declaration one bin at a time.
                { assert path(results).text.contains('Number of features in bin 0 : 110') },
                { assert path(results).text.contains('Number of features in bin 1 : 110') },
                { assert path(results).text.contains('Sigma^2_g[1]') },
                { assert path(results).text.contains('h2_g[1]') },
                { assert path(results).text.contains('Total h2') },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("homo_sapiens popgen - more jackknife blocks than variants aborts rather than estimating") {

        when {
            params {
                module_args = "-jn 5000 -s 1"
            }
            process {
                """
                input[0] = ${genotypes}
                input[1] = [
                    [ id: 'plink_simulated' ],
                    ${phenotype},
                    ${covariates},
                    file('${inputs(outputDir, 'crash').single}', checkIfExists: true),
                    file('${inputs(outputDir, 'crash').covariates}', checkIfExists: true),
                    false
                ]
                """
            }
        }

        then {
            // GENIE raises a floating-point exception when a jackknife block ends up empty. The task must
            // carry that failure out rather than publishing whatever the crashed run left behind, which is
            // what the shell's `pipefail` through `tee` and the `test -s` guard together provide.
            assertAll(
                { assert !process.success },
                { assert process.exitStatus != 0 }
            )
        }
    }

    test("homo_sapiens popgen - a constant phenotype is refused rather than published as -nan") {

        when {
            params {
                module_args = "-jn 20 -s 1"
            }
            process {
                """
                input[0] = ${genotypes}
                input[1] = [
                    [ id: 'plink_simulated' ],
                    file('${inputs(outputDir, 'constant').constant}', checkIfExists: true),
                    ${covariates},
                    file('${inputs(outputDir, 'constant').single}', checkIfExists: true),
                    file('${inputs(outputDir, 'constant').covariates}', checkIfExists: true),
                    false
                ]
                """
            }
        }

        then {
            // GENIE exits 0 here and writes a well-formed 1.1 kB result whose every variance component is
            // `-nan`, with all 200 samples still reported as retained. Without this guard the file would be
            // published as a heritability estimate.
            assertAll(
                { assert !process.success },
                { assert process.exitStatus != 0 },
                { assert process.errorReport.contains('returned a non-finite estimate') }
            )
        }
    }

    def countMismatches = [
        [
            name: 'a sample count',
            counts: 'wrong_individuals',
            message: 'GENIE reports individuals = 200 but the prepared inputs declare 199',
        ],
        [
            name: 'a covariate count, which is what catches a silently lost intercept',
            counts: 'wrong_covariates',
            message: 'GENIE reports covariates = 5 but the prepared inputs declare 4',
        ],
    ]

    countMismatches.each { scenario ->
        test("homo_sapiens popgen - the run is refused when GENIE disagrees with the caller about ${scenario.name}") {

            when {
                params {
                    module_args = "-jn 20 -s 1"
                }
                process {
                    """
                    input[0] = ${genotypes}
                    input[1] = [
                        [ id: 'plink_simulated' ],
                        ${phenotype},
                        ${covariates},
                        file('${inputs(outputDir, scenario.counts).single}', checkIfExists: true),
                        file('${inputs(outputDir, scenario.counts)[scenario.counts]}', checkIfExists: true),
                        false
                    ]
                    """
                }
            }

            then {
                // What this comparison genuinely catches is a stray header row changing the covariate width,
                // an annotation that disagrees with the variant file, and a retained-sample count the caller
                // did not predict. It does not catch a positional shift -- a covariate file missing one data
                // row runs at exit 0 with every count still matching. Feeding a deliberately wrong declaration
                // is the only way to prove the comparison is live rather than vacuous.
                assertAll(
                    { assert !process.success },
                    { assert process.exitStatus != 0 },
                    { assert process.errorReport.contains(scenario.message) }
                )
            }
        }
    }

    test("homo_sapiens popgen - an analysis identifier containing 'inf' does not fail a finite run") {

        when {
            params {
                module_args = "-jn 20 -s 1"
            }
            process {
                """
                input[0] = [
                    [ id: 'crp.inf.v2' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true)
                ]
                input[1] = [
                    [ id: 'crp.inf.v2' ],
                    ${phenotype},
                    ${covariates},
                    file('${inputs(outputDir, 'identifier').single}', checkIfExists: true),
                    file('${inputs(outputDir, 'identifier').covariates}', checkIfExists: true),
                    false
                ]
                """
            }
        }

        then {
            // GENIE echoes the staged file names above its result, and those names are built from the analysis
            // identifier. A non-finite check over the whole file therefore fires on an identifier containing
            // `inf` or `nan` between non-letters -- `crp.inf.v2`, `inf2024` -- which the manifest schema
            // permits and which abbreviations for inflammation or infection make reachable. The check is
            // scoped to the region below `OUTPUT:` for exactly this reason.
            def results = process.out.results.get(0).get(1)
            assertAll(
                { assert process.success },
                { assert path(results).text.contains('crp.inf.v2.out') },
                { assert path(results).text.contains('Total h2') },
                { assert !path(results).text.contains('nan') }
            )
        }
    }

    test("homo_sapiens popgen - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = ${genotypes}
                input[1] = [
                    [ id: 'plink_simulated' ],
                    ${phenotype},
                    ${covariates},
                    file('${inputs(outputDir, 'stub').single}', checkIfExists: true),
                    file('${inputs(outputDir, 'stub').covariates}', checkIfExists: true),
                    false
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert file(process.out.results.get(0).get(1)).name == "plink_simulated.out" },
                { assert file(process.out.log.get(0).get(1)).name == "plink_simulated.log" },
                { assert process.out.xsum.size() == 0 },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }

    test("homo_sapiens popgen - stub with the memory-efficient executable") {

        options "-stub"

        when {
            process {
                """
                input[0] = ${genotypes}
                input[1] = [
                    [ id: 'plink_simulated' ],
                    ${phenotype},
                    ${covariates},
                    file('${inputs(outputDir, 'stub_memory').single}', checkIfExists: true),
                    file('${inputs(outputDir, 'stub_memory').covariates}', checkIfExists: true),
                    true
                ]
                """
            }
        }

        then {
            // The stub branches on the same scalar as the script, so the extra output cardinality of the
            // memory-efficient executable is exercised in stub mode and therefore in every `-stub` route test
            // that runs above this module.
            assertAll(
                { assert process.success },
                { assert process.out.xsum.size() == 1 },
                { assert process.out.wgxsum.size() == 1 },
                { assert snapshot(sanitizeOutput(process.out, unstableKeys: ["log"])).match() }
            )
        }
    }
}

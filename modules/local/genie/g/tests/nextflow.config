params {
    module_args = ""
}

process {
    // The pipeline's own bare `withName: 'GENIE_G'` block matches this scope too, because nf-test loads the
    // root `nextflow.config` for every test. Its argument and prefix closures read the route-local metadata
    // this component test does not mint, and its publication closure would evaluate an unset `params.outdir`
    // into a literal `null/` tree beside the test, so all three are restated here. What is under test is the
    // component contract, not the pipeline's routing and publication policy.
    withName: 'GENIE_G' {
        ext.args   = { params.module_args ?: "" }
        ext.prefix = { meta.id }
        publishDir = []
        container  = System.getenv('GENIE_TEST_CONTAINER') ?: 'ghcr.io/lyh970817/genie@sha256:c4b836f6bdf5853c49d902e29f70a9a6540388a23d9b6840c9f3c67ad40d47e0'
        cpus       = 2
        memory     = 2.GB
    }
}

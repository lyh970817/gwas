nextflow_process {
    name "Test Process LDAK_THINCOMMON"
    script "../main.nf"
    process "LDAK_THINCOMMON"
    config "./nextflow.config"
    tag "modules"
    tag "modules_nfcore"
    tag "ldak"
    tag "ldak/thincommon"

    def fixture_code = '''
        def base = params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/'
        def source_bed = file(base + 'plink_simulated.bed', checkIfExists: true)
        def source_bim = file(base + 'plink_simulated.bim', checkIfExists: true)
        def source_fam = file(base + 'plink_simulated.fam', checkIfExists: true)
        def rows = source_bim.readLines()
        def split = (int) Math.ceil(rows.size() / 2.0)
        def multichr = rows.withIndex().collect { row, index ->
            def fields = row.tokenize()
            fields[0] = index < split ? '21' : '22'
            fields.join('\\t')
        }
        def bed = file('training.bed'); bed.bytes = source_bed.bytes
        def bim = file('training.bim'); bim.text = multichr.join('\\n') + '\\n'
        def fam = file('training.fam'); fam.bytes = source_fam.bytes
        def bytes_per_variant = (int) Math.ceil(source_fam.readLines().size() / 4.0)
        def chromosomes = [21, 22].collect { chr ->
            def first = chr == 21 ? 0 : split
            def last = chr == 21 ? split : rows.size()
            def chr_bed = file("testing_chr${chr}.bed")
            def records = source_bed.bytes
            chr_bed.bytes = (records[0..<3] + records[(3 + first * bytes_per_variant)..<(3 + last * bytes_per_variant)]) as byte[]
            def chr_bim = file("testing_chr${chr}.bim"); chr_bim.text = multichr[first..<last].join('\\n') + '\\n'
            def chr_fam = file("testing_chr${chr}.fam"); chr_fam.bytes = source_fam.bytes
            [chr_bed, chr_bim, chr_fam]
        }
        def phenotype = file(base + 'plink_simulated_quantitative_phenoname.phe', checkIfExists: true)
        def qcovar = file(base + 'plink_simulated_covariates.txt', checkIfExists: true)
        def extract = file('predictors.in'); extract.text = rows.collect { row -> row.tokenize()[1] }.join('\\n') + '\\n'
    '''

    test("homo_sapiens popgen - common predictors") {

        when {
            process {
                """
                ${fixture_code}
                input[0] = [[id:'cohort'], bed, bim, fam]
                """
            }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, unstableKeys: ['progress'])).match()
        }
    }
    test("homo_sapiens popgen - common predictors - stub") {
        options "-stub"
        when {
            process {
                """
                ${fixture_code}
                input[0] = [[id:'cohort'], bed, bim, fam]
                """
            }
        }
        then {
            assert process.success
            assert snapshot(sanitizeOutput(process.out, unstableKeys: ['progress'])).match()
        }
    }
}

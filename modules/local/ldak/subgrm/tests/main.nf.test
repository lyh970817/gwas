nextflow_process {
    name "Test Process LDAK_SUBGRM"
    script "../main.nf"
    config "./nextflow.config"
    process "LDAK_SUBGRM"
    tag "modules"
    tag "modules_nfcore"
    tag "ldak"
    tag "ldak/calckins"
    tag "ldak/subgrm"

    test("homo sapiens - native") {
        tag "ldak-subgrm-sample-subset"
        setup {
            run("LDAK_CALCKINS") {
                script "../../calckins/main.nf"
                process {
                    """
                    input[0] = Channel.of([[id:'base'], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true), -0.25])
                    input[1] = Channel.of([[id:'weights'], []])
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = LDAK_CALCKINS.out.ldak_grm.map { meta, bin, ids, details, adjust ->
                    def keep = file('samples.keep')
                    keep.text = ids.readLines().take(10).join('\\n') + '\\n'
                    [[id:'base'], [bin, ids, details, adjust], keep]
                }
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.sub_grm[0][2]).readLines().size() == 10 },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("homo sapiens - bed bim fam - stub") {
        options "-stub"
        setup {
            run("LDAK_CALCKINS") {
                script "../../calckins/main.nf"
                process {
                    """
                    input[0] = Channel.of([[id:'base'], file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bed', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.bim', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/plink_simulated.fam', checkIfExists: true), -0.25])
                    input[1] = Channel.of([[id:'weights'], []])
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = LDAK_CALCKINS.out.ldak_grm.map { meta, bin, ids, details, adjust -> [[id:'base'], [bin, ids, details, adjust], ids] }
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}

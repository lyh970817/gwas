process {
    // The pipeline's own block for this process uses a bare selector, so it reaches this scope too. The
    // prefix is route-local state a component test does not mint, and an empty `publishDir` keeps the route
    // publication from evaluating an unset `params.outdir` into a literal `null/` tree beside the test. Both
    // are restated here, on a selector of the same shape as the one they override, so this file wins by load
    // order rather than by selector phase.
    withName: 'DERIVE_GCTA_BIVARIATE_TOTAL' {
        ext.prefix = { "${meta.request_id}" }
        publishDir = []
    }
}

// Component-local test arguments, loaded explicitly from this module's test.
//
// This module's own selector needs nothing, but its setup blocks build PGEN bundles with `PLINK2_VCF`, and
// `nextflow.config` includes `conf/modules/genotypes.config` unconditionally, so the pipeline's bare
// `withName: 'PLINK2_VCF'` selector reaches that setup process. Declaring the static arguments here keeps
// them out of the pipeline-level `tests/nextflow.config`.
process {
    withName: 'PLINK2_VCF' {
        ext.args = '--double-id --vcf-half-call error'
    }
    // An aliased setup process escapes the selector above, because a `withName` regex must match the simple
    // name in full. That is what lets one test import dosages while the others do not: the import policy the
    // pipeline applies has no `dosage=` modifier, so a dosage-bearing PGEN can only be built here.
    withName: 'PHASED_DOSAGE_PGEN' {
        ext.args = 'dosage=HDS --double-id --vcf-half-call error'
    }
}

// Component-local test arguments, loaded explicitly from this module's test.
//
// This module's own selector needs nothing, but its multiallelic case builds a PGEN with `PLINK2_VCF` in a
// setup block, and `nextflow.config` includes `conf/modules/genotypes.config` unconditionally, so the
// pipeline's bare `withName: 'PLINK2_VCF'` selector reaches that setup process. Declaring the static
// arguments here keeps them out of the pipeline-level `tests/nextflow.config`.
process {
    withName: 'PLINK2_VCF' {
        ext.args = '--double-id --vcf-half-call error'
    }
}

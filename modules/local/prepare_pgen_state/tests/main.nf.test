nextflow_process {

    name "Test Process PREPARE_PGEN_STATE"
    script "../main.nf"
    process "PREPARE_PGEN_STATE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "prepare_pgen_state"

    def fixtures = { project_dir -> "${FIXTURES.base(project_dir)}results/fixtures/genotypes/" }

    test("example_all - the shipped PGEN reports a biallelic, phased, dosage-free state") {

        when {
            process {
                """
                input[0] = [
                    [ id:'cohort_pgen' ],
                    file('${fixtures.call(projectDir)}example_all.pgen', checkIfExists: true),
                    file('${fixtures.call(projectDir)}example_all.pvar', checkIfExists: true),
                    file('${fixtures.call(projectDir)}example_all.psam', checkIfExists: true),
                ]
                """
            }
        }

        then {
            def report = path(process.out.state.get(0).get(1)).text
            assertAll(
                { assert process.success },
                // All three facts the pipeline reads, in both their spellings. plink2 states the negatives
                // explicitly, which is what lets a caller distinguish a missing line from a false value.
                { assert report.contains('Maximum allele count for a single variant: 2') },
                { assert report.contains('Explicitly phased hardcalls present') },
                { assert report.contains('No dosages present') },
                { assert process.out.versions_plink2.get(0).get(1) == 'plink2' },
                { assert process.out.versions_plink2.get(0).get(2) ==~ /^[0-9][^\s]*$/ },
            )
        }
    }

    test("multiallelic - an imported multiallelic PGEN reports its true allele count") {

        setup {
            run("PLINK2_VCF") {
                script "../../plink2/vcf/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'multiallelic' ],
                        file('${RELATIONAL.multiallelicVcf(outputDir, 'multiallelic_state.vcf')}', checkIfExists: true),
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = PLINK2_VCF.out.pgen.map { meta, pgen, psam, pvar -> [ meta, pgen, pvar, psam ] }
                """
            }
        }

        then {
            def report = path(process.out.state.get(0).get(1)).text
            assertAll(
                { assert process.success },
                // plink2 imports a multiallelic VCF to PGEN without complaint, so this probe is the only
                // place the pipeline can learn the fact before it decides whether a PLINK 1 projection of
                // the bundle is admissible.
                { assert report.contains('Maximum allele count for a single variant: 3') },
            )
        }
    }

    test("example_all - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'cohort_pgen' ],
                    file('${fixtures.call(projectDir)}example_all.pgen', checkIfExists: true),
                    file('${fixtures.call(projectDir)}example_all.pvar', checkIfExists: true),
                    file('${fixtures.call(projectDir)}example_all.psam', checkIfExists: true),
                ]
                """
            }
        }

        then {
            def report = path(process.out.state.get(0).get(1)).text
            assertAll(
                { assert process.success },
                // The stub reports a state the caller's reader accepts, so a stubbed pipeline test exercises
                // the same parsing path as a real one.
                { assert report.contains('Maximum allele count for a single variant: 2') },
                { assert report.contains('No hardcalls are explicitly phased') },
                { assert report.contains('No dosages present') },
            )
        }
    }
}

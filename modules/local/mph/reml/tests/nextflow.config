params {
    // No curated option is rendered by default; cases that need one override this parameter.
    module_args = ""
}

process {
    // The pipeline's own bare `withName: 'MPH_REML'` block matches this scope too, because nf-test loads the
    // root `nextflow.config` for every test. Its argument closure reads the route-local effective settings
    // this component test does not mint, its prefix belongs to the route, and its publication closure would
    // evaluate an unset `params.outdir` into a literal `null/` tree beside the test, so all three are restated
    // here. What is under test is the component contract, not the pipeline's routing and publication policy.
    withName: 'MPH_REML' {
        // A case that must compare two native settings against each other has to run both arms inside one
        // invocation, because the comparison is between two runs on the same matrices and nf-test surfaces
        // only the process under test. A request that carries its own argument list therefore wins over the
        // scenario-wide parameter; every other case leaves `meta.native_args` unset and reads the parameter.
        ext.args   = { meta.native_args != null ? meta.native_args : (params.module_args ?: "") }
        ext.prefix = { meta.id }
        publishDir = []
        container  = System.getenv('MPH_TEST_CONTAINER') ?: 'ghcr.io/lyh970817/mph@sha256:561fc32443768cdaa80b1a56ed6d3f4190633d8c52d0f9fc8d0f9cc1694fad6a'
        cpus       = 2
        memory     = 2.GB
    }

    withName: 'MPH_MAKEGRM.*' {
        container = System.getenv('MPH_TEST_CONTAINER') ?: 'ghcr.io/lyh970817/mph@sha256:561fc32443768cdaa80b1a56ed6d3f4190633d8c52d0f9fc8d0f9cc1694fad6a'
        cpus      = 2
        memory    = 2.GB
    }
}

params {
    // MPH applies almost no quality control of its own, so nothing is passed by default; cases that need a
    // native filter override this parameter.
    module_args = ""
}

process {
    withName: 'MPH_MAKEGRM' {
        ext.args   = { params.module_args ?: "" }
        // Focused tests may replace the atom-owned immutable runtime; the default remains the same immutable
        // production manifest.
        container  = System.getenv('MPH_TEST_CONTAINER') ?: 'ghcr.io/lyh970817/mph@sha256:561fc32443768cdaa80b1a56ed6d3f4190633d8c52d0f9fc8d0f9cc1694fad6a'
        cpus       = 2
        memory     = 2.GB
    }
}

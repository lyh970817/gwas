nextflow_process {

    name "Test Process PREPARE_REGENIE_PHENOTYPES"
    script "../main.nf"
    process "PREPARE_REGENIE_PHENOTYPES"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "prepare_regenie_phenotypes"

    // Every member arrives in the canonical `FID IID PHENO` layout `PREPARE_PHENOTYPE_INPUTS` writes.
    def members = { outputDir, name, contents ->
        def root = new File(outputDir.toString(), "batch_${name}")
        root.mkdirs()
        return contents.collect { member ->
            def written = new File(root, "${member.key}.pheno")
            written.text = member.value
            written
        }
    }

    def COMPLETE_A = 'FID\tIID\tPHENO\nF1\tI1\t1.5\nF1\tI2\t2.5\nF2\tI3\t3.5\n'
    def COMPLETE_B = 'FID\tIID\tPHENO\nF1\tI1\t9.5\nF1\tI2\t8.5\nF2\tI3\t7.5\n'

    test("two compatible members become one multi-column table named by analysis id") {
        when {
            def staged = members(outputDir, 'compatible', [alpha: COMPLETE_A, beta: COMPLETE_B])
            process {
                """
                input[0] = [
                    [id: 'regenie.fitkey'],
                    [file('${staged[0]}', checkIfExists: true), file('${staged[1]}', checkIfExists: true)],
                    ['alpha', 'beta'],
                ]
                """
            }
        }

        then {
            def phenotype = new File(process.out.phenotype.get(0).get(1).toString())
            assertAll(
                { assert process.success },
                { assert phenotype.name == 'regenie.fitkey.pheno' },
                // The header carries the analysis identifiers, which is what REGENIE names its per-column
                // Step 2 output files after, and the rows keep the first member's order and values.
                { assert phenotype.text == 'FID\tIID\talpha\tbeta\nF1\tI1\t1.5\t9.5\nF1\tI2\t2.5\t8.5\nF2\tI3\t3.5\t7.5\n' },
            )
        }
    }

    test("a single-member batch is written through the same list seam") {
        when {
            def staged = members(outputDir, 'single', [alpha: COMPLETE_A])
            process {
                """
                input[0] = [
                    [id: 'regenie.solo'],
                    [file('${staged[0]}', checkIfExists: true)],
                    ['alpha'],
                ]
                """
            }
        }

        then {
            def phenotype = new File(process.out.phenotype.get(0).get(1).toString())
            assertAll(
                { assert process.success },
                // The `arity: '1..*'` regression: a bare `Path` would be iterated over its name elements
                // rather than staged as one file, so a one-member batch is the case that must be pinned.
                { assert phenotype.text == 'FID\tIID\talpha\nF1\tI1\t1.5\nF1\tI2\t2.5\nF2\tI3\t3.5\n' },
            )
        }
    }

    test("shared missingness is preserved verbatim") {
        when {
            def staged = members(outputDir, 'missing', [
                alpha: 'FID\tIID\tPHENO\nF1\tI1\t1.5\nF1\tI2\tNA\nF2\tI3\t3.5\n',
                beta: 'FID\tIID\tPHENO\nF1\tI1\t9.5\nF1\tI2\tNA\nF2\tI3\t7.5\n',
            ])
            process {
                """
                input[0] = [
                    [id: 'regenie.shared_missing'],
                    [file('${staged[0]}', checkIfExists: true), file('${staged[1]}', checkIfExists: true)],
                    ['alpha', 'beta'],
                ]
                """
            }
        }

        then {
            def phenotype = new File(process.out.phenotype.get(0).get(1).toString())
            assertAll(
                { assert process.success },
                { assert phenotype.text == 'FID\tIID\talpha\tbeta\nF1\tI1\t1.5\t9.5\nF1\tI2\tNA\tNA\nF2\tI3\t3.5\t7.5\n' },
            )
        }
    }

    test("the stub emits the batch header so a stubbed run still carries the column names") {
        options "-stub"

        when {
            def staged = members(outputDir, 'stub', [alpha: COMPLETE_A, beta: COMPLETE_B])
            process {
                """
                input[0] = [
                    [id: 'regenie.stubkey'],
                    [file('${staged[0]}', checkIfExists: true), file('${staged[1]}', checkIfExists: true)],
                    ['alpha', 'beta'],
                ]
                """
            }
        }

        then {
            def phenotype = new File(process.out.phenotype.get(0).get(1).toString())
            assertAll(
                { assert process.success },
                { assert phenotype.text == 'FID\tIID\talpha\tbeta\n' },
            )
        }
    }

    // Every rejection below is the batch key's claim asserted where the data actually is. The route groups
    // members it believes compatible; this module is what makes a wrong grouping a loud failure instead of
    // a silently different scientific answer.
    def incompatible = [
        [
            name: 'a member covering different samples',
            beta: 'FID\tIID\tPHENO\nF1\tI1\t9.5\nF1\tI2\t8.5\nF9\tI9\t7.5\n',
            message: 'must cover the same samples',
        ],
        [
            name: 'a member with different missingness',
            beta: 'FID\tIID\tPHENO\nF1\tI1\t9.5\nF1\tI2\tNA\nF2\tI3\t7.5\n',
            message: 'members whose missingness differs must not share one fit',
        ],
        [
            name: 'a member that is not in the prepared layout',
            beta: 'FID\tIID\tTRAIT\nF1\tI1\t9.5\nF1\tI2\t8.5\nF2\tI3\t7.5\n',
            message: 'must carry the header FID IID PHENO',
        ],
        [
            name: 'a member declaring a sample twice',
            beta: 'FID\tIID\tPHENO\nF1\tI1\t9.5\nF1\tI1\t8.5\nF2\tI3\t7.5\n',
            message: "declares sample 'F1 I1' more than once",
        ],
    ]

    incompatible.each { scenario ->
        test("the batch refuses ${scenario.name}") {
            when {
                def staged = members(outputDir, "invalid_${scenario.name.replace(' ', '_')}", [alpha: COMPLETE_A, beta: scenario.beta])
                process {
                    """
                    input[0] = [
                        [id: 'regenie.invalid'],
                        [file('${staged[0]}', checkIfExists: true), file('${staged[1]}', checkIfExists: true)],
                        ['alpha', 'beta'],
                    ]
                    """
                }
            }

            then {
                assertAll(
                    { assert process.failed },
                    { assert process.stdout.join('\n').contains("REGENIE batch 'regenie.invalid'") },
                    { assert process.stdout.join('\n').contains(scenario.message) },
                )
            }
        }
    }

    test("the batch refuses a caller that pairs the wrong number of identifiers") {
        when {
            def staged = members(outputDir, 'unpaired', [alpha: COMPLETE_A, beta: COMPLETE_B])
            process {
                """
                input[0] = [
                    [id: 'regenie.unpaired'],
                    [file('${staged[0]}', checkIfExists: true), file('${staged[1]}', checkIfExists: true)],
                    ['alpha'],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.stdout.join('\n').contains('paired positionally') },
            )
        }
    }
}

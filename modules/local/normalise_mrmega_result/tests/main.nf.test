nextflow_process {

    name "Test Process NORMALISE_MRMEGA_RESULT"
    script "../main.nf"
    process "NORMALISE_MRMEGA_RESULT"

    tag "modules"
    tag "modules_local"
    tag "normalise_mrmega_result"

    def emitted = [
        'META_VARIANT_KEY',
        'MRMEGA_CHISQ_ASSOC',
        'MRMEGA_CHISQ_ANCESTRY_HET',
        'MRMEGA_CHISQ_RESIDUAL_HET',
        'MRMEGA_DF_ASSOC',
        'MRMEGA_DF_ANCESTRY_HET',
        'MRMEGA_DF_RESIDUAL_HET',
        'MRMEGA_NATIVE_P_ASSOC',
        'MRMEGA_NATIVE_P_ANCESTRY_HET',
        'MRMEGA_NATIVE_P_RESIDUAL_HET',
        'MRMEGA_LNBF',
    ]

    // The native header is 20 + 2(T+1) columns wide, so it moves with the axis count
    def resultHeader = { axes ->
        def columns = ['MarkerName', 'Chromosome', 'Position', 'EA', 'NEA', 'EAF', 'Nsample', 'Ncohort', 'Effects']
        (0..axes).each { index -> columns += ["beta_${index}", "se_${index}"] }
        columns + [
            'chisq_association', 'ndf_association', 'P-value_association',
            'chisq_ancestry_het', 'ndf_ancestry_het', 'P-value_ancestry_het',
            'chisq_residual_het', 'ndf_residual_het', 'P-value_residual_het',
            'lnBF', 'Comments',
        ]
    }

    // statistics is chisq/ndf/P for association, ancestry heterogeneity and residual
    // heterogeneity, then the natural-log Bayes factor
    def resultRow = { name, axes, statistics, comment ->
        def fields = [name, '1', '1000500', 'A', 'G', '0.494104', '20000', '5', '+++++']
        (0..axes).each { index -> fields += ['0.0102529', '0.0117771'] }
        (fields + statistics + [comment]).join('\t')
    }

    def resultFile = { directory, stem, columns, rows ->
        def target = new File(directory.toString(), "${stem}.result")
        target.text = columns.join('\t') + '\n' + (rows.isEmpty() ? '' : rows.join('\n') + '\n')
        target
    }

    def readGzip = { path ->
        new java.util.zip.GZIPInputStream(new FileInputStream(path.toString())).getText('UTF-8')
    }

    test("a two-axis result maps through with the native P values carried as provenance only") {
        when {
            def native_result = resultFile(outputDir, 'plain', resultHeader(2), [
                resultRow('1:1000500:A:G', 2, ['3.69346', '3', '0.296524', '2.29949', '2', '0.316717', '2.72157', '2', '0.256459', '-0.567425'], 'NA'),
                // the real top hit: chi-square 7459 whose native association P saturates to exactly 1
                resultRow('5:20000500:A:G', 2, ['7459.01', '3', '1', '3.16201', '2', '0.205768', '0.616504', '2', '0.73473', '3727.09'], 'NA'),
            ])
            process {
                """
                input[0] = [
                    [id: 'plain'],
                    file('${native_result}', checkIfExists: true),
                    2,
                ]
                """
            }
        }

        then {
            def lines = readGzip(process.out.fields.get(0).get(1)).readLines()
            def report = new groovy.json.JsonSlurper().parse(new File(process.out.qc.get(0).get(1).toString()))
            def first = lines[1].split('\t') as List
            def second = lines[2].split('\t') as List
            assertAll(
                { assert process.success },
                // exactly the column set NORMALISE_COMMON_VARIANT_META reads, in order
                { assert lines[0].split('\t') as List == emitted },
                { assert lines.size() == 3 },
                // MarkerName already is the META_VARIANT_KEY; nothing is re-derived or joined
                { assert first[0] == '1:1000500:A:G' },
                { assert first == ['1:1000500:A:G', '3.69346', '2.29949', '2.72157', '3', '2', '2', '0.296524', '0.316717', '0.256459', '-0.567425'] },
                // the saturated native association P reaches MRMEGA_NATIVE_P_ASSOC and nowhere else
                { assert second[7] == '1' },
                { assert second == ['5:20000500:A:G', '7459.01', '3.16201', '0.616504', '3', '2', '2', '1', '0.205768', '0.73473', '3727.09'] },
                { assert report.rows_read == 2 },
                { assert report.rows_usable == 2 },
                { assert report.rows_nulled_total == 0 },
                { assert report.axes == 2 },
                { assert report.df_identity_expected.assoc == 3 },
                { assert report.df_identity_expected.ancestry_het == 2 },
                { assert report.df_identity_mismatches.assoc == 0 },
                { assert report.df_identity_mismatches.ancestry_het == 0 },
                { assert report.residual_df_range.min == 2 },
                { assert report.residual_df_range.max == 2 },
                { assert report.chisq_range.assoc.min == 3.69346 },
                { assert report.chisq_range.assoc.max == 7459.01 },
                { assert report.chisq_range.ancestry_het.max == 3.16201 },
                { assert report.chisq_range.residual_het.min == 0.616504 },
                { assert report.native_p_columns_carried == ['MRMEGA_NATIVE_P_ASSOC', 'MRMEGA_NATIVE_P_ANCESTRY_HET', 'MRMEGA_NATIVE_P_RESIDUAL_HET'] },
                { assert report.columns == emitted },
            )
        }
    }

    test("an unusable row is nulled in every statistic and counted by its comment") {
        when {
            def native_result = resultFile(outputDir, 'flagged', resultHeader(2), [
                resultRow('1:1000500:A:G', 2, ['3.69346', '3', '0.296524', '2.29949', '2', '0.316717', '2.72157', '2', '0.256459', '-0.567425'], 'NA'),
                resultRow('2:2000500:A:G', 2, ['NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA'], 'SmallCohortCount'),
                // a collinear row still carries numbers, which must not be published
                resultRow('3:3000500:A:G', 2, ['12.5', '3', '0.0058', '4.0', '2', '0.135', '1.0', '2', '0.606', '4.1'], 'collinear'),
            ])
            process {
                """
                input[0] = [
                    [id: 'flagged'],
                    file('${native_result}', checkIfExists: true),
                    2,
                ]
                """
            }
        }

        then {
            def lines = readGzip(process.out.fields.get(0).get(1)).readLines()
            def report = new groovy.json.JsonSlurper().parse(new File(process.out.qc.get(0).get(1).toString()))
            assertAll(
                { assert process.success },
                { assert lines.size() == 4 },
                { assert lines[2].split('\t') as List == ['2:2000500:A:G', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA'] },
                { assert lines[3].split('\t') as List == ['3:3000500:A:G', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA', 'NA'] },
                { assert report.rows_read == 3 },
                { assert report.rows_usable == 1 },
                { assert report.rows_nulled.SmallCohortCount == 1 },
                { assert report.rows_nulled.collinear == 1 },
                { assert report.rows_nulled_total == 2 },
                // the nulled rows never reach the chi-square range
                { assert report.chisq_range.assoc.max == 3.69346 },
            )
        }
    }

    test("a degree-of-freedom identity mismatch is reported without failing") {
        when {
            // the file was produced at two axes but three are declared, so both fixed identities break
            def native_result = resultFile(outputDir, 'mismatch', resultHeader(2), [
                resultRow('1:1000500:A:G', 2, ['3.69346', '3', '0.296524', '2.29949', '2', '0.316717', '2.72157', '2', '0.256459', '-0.567425'], 'NA'),
            ])
            process {
                """
                input[0] = [
                    [id: 'mismatch'],
                    file('${native_result}', checkIfExists: true),
                    3,
                ]
                """
            }
        }

        then {
            def report = new groovy.json.JsonSlurper().parse(new File(process.out.qc.get(0).get(1).toString()))
            assertAll(
                { assert process.success },
                { assert report.df_identity_expected.assoc == 4 },
                { assert report.df_identity_mismatches.assoc == 1 },
                { assert report.df_identity_mismatches.ancestry_het == 1 },
                { assert report.df_identity_mismatch_examples.collect { entry -> entry.column } == ['ndf_association', 'ndf_ancestry_het'] },
                { assert report.df_identity_mismatch_examples[0].expected == 4 },
                { assert report.df_identity_mismatch_examples[0].observed == '3' },
                // the residual degrees of freedom are per-marker and are never asserted against
                { assert report.residual_df_range.min == 2 },
            )
        }
    }

    test("a result missing a required source column is refused") {
        when {
            def columns = resultHeader(2).findAll { column -> column != 'lnBF' }
            def native_result = resultFile(outputDir, 'trimmed', columns, [
                resultRow('1:1000500:A:G', 2, ['3.69346', '3', '0.296524', '2.29949', '2', '0.316717', '2.72157', '2', '0.256459'], 'NA'),
            ])
            process {
                """
                input[0] = [
                    [id: 'trimmed'],
                    file('${native_result}', checkIfExists: true),
                    2,
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('missing required columns: lnBF') },
            )
        }
    }

    test("a header-only result is refused") {
        when {
            def native_result = resultFile(outputDir, 'headeronly', resultHeader(2), [])
            process {
                """
                input[0] = [
                    [id: 'headeronly'],
                    file('${native_result}', checkIfExists: true),
                    2,
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('carries a header but no data row') },
            )
        }
    }

    test("stub emits a valid gzip stream and version metadata") {
        options "-stub"

        when {
            def native_result = resultFile(outputDir, 'stub', resultHeader(2), [
                resultRow('1:1000500:A:G', 2, ['3.69346', '3', '0.296524', '2.29949', '2', '0.316717', '2.72157', '2', '0.256459', '-0.567425'], 'NA'),
            ])
            process {
                """
                input[0] = [
                    [id: 'stub'],
                    file('${native_result}', checkIfExists: true),
                    2,
                ]
                """
            }
        }

        then {
            def versions = new File(process.out.versions.get(0).toString())
            assertAll(
                { assert process.success },
                { assert readGzip(process.out.fields.get(0).get(1)).readLines()[0].split('\t') as List == emitted },
                { assert new File(process.out.qc.get(0).get(1).toString()).exists() },
                { assert versions.readLines().first().endsWith(':') },
                { assert versions.text.contains('python:') },
            )
        }
    }
}

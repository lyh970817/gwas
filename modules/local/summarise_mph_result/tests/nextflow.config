process {
    // The pipeline's own blocks for this process are qualified by their calling controller, so they do not
    // reach a bare process scope. The prefix is route-local state a component test does not mint, and an empty
    // `publishDir` keeps any route publication that later reaches this scope from evaluating an unset
    // `params.outdir` into a literal `null/` tree beside the test, so both are restated here.
    withName: 'SUMMARISE_MPH_RESULT' {
        ext.prefix = { meta.id }
        publishDir = []
    }
}

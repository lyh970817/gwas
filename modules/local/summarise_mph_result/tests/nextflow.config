process {
    // The pipeline's own bare `withName: 'SUMMARISE_MPH_RESULT'` block matches this scope too, because nf-test
    // loads the root `nextflow.config` for every test. Its prefix closure reads the route-local selected token
    // this component test does not mint, and its publication closure would evaluate an unset `params.outdir`
    // into a literal `null/` tree beside the test, so both are restated here.
    withName: 'SUMMARISE_MPH_RESULT' {
        ext.prefix = { meta.id }
        publishDir = []
    }
}

nextflow_process {

    name "Test Process PREPARE_MRMEGA_INPUT"
    script "../main.nf"
    process "PREPARE_MRMEGA_INPUT"

    tag "modules"
    tag "modules_local"
    tag "prepare_mrmega_input"

    def present = { eaf, beta, se, p, n -> ['9999999', eaf, beta, se, p, n] }
    def absent = { -> ['NA', 'NA', 'NA', 'NA', 'NA', 'NA'] }

    def views = { outputDir, name, studies, rows ->
        def header = ['META_VARIANT_KEY', 'SNPID', 'CHR', 'POS', 'EA', 'NEA']
        (1..studies).each { index ->
            header += ["STATUS_${index}", "EAF_${index}", "BETA_${index}", "SE_${index}", "P_${index}", "N_${index}"]
        }
        def lines = [header.join('\t')]
        rows.each { row -> lines << (row.take(6) + row.drop(6).collectMany { block -> block }).join('\t') }
        def target = new File(outputDir.toString(), "${name}.study_views.tsv.gz")
        target.withOutputStream { output ->
            def compressed = new java.util.zip.GZIPOutputStream(output)
            compressed.write((lines.join('\n') + '\n').getBytes('UTF-8'))
            compressed.close()
        }
        target
    }

    def gunzip = { target ->
        new java.util.zip.GZIPInputStream(new File(target.toString()).newInputStream()).getText('UTF-8')
    }

    // Four studies keeps the fixtures inside MR-MEGA's own K >= pc + 3 envelope at --pc 1.
    def names = ['STUDY_A', 'STUDY_B', 'STUDY_C', 'STUDY_D']

    test("quantitative route emits one native study file per study in manifest order") {
        when {
            def source = views(outputDir, 'qt', 4, [
                ['1:1000:A:G', 'rs1', '1', '1000', 'A', 'G',
                 present('0.25', '0.1', '0.01', '1e-4', '4000.0'),
                 present('0.26', '0.11', '0.012', '2e-4', '3000.0'),
                 present('0.24', '0.09', '0.014', '3e-4', '5000.0'),
                 present('0.27', '0.12', '0.011', '4e-4', '3500.0')],
                ['1:2000:T:C', 'rs2', '1', '2000', 'T', 'C',
                 present('0.4', '3.08662e-05', '6.06788e-06', '0.5', '4000.0'),
                 present('0.41', '-0.02', '0.02', '0.6', '3000.0'),
                 present('0.39', '0.01', '0.02', '0.7', '5000.0'),
                 present('0.42', '0.0', '0.02', '1.0', '3500.0')],
                ['23:3000:G:A', 'rs3', 'X', '3000', 'G', 'A',
                 present('0.15', '0.2', '0.03', '1e-6', '4000.0'),
                 present('0.16', '0.19', '0.031', '2e-6', '3000.0'),
                 present('0.14', '0.21', '0.029', '3e-6', '5000.0'),
                 present('0.17', '0.18', '0.032', '4e-6', '3500.0')],
                // Mitochondrial variants map to native code 26, which fails the binary's
                // `0 < chr < 26` test, so the whole marker is excluded and counted.
                ['26:4000:A:C', 'rs4', 'MT', '4000', 'A', 'C',
                 present('0.3', '0.05', '0.02', '0.01', '4000.0'),
                 present('0.3', '0.05', '0.02', '0.01', '3000.0'),
                 present('0.3', '0.05', '0.02', '0.01', '5000.0'),
                 present('0.3', '0.05', '0.02', '0.01', '3500.0')],
            ])
            process {
                """
                input[0] = [
                    [ id: 'qt' ],
                    file('${source}', checkIfExists: true),
                    ${groovy.json.JsonOutput.toJson(names)},
                    'quantitative'
                ]
                """
            }
        }

        then {
            def studyFiles = process.out.study_files.get(0)[1].collect { entry -> entry.toString() }
            def filelist = new File(process.out.filelist.get(0)[1].toString()).readLines()
            def report = new groovy.json.JsonSlurper().parse(new File(process.out.qc.get(0)[1].toString()))
            def first = gunzip(process.out.study_files.get(0)[1][0]).readLines()
            def joinMap = gunzip(process.out.join_map.get(0)[1]).readLines()
            assertAll(
                { assert process.success },
                { assert studyFiles.size() == 4 },
                { assert studyFiles.collect { entry -> entry.split('/').last() } == [
                    '01_STUDY_A.txt.gz', '02_STUDY_B.txt.gz', '03_STUDY_C.txt.gz', '04_STUDY_D.txt.gz'
                ] },
                { assert filelist == [
                    'qt.mrmega_inputs/01_STUDY_A.txt.gz',
                    'qt.mrmega_inputs/02_STUDY_B.txt.gz',
                    'qt.mrmega_inputs/03_STUDY_C.txt.gz',
                    'qt.mrmega_inputs/04_STUDY_D.txt.gz',
                ] },
                { assert filelist == filelist.sort(false) },
                { assert first[0] == 'MARKERNAME\tEA\tNEA\tEAF\tBETA\tSE\tN\tCHROMOSOME\tPOSITION' },
                { assert first.size() == 4 },
                // The marker key is the allele-aware META_VARIANT_KEY, never the rsID.
                { assert first[1] == '1:1000:A:G\tA\tG\t0.25\t0.1\t0.01\t4000\t1' + '\t1000' },
                // Shortest round-tripping output survives the pathological small-effect row.
                { assert first[2].contains('\t3.08662e-05\t6.06788e-06\t') },
                // X is emitted as the native chromosome code 23.
                { assert first[3].startsWith('23:3000:G:A\tG\tA\t0.15\t0.2\t0.03\t4000\t23\t3000') },
                { assert joinMap[0] == 'META_VARIANT_KEY\tSNPID\tCHR\tPOS\tEA\tNEA' },
                { assert joinMap.size() == 4 },
                { assert joinMap[3] == '23:3000:G:A\trs3\tX\t3000\tG\tA' },
                { assert report.trait_type == 'quantitative' },
                { assert report.study_count == 4 },
                { assert report.markers_input == 4 },
                { assert report.markers_emitted == 3 },
                { assert report.markers_union == 3 },
                { assert report.markers_intersection == 3 },
                { assert report.study_rows_emitted_total == 12 },
                { assert report.studies.collect { study -> study.rows_emitted } == [3, 3, 3, 3] },
                { assert report.studies.collect { study -> study.study_name } == names },
                { assert report.excluded_markers.unrepresentable_chromosome == 1 },
                { assert report.excluded_study_rows.unrepresentable_chromosome == 4 },
                { assert report.or_round_trip_max_relative_error == null },
                { assert report.markers_emitted + report.excluded_markers.values().sum() == report.markers_input },
            )
        }
    }

    test("binary route derives odds ratios and confidence bounds that round-trip to the log effect") {
        when {
            def source = views(outputDir, 'binary', 4, [
                ['1:1000:A:G', 'rs1', '1', '1000', 'A', 'G',
                 present('0.25', '0.1', '0.01', '1e-4', '4000.0'),
                 present('0.26', '0.11', '0.012', '2e-4', '3000.0'),
                 present('0.24', '0.09', '0.014', '3e-4', '5000.0'),
                 present('0.27', '0.12', '0.011', '4e-4', '3500.0')],
                ['1:2000:T:C', 'rs2', '1', '2000', 'T', 'C',
                 present('0.4', '3.08662e-05', '6.06788e-06', '0.5', '4000.0'),
                 present('0.41', '-0.02', '0.02', '0.6', '3000.0'),
                 present('0.39', '0.01', '0.02', '0.7', '5000.0'),
                 present('0.42', '0.0', '0.02', '1.0', '3500.0')],
            ])
            process {
                """
                input[0] = [
                    [ id: 'binary' ],
                    file('${source}', checkIfExists: true),
                    ${groovy.json.JsonOutput.toJson(names)},
                    'binary'
                ]
                """
            }
        }

        then {
            def report = new groovy.json.JsonSlurper().parse(new File(process.out.qc.get(0)[1].toString()))
            def rows = gunzip(process.out.study_files.get(0)[1][0]).readLines()
            def quantile = 1.959963984540054d
            def fields = rows[1].split('\t')
            def odds = fields[4] as double
            def lower = fields[5] as double
            def upper = fields[6] as double
            assertAll(
                { assert process.success },
                { assert rows[0] == 'MARKERNAME\tEA\tNEA\tEAF\tOR\tOR_95L\tOR_95U\tN\tCHROMOSOME\tPOSITION' },
                { assert Math.abs(Math.log(odds) - 0.1d) < 1e-15 },
                { assert Math.abs(Math.log(lower) - (0.1d - quantile * 0.01d)) < 1e-15 },
                { assert Math.abs(Math.log(upper) - (0.1d + quantile * 0.01d)) < 1e-15 },
                { assert Math.abs((Math.log(upper) - Math.log(lower)) / (2 * quantile) - 0.01d) < 1e-14 },
                { assert report.trait_type == 'binary' },
                { assert report.or_round_trip_max_scaled_error < 1e-12 },
                { assert report.or_round_trip_tolerance == 1e-12 },
                { assert report.or_confidence_quantile == quantile },
                // MR-MEGA inverts the interval with a hard-coded 1.96, so the standard error it
                // reconstructs is biased. The adapter records the bias rather than hiding it.
                { assert report.native_se_inverse_constant == 1.96 },
                { assert Math.abs(report.native_se_relative_bias + 1.837523466630131e-05) < 1e-18 },
            )
        }
    }

    test("a study that omits a variant simply omits the row from that study file") {
        when {
            def source = views(outputDir, 'sparse', 4, [
                ['1:1000:A:G', 'rs1', '1', '1000', 'A', 'G',
                 present('0.25', '0.1', '0.01', '1e-4', '4000.0'),
                 present('0.26', '0.11', '0.012', '2e-4', '3000.0'),
                 present('0.24', '0.09', '0.014', '3e-4', '5000.0'),
                 present('0.27', '0.12', '0.011', '4e-4', '3500.0')],
                ['1:2000:T:C', 'rs2', '1', '2000', 'T', 'C',
                 present('0.4', '0.03', '0.02', '0.5', '4000.0'),
                 absent(),
                 present('0.39', '0.01', '0.02', '0.7', '5000.0'),
                 present('0.42', '0.0', '0.02', '1.0', '3500.0')],
            ])
            process {
                """
                input[0] = [
                    [ id: 'sparse' ],
                    file('${source}', checkIfExists: true),
                    ${groovy.json.JsonOutput.toJson(names)},
                    'quantitative'
                ]
                """
            }
        }

        then {
            def report = new groovy.json.JsonSlurper().parse(new File(process.out.qc.get(0)[1].toString()))
            def second = gunzip(process.out.study_files.get(0)[1][1]).readLines()
            assertAll(
                { assert process.success },
                { assert second.size() == 2 },
                { assert second[1].startsWith('1:1000:A:G\t') },
                { assert report.studies.collect { study -> study.rows_emitted } == [2, 1, 2, 2] },
                { assert report.markers_union == 2 },
                { assert report.markers_intersection == 1 },
                { assert report.study_rows_emitted_total == 7 },
                { assert report.excluded_markers.no_contributing_study == 0 },
            )
        }
    }

    test("a contributing study with a missing effect allele frequency is rejected") {
        when {
            def source = views(outputDir, 'missing_eaf', 4, [
                ['1:1000:A:G', 'rs1', '1', '1000', 'A', 'G',
                 present('0.25', '0.1', '0.01', '1e-4', '4000.0'),
                 present('NA', '0.11', '0.012', '2e-4', '3000.0'),
                 present('0.24', '0.09', '0.014', '3e-4', '5000.0'),
                 present('0.27', '0.12', '0.011', '4e-4', '3500.0')],
            ])
            process {
                """
                input[0] = [
                    [ id: 'missing_eaf' ],
                    file('${source}', checkIfExists: true),
                    ${groovy.json.JsonOutput.toJson(names)},
                    'quantitative'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("non-numeric EAF value 'NA'") },
                { assert process.errorReport.contains('parse it as 0.0 and accept it silently') },
                { assert process.errorReport.contains('STUDY_B') },
            )
        }
    }

    test("stub emits a native study file per study, a manifest and valid gzip streams") {
        options "-stub"

        when {
            def source = views(outputDir, 'stub', 4, [
                ['1:1000:A:G', 'rs1', '1', '1000', 'A', 'G',
                 present('0.25', '0.1', '0.01', '1e-4', '4000.0'),
                 present('0.26', '0.11', '0.012', '2e-4', '3000.0'),
                 present('0.24', '0.09', '0.014', '3e-4', '5000.0'),
                 present('0.27', '0.12', '0.011', '4e-4', '3500.0')],
            ])
            process {
                """
                input[0] = [
                    [ id: 'stub' ],
                    file('${source}', checkIfExists: true),
                    ${groovy.json.JsonOutput.toJson(names)},
                    'binary'
                ]
                """
            }
        }

        then {
            def filelist = new File(process.out.filelist.get(0)[1].toString()).readLines()
            def versions = new File(process.out.versions.get(0).toString())
            assertAll(
                { assert process.success },
                { assert process.out.study_files.get(0)[1].size() == 4 },
                { assert filelist.size() == 4 },
                { assert filelist.last() == 'stub.mrmega_inputs/04_STUDY_D.txt.gz' },
                { assert gunzip(process.out.study_files.get(0)[1][0]).startsWith('MARKERNAME\tEA\tNEA\tEAF\tOR\tOR_95L\tOR_95U\tN\tCHROMOSOME\tPOSITION') },
                { assert gunzip(process.out.join_map.get(0)[1]).startsWith('META_VARIANT_KEY\tSNPID\tCHR\tPOS\tEA\tNEA') },
                { assert new groovy.json.JsonSlurper().parse(new File(process.out.qc.get(0)[1].toString())).stub },
                { assert versions.readLines().first().endsWith(':') },
                { assert versions.text.contains('python:') },
            )
        }
    }
}

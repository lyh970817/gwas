config {
    // location for all nf-test tests
    testsDir   = "."

    // nf-test directory including temporary files for each test
    workDir    = System.getenv("NFT_WORKDIR") ?: ".nf-test"

    // location of an optional nextflow.config file specific for executing tests
    configFile = "tests/nextflow.config"

    // Ignore tests from installed components and local reference checkouts.
    //
    // The worktree entries matter because `testsDir` is the repository root and linked worktrees live
    // underneath it. Discovery would otherwise collect every branch's copy of every test, including the
    // installed-component tests the entries above exclude here — those globs are anchored at the start of
    // the path, so they never match a nested copy. Those copies resolve `projectDir` into the worktree and
    // fail on include paths that leave the project root. No worktree exists in CI, so these are no-ops there.
    ignore     = [
        'modules/nf-core/**/tests/*',
        'subworkflows/nf-core/**/tests/*',
        '.references/**',
        '.worktrees/**',
        '.claude/**',
    ]

    // run all test with defined profile(s) from the main nextflow.config
    profile    = "test"

    // list of filenames or patterns that should be trigger a full test run
    triggers   = [
        '.github/actions/nf-test/action.yml',
        '.github/workflows/nf-test.yml',
        'assets/schema_*.json',
        'assets/test_profiles/*',
        'bin/*',
        'conf/**',
        'nextflow.config',
        'nextflow_schema.json',
        'nf-test.config',
        'tests/.nftignore',
        'tests/fixtures/**',
        'tests/lib/*',
        'tests/nextflow.config',
    ]

    // load the necessary plugins
    plugins {
        load "nft-utils@1.1.1"
    }
}

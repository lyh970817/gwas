/*
    Component gate nf-test config for this development host.

    Personal-track development infrastructure. It is not part of the portable pipeline
    and never enters an upstream pipeline or component diff.

    Identical to the `nf-core/modules` `nf-test.config` except that `configFile` is taken
    from `NFT_HOST_CONFIG`, so the host resource cap can be chained onto the repository's
    own `tests/config/nf-test.config`. Point `NFT_HOST_CONFIG` at
    `host_test_config.config` beside this file.
*/

config {
    // location for all nf-tests
    testsDir = "."

    // nf-test directory including temporary files for each test
    workDir = System.getenv("NFT_WORKDIR") ?: ".nf-test"

    // location of an optional nextflow.config file specific for executing tests
    configFile = System.getenv("NFT_HOST_CONFIG")

    // run all test with the defined docker profile from the main nextflow.config
    profile = ""

    // load the necessary plugins
    plugins {
        load "nft-anndata@0.4.1"
        load "nft-bam@0.7.0"
        load "nft-csv@0.1.0"
        load "nft-compress@0.1.0"
        load "nft-fasta@1.0.0"
        load "nft-fastq@0.1.0"
        load "nft-vcf@1.0.7"
        load "nft-utils@1.2.0"
    }
}

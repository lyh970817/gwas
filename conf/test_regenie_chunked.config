/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REGENIE chunked Step 1 route test options
------------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [cpus: 4, memory: '8.GB', time: '1.h']
}

params {
    // REGENIE association options
    regenie_step1_mode = 'chunked'
    regenie_step1_jobs = 3

    // Save controls
    // Required while the module selector is re-evaluated in this isolated config fragment.
    publish_dir_mode          = 'copy'
    save_regenie_predictions = true
}

// nf-test loads this scenario config after the pipeline config has already resolved its module
// selectors. Re-include the REGENIE selector after setting the save control so its publish gate sees
// the scenario value rather than the pipeline default.
includeConfig 'modules/regenie.config'

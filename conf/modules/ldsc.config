/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Standalone CBIIT Python 3 LDSC summary-statistics module options
----------------------------------------------------------------------------------------
*/

// LDSC MUNGING, HERITABILITY AND GENETIC CORRELATION

process {

    // Each atom owns the same immutable, digest-pinned CBIIT `ldsc39` runtime. This integration layer owns
    // only routing arguments, typed resources and publication.
    withName: 'LDSC_MUNGESUMSTATS' {
        ext.args = [
            '--snp SNPID',
            '--a1 EA',
            '--a2 NEA',
            '--signed-sumstats BETA,0',
            '--p P',
            '--N-col N',
        ].join(' ').trim()
        ext.prefix = { meta.munging_key }
    }

    withName: 'LDSC_H2_OBSERVED' {
        ext.args   = { meta.native_args.join(' ') }
        ext.prefix = { 'native.observed' }
        publishDir = [
            path: { "${params.outdir}/requests/ldsc_h2/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.observed.log',
        ]
    }

    withName: 'LDSC_H2_LIABILITY' {
        ext.args = {
            [
                "--samp-prev ${meta.effective_sample_prevalence.join(',')}",
                "--pop-prev ${meta.effective_population_prevalence.join(',')}",
                meta.native_args.join(' '),
            ].join(' ').trim()
        }
        ext.prefix = { 'native.liability' }
        publishDir = [
            path: { "${params.outdir}/requests/ldsc_h2/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.liability.log',
        ]
    }

    withName: 'LDSC_RG_OBSERVED' {
        ext.args   = { meta.native_args.join(' ') }
        ext.prefix = { 'native.observed' }
        publishDir = [
            path: { "${params.outdir}/requests/ldsc_rg/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.observed.log',
        ]
    }

    withName: 'LDSC_RG_LIABILITY' {
        ext.args = {
            [
                "--samp-prev ${meta.effective_sample_prevalence.join(',')}",
                "--pop-prev ${meta.effective_population_prevalence.join(',')}",
                meta.native_args.join(' '),
            ].join(' ').trim()
        }
        ext.prefix = { 'native.liability' }
        publishDir = [
            path: { "${params.outdir}/requests/ldsc_rg/${meta.request_id}" },
            mode: params.publish_dir_mode,
            pattern: 'native.liability.log',
        ]
    }

}

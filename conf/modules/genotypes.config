/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Cohort genotype preparation module options
----------------------------------------------------------------------------------------
*/

// COHORT GENOTYPE PREPARATION
//
// Preparation is representation-preserving: a PLINK 1 or PLINK 2 cohort is used exactly as supplied and
// nothing is published for it, a VCF cohort is imported to PGEN once, and one shared PLINK 1 hard-call
// projection is derived per PGEN cohort only when a selected method reads BED/BIM/FAM.
//
// Both conversion policies are declared once, in `prepare_cohort_genotypes` (`getVcfImportPolicy` and
// `getPlink1ProjectionPolicy`), and travel to the task in `meta.settings`. They are rendered into the native
// flags here, so the policy that enters the view identity and the policy the command actually applies are the
// same map and cannot drift apart. Each closure is total and loud: a caller that built no policy-bearing meta
// gets a named failure rather than a null dereference inside an operator closure.

process {

    withName: 'PLINK2_VCF' {
        // A VCF carries one sample identifier per sample, while both PLINK encodings carry a family
        // identifier as well. Without `--double-id` plink2 leaves the family identifier unset, so a
        // VCF-supplied cohort would not line up with the phenotype and covariate files that its
        // PLINK-supplied siblings use. `--vcf-half-call error` refuses a half-call rather than silently
        // choosing one of plink2's four resolutions for it.
        ext.args   = {
            if (!(meta.settings?.containsKey('sample_id_policy') && meta.settings?.containsKey('half_call'))) {
                throw new IllegalStateException("[nf-core/gwas] ERROR: PLINK2_VCF task '${meta.id}' was invoked without a VCF import policy in meta.settings; pipeline callers build it with getVcfImportPolicy(), other callers must set ext.args themselves.")
            }
            [
                meta.settings.sample_id_policy == 'double_id' ? '--double-id' : '',
                "--vcf-half-call ${meta.settings.half_call}",
            ].join(' ').trim()
        }
        // The imported bundle is the only genotype bundle this pipeline builds, so it is the only one that
        // can be published. The path is keyed by cohort rather than flat, because two cohorts may
        // legitimately be supplied files of the same basename and their bundles must not overwrite each
        // other. The conversion log is deliberately not published: it records container-local paths and a
        // timestamp, so it is provenance noise rather than a result.
        publishDir = [path: { "${params.outdir}/genotypes/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.{pgen,psam,pvar}', enabled: params.save_prepared_genotypes]
    }

    withName: 'PLINK2_MAKEBED' {
        // The hard-call projection threshold is made explicit rather than left to plink2's default, because
        // it changes the projected bytes whenever dosages are present and is therefore part of the
        // derivative's identity. No `--max-alleles`: a multiallelic source is refused by preparation before
        // the task is created, and by plink2 natively, and filtering variants away would make the derivative
        // a different variant set rather than a different encoding of the same one.
        ext.args = {
            if (!meta.settings?.containsKey('hard_call_threshold')) {
                throw new IllegalStateException("[nf-core/gwas] ERROR: PLINK2_MAKEBED task '${meta.id}' was invoked without a projection policy in meta.settings; pipeline callers build it with getPlink1ProjectionPolicy(), other callers must set ext.args themselves.")
            }
            "--hard-call-threshold ${meta.settings.hard_call_threshold}"
        }
        // Deliberately no publishDir: the PLINK 1 derivative is a work-directory intermediate. What the
        // researcher gets instead is the view record, which states the derivative's identity, the policy that
        // produced it and what that policy discarded.
    }

    // PREPARE_GENOTYPE_SOURCE and PREPARE_PGEN_STATE deliberately have no block here. The process-wide
    // default publishes nothing, and neither probe's output is a result: their facts reach the researcher
    // through `genotypes/<cohort_id>/<cohort_id>.genotype_view.json`, which the pipeline always writes.
}

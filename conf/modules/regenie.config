/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REGENIE association module options
------------------------------------------------------------------------------------------
*/

// REGENIE ASSOCIATION

process {

    // Every Step 1 execution mode reads the same canonical trait and derives binary mode from the
    // immutable analysis metadata. Low-memory temporary predictions remain in the task work
    // directory; only the final prediction list and LOCO bundle are optionally published below.
    withName: 'REGENIE_STEP1|REGENIE_SPLITL0|REGENIE_RUNL0|REGENIE_RUNL1' {
        ext.args = {
            [
                '--phenoColList PHENO',
                meta.is_binary ? '--bt' : '',
                params.regenie_lowmem ? '--lowmem' : '',
                params.regenie_lowmem ? "--lowmem-prefix ${meta.id}.regenie_lowmem" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.regenie_step1" }
    }

    // Standard Step 1 and chunked Run L1 are mutually exclusive producers of the same reusable
    // prediction bundle. The bundle is an intermediate, absent by default and addressed by analysis
    // identity when explicitly requested.
    withName: 'REGENIE_STEP1|REGENIE_RUNL1' {
        publishDir = [
            path: { "${params.outdir}/intermediates/regenie/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*{_pred.list,.loco.gz}',
            enabled: params.save_regenie_predictions,
        ]
    }

    withName: 'REGENIE_STEP2' {
        ext.args = {
            [
                '--phenoColList PHENO',
                meta.is_binary ? '--bt' : '',
                meta.is_binary && params.regenie_firth ? '--firth' : '',
                meta.is_binary && params.regenie_firth && params.regenie_firth_approx ? '--approx' : '',
                meta.is_binary && params.regenie_firth ? "--pThresh ${params.regenie_firth_p_threshold}" : '',
                params.regenie_min_mac != null ? "--minMAC ${params.regenie_min_mac}" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.regenie" }
        publishDir = [
            path: { "${params.outdir}/association/regenie/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.regenie.gz',
            // REGENIE injects the selected phenotype column between the configured prefix and the
            // fixed result suffix. Normalisation makes that token the constant PHENO, so remove it
            // deterministically while preserving the native file contents.
            saveAs: { filename -> filename.replace('_PHENO.regenie.gz', '.gz') },
        ]
    }
}

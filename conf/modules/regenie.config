/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REGENIE association module options
----------------------------------------------------------------------------------------
*/

// REGENIE ASSOCIATION

process {

    // `PREPARE_REGENIE_PHENOTYPES` writes the batch's native phenotype file. It is a rearrangement of
    // already-published prepared phenotypes and carries no result, so it is deliberately given no
    // `publishDir` at all. Stated here rather than left implicit, so its absence reads as a decision.

    // Every Step 1 execution mode fits the whole batch in one invocation and derives binary mode from the
    // immutable fit metadata. The column list is the batch's analysis identifiers: REGENIE names its
    // per-column outputs after them, which is what makes those outputs attributable. The list is
    // single-quoted as the shell-side half of a two-layer defence whose primary layer is the ingress rule
    // in `validate_gwas_input` restricting an `analysis_id` that selects REGENIE to a safe column-name
    // class. Low-memory temporary predictions remain in the task work directory.
    withName: 'REGENIE_STEP1|REGENIE_SPLITL0|REGENIE_RUNL0|REGENIE_RUNL1' {
        ext.args   = {
            [
                "--phenoColList '${meta.phenotype_columns.join(',')}'",
                meta.is_binary ? '--bt' : '',
                params.regenie_lowmem ? '--lowmem' : '',
                params.regenie_lowmem ? "--lowmem-prefix ${meta.id}.regenie_lowmem" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.regenie_step1" }
    }

    // Step 2 tests the sub-batch that agrees on every invocation-global option, selecting its columns out
    // of the batch phenotype file the fit already read.
    //
    // `ext.prefix` is the invocation id and nothing else, because `ROUTE_REGENIE_ASSOCIATIONS` attributes
    // each native result by constructing the name `<prefix>_<analysis_id>.regenie.gz`. Changing this
    // prefix without changing that function fails the run rather than mis-attributing a result, but the
    // two must move together.
    //
    // Publication is per analysis rather than per invocation: one batched task writes one result per
    // member, and `saveAs` routes each to the published directory of the analysis that asked for it, so
    // the layout is unchanged by batching. A file that names no member is not published at all, which
    // cannot happen while attribution succeeds.
    withName: REGENIE_STEP2 {
        ext.args   = {
            [
                "--phenoColList '${meta.phenotype_columns.join(',')}'",
                meta.is_binary ? '--bt' : '',
                meta.is_binary && meta.method_options.regenie.firth ? '--firth' : '',
                meta.is_binary && meta.method_options.regenie.firth && meta.method_options.regenie.firth_approx ? '--approx' : '',
                meta.is_binary && meta.method_options.regenie.firth ? "--pThresh ${meta.method_options.regenie.firth_p_threshold}" : '',
                meta.method_options.regenie.min_mac != null ? "--minMAC ${meta.method_options.regenie.min_mac}" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/association/regenie" },
            mode: params.publish_dir_mode,
            pattern: '*.regenie.gz',
            saveAs: { filename ->
                def analysis_id = meta.phenotype_columns.find { column -> filename == "${meta.id}_${column}.regenie.gz" }
                analysis_id ? "${analysis_id}/${analysis_id}.regenie.gz" : null
            },
        ]
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    GENIE direct-genotype heritability module options
----------------------------------------------------------------------------------------
*/

// GENIE HERITABILITY

process {

    withName: 'PREPARE_GENIE_INPUTS' {
        // `meta.genie_method` is the route-local selected token, so the selector itself never spells one.
        ext.prefix = { "${meta.id}.${meta.genie_method}" }
        publishDir = [
            path: { "${params.outdir}/heritability/individual/${meta.genie_method}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.provenance.json',
        ]
    }

    withName: 'GENIE_G' {
        // The adapter resolved the effective stochastic settings against the cohort's real variant count and
        // recorded them in the sidecar; rendering them here is what makes the published command and the
        // published record the same statement. The model, projection and thread flags are the atom's own.
        ext.args   = { meta.genie_effective.native_args.join(' ') }
        ext.prefix = { "${meta.id}.${meta.genie_method}" }
        // `*.out` does not match `<id>.<method>.out.xsum` or `.out.wgxsum`, so the `GENIE_mem` binary
        // intermediates stay in the work directory.
        publishDir = [
            path: { "${params.outdir}/heritability/individual/${meta.genie_method}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{out,log}',
        ]
    }

}

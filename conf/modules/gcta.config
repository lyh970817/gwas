/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// GCTA RELATEDNESS MATRICES AND HERITABILITY

process {

    // No `ext.args` is set on either matrix-producing process, and none may be: a closure reading the meta
    // map would make the matrix depend on whatever it read, invisibly at the component interface, and
    // silently invalidate every reuse key. It could not read a trait here in any case — the meta these two
    // receive is the matrix identity, which carries no trait — but the rule is stated so a later edit does
    // not have to rediscover it.
    //
    // The merged bundle is the reusable artefact and the only one published, and then only when asked for.
    // The path is addressed by the reuse key rather than by cohort because one cohort can carry several
    // distinct matrices and a shared matrix belongs to no single analysis. The per-partition files and the
    // GCTA logs are never published: the partitions are an implementation detail of the memory control and
    // the logs record container-local paths and a timestamp.
    //
    // The selector is qualified by the calling subworkflow rather than left bare because the LD- and
    // MAF-stratified route nests a second `CUSTOM_GCTAMERGEGRMPARTS` under its own stratum builder, whose
    // per-stratum matrices are not base matrices and must not publish here.
    withName: '.*:PREPARE_RELATEDNESS_MATRICES:GCTA_PREPARE_GRM_DENSE:CUSTOM_GCTAMERGEGRMPARTS' {
        publishDir = [
            path: { "${params.outdir}/quality_control/relatedness_matrices/${meta.key}" },
            mode: params.publish_dir_mode,
            pattern: '*.grm.{bin,N.bin,id}',
            enabled: params.save_relatedness_matrices,
        ]
    }

    withName: '.*:PREPARE_RELATEDNESS_MATRICES:GCTA_MAKEBKSPARSE' {
        publishDir = [
            path: { "${params.outdir}/quality_control/relatedness_matrices/${meta.key}" },
            mode: params.publish_dir_mode,
            pattern: '*.grm.{id,sp}',
            enabled: params.save_relatedness_matrices,
        ]
    }

    withName: '.*:PREPARE_RELATEDNESS_MATRICES:GCTA_PREPARE_GRM_LDMS:CUSTOM_GCTACREATEMGRMMANIFEST' {
        publishDir = [
            path: { "${params.outdir}/quality_control/relatedness_matrices/${meta.key}" },
            mode: params.publish_dir_mode,
            pattern: '*.{mgrm,grm.bin,grm.N.bin,grm.id}',
            enabled: params.save_relatedness_matrices,
        ]
    }

    withName: '.*:GRM_HERITABILITY_GCTA:GCTA_REML' {
        // Normalisation writes the trait to a fixed third column, so the trait selector is the constant 1
        // rather than something resolved from the samplesheet's column name.
        //
        // `--prevalence` transforms the estimate from the observed scale to the liability scale and is
        // meaningful only for a binary trait; the preflight already refuses a prevalence on a quantitative
        // row, so the guard here is belt and braces and keeps the flag off the command line of a row that
        // declared none.
        ext.args   = {
            [
                '--mpheno 1',
                meta.is_binary && meta.population_prevalence != null ? "--prevalence ${meta.population_prevalence}" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.gcta_greml" }
        publishDir = [
            path: { "${params.outdir}/heritability/individual/gcta_greml/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.hsq',
        ]
    }

    withName: '.*:GRM_HERITABILITY_GCTA:GCTA_REMLLDMS' {
        ext.args   = {
            [
                '--mpheno 1',
                meta.is_binary && meta.population_prevalence != null ? "--prevalence ${meta.population_prevalence}" : '',
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.gcta_greml_ldms" }
        publishDir = [
            path: { "${params.outdir}/heritability/individual/gcta_greml_ldms/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.hsq',
        ]
    }

    // The module itself selects --fastGWA-mlm or --fastGWA-mlm-binary from the is_binary input.
    // Deliberately do not expose ext.args here: accepting arbitrary text would make the unsupported
    // plain --fastGWA-lr route reachable and would hide scientific inputs outside the reuse key.
    withName: 'GCTA_FASTGWA' {
        ext.prefix = { "${meta.id}.gcta_fastgwa" }
        publishDir = [
            path: { "${params.outdir}/association/gcta_fastgwa/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.fastGWA',
        ]
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// PLINK 2 ASSOCIATION

process {

    withName: 'PLINK2_GLM' {
        // `--1` is what makes the canonical 0/1 coding read as case/control: PLINK 2's own default is
        // 1 = control, 2 = case, under which a 0 is missing and the run would find no cases. It is
        // inert on a quantitative trait but is gated anyway so the intent is legible.
        //
        // `firth-fallback` has been PLINK 2's default for binary traits since the 30 Dec 2019 build,
        // and is stated explicitly so the behaviour is pinned to the pipeline rather than to whichever
        // build the container happens to carry.
        //
        // `cols=+a1freq` states harmonisation's allele-frequency requirement explicitly. Both A1_FREQ
        // and OBS_CT are already in the default column set, so this adds nothing at runtime — it makes
        // the requirement survive a future column-set change.
        //
        // `allow-no-covars` is required rather than optional: PLINK 2 errors out on an unadjusted
        // `--glm` without it. It is applied only when the row genuinely has no covariates, because its
        // behaviour alongside a supplied `--covar` is undocumented.
        //
        // `--covar-variance-standardize` is likewise required rather than cosmetic. A realistic
        // covariate set mixes an age in years with principal components of order 0.01, and PLINK 2
        // refuses to fit at all when the scales differ that widely — "genotype/covariate scales vary
        // too widely for numerical stability", with this flag named as the remedy. It rescales the
        // covariate block only, which is an invertible reparametrisation, so the genotype effect
        // estimate the pipeline reports is unchanged; `hide-covar` keeps the rescaled covariate rows
        // out of the output in any case.
        //
        // Order matters, and not only for readability. Everything up to the first `--` is a modifier
        // of `--glm`, which the module places last on the command line; a modifier that follows a
        // flag is silently bound to that flag instead. Putting `allow-no-covars` after `--1` makes
        // PLINK 2 read `--1 allow-no-covars`, leave `--glm` unmodified, and abort with exit status 8
        // on exactly the covariate-free row the modifier exists to serve. Keep the modifiers first.
        ext.args = { [
            'hide-covar',
            'omit-ref',
            'cols=+a1freq',
            meta.is_binary ? 'firth-fallback' : '',
            meta.has_covariates ? '' : 'allow-no-covars',
            meta.is_binary ? '--1' : '',
            meta.has_covariates ? '--covar-variance-standardize' : '',
            '--pheno-name PHENO',
        ].join(' ').trim() }
        ext.prefix = { "${meta.id}.plink2" }
        publishDir = [
            path: { "${params.outdir}/association/plink2/${meta.id}" },
            mode: params.publish_dir_mode,
            // The association result only. The PLINK 2 log records container-local paths and a
            // timestamp, so it is provenance noise rather than a result, matching the decision already
            // taken for the genotype conversion logs.
            pattern: '*.glm.*',
            // PLINK 2 always writes the phenotype name into the output filename and offers no modifier
            // that suppresses it. Normalisation fixes that name to the constant PHENO, so removing it
            // here is a deterministic rename of a known token: the file contents are untouched and the
            // published name follows the analysis-identifier-then-method grammar.
            saveAs: { filename -> filename.replace('.PHENO.glm.', '.glm.') },
        ]
    }
}

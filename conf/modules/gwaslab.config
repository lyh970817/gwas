/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// SUMMARY STATISTICS HARMONISATION

process {

    withName: 'GWASLAB_HARMONIZE' {
        // Summary statistics are organised by analysis rather than by method, so every method's
        // harmonised file for one analysis sits in one directory and a cross-method comparison is a
        // single directory listing. Collision is avoided by the prefix, which carries the method, and
        // the analysis identifier stays the directory key — which is why the method is a separate meta
        // key rather than being folded into `meta.id`.
        //
        // The `.gwaslab` tool suffix is not added here: GWASLab appends it itself when it writes
        // `<prefix>.gwaslab.tsv.gz`, so the published name is
        // `<analysis_id>.<method>.gwaslab.tsv.gz` — analysis identifier, then method, then tool.
        ext.prefix = { "${meta.id}.${meta.method}" }
        publishDir = [
            path: { "${params.outdir}/summary_statistics/${meta.id}" },
            mode: params.publish_dir_mode,
            // The harmonised table only. GWASLab's log carries the run timestamp and container-local
            // input paths, matching the decision already taken for the PLINK 2 and genotype conversion
            // logs; publishing it would also make the published tree's content hash change on every run.
            pattern: '*.gwaslab.tsv.gz',
        ]
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining LDAK module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    withName: 'LDAK_THINCOMMON' {
        ext.prefix = { "${meta.id}.ldak_kvik.step1" }
    }

    withName: 'LDAK_KVIKSTEP1' {
        // Normalisation fixes the trait as the first phenotype after FID/IID in the headerless file.
        ext.args   = '--mpheno 1'
        ext.prefix = { "${meta.id}.ldak_kvik" }
    }

    withName: 'LDAK_KVIKSTEP2' {
        ext.args   = '--mpheno 1'
        ext.prefix = { "${meta.id}.ldak_kvik" }
        publishDir = [
            path: { "${params.outdir}/association/ldak_kvik/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.step2*.assoc',
        ]
    }
}

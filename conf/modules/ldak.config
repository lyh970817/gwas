/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// LDAK ASSOCIATION, RELATEDNESS MATRICES AND HERITABILITY

process {

    withName: 'LDAK_THINCOMMON' {
        ext.prefix = { "${meta.id}.ldak_kvik.step1" }
    }

    withName: 'LDAK_KVIKSTEP1' {
        // Normalisation fixes the trait as the first phenotype after FID/IID in the headerless file.
        ext.args   = '--mpheno 1'
        ext.prefix = { "${meta.id}.ldak_kvik" }
    }

    withName: 'LDAK_KVIKSTEP2' {
        ext.args   = '--mpheno 1'
        ext.prefix = { "${meta.id}.ldak_kvik" }
        publishDir = [
            path: { "${params.outdir}/association/ldak_kvik/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.step2*.assoc',
        ]
    }

    // The matrix process receives matrix identity only, never focal analysis metadata. Its scientific inputs
    // are explicit tuple members (power and, later, an optional weights file), so no `ext.args` closure may
    // read per-analysis state and silently invalidate the reuse key.
    withName: '.*:PREPARE_RELATEDNESS_MATRICES:PLINK_PREPARE_GRM_LDAK:LDAK_CALCKINS' {
        publishDir = [
            path: { "${params.outdir}/quality_control/relatedness_matrices/${meta.key}" },
            mode: params.publish_dir_mode,
            pattern: '*.grm.{bin,id,details,adjust}',
            enabled: params.save_relatedness_matrices,
        ]
    }

    withName: '.*:GRM_HERITABILITY_LDAK:LDAK_REML' {
        // Normalisation fixes the trait at the third column, which is LDAK phenotype number one.
        ext.args   = '--mpheno 1'
        ext.prefix = { "${meta.id}.ldak_reml" }
        publishDir = [
            path: { "${params.outdir}/heritability/individual/ldak_reml/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.reml*',
        ]
    }
}

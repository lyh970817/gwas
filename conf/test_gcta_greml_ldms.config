/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    GCTA GREML-LDMS heritability route test options
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [cpus: 4, memory: '8.GB', time: '1.h']
}

// AGENTS.md keeps the machine-local fixture checkout out of tracked files. The committed sheet is
// therefore the upstream fallback; local development may resolve the same canonical URLs through
// GWAS_TEST_FIXTURES until the fixture bundle is available on the upstream gwas branch.
def gcta_greml_ldms_input = new File(projectDir.toString(), 'assets/samplesheet_gcta_greml_ldms.csv')
def gcta_greml_ldms_fixture_root = System.getenv('GWAS_TEST_FIXTURES')
if (gcta_greml_ldms_fixture_root) {
    def fixture_root = new File(gcta_greml_ldms_fixture_root).absoluteFile
    def fixture_marker = new File(fixture_root, 'results/fixtures/genotypes/example_all.pgen')
    if (!fixture_marker.exists()) {
        throw new IllegalStateException(
            "[nf-core/gwas] ERROR: GWAS_TEST_FIXTURES is set to '${gcta_greml_ldms_fixture_root}' but ${fixture_marker} does not exist"
        )
    }

    def resolved_directory = new File(projectDir.toString(), '.nf-test-gcta-profiles')
    resolved_directory.mkdirs()
    def resolved_input = new File(resolved_directory, 'samplesheet_gcta_greml_ldms.csv')
    def upstream_prefix = 'https://raw.githubusercontent.com/nf-core/test-datasets/gwas/'
    resolved_input.text = gcta_greml_ldms_input.text.replace(upstream_prefix, fixture_root.toString() + '/')
    gcta_greml_ldms_input = resolved_input
}

params {
    // Config options
    config_profile_name        = 'GCTA GREML-LDMS test profile'
    config_profile_description = 'GCTA GREML-LDMS matrix reuse and stratification-identity scenarios'

    // Input options
    input = gcta_greml_ldms_input.toString()
}

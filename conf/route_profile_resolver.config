/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Portable route-profile input resolver
------------------------------------------------------------------------------------------
*/

// Route profiles commit their complete 35-column samplesheets. Local development may replace only
// the canonical upstream fixture prefix by setting GWAS_TEST_FIXTURES; CI retains the portable URL.
// Content-addressed paths under the worker-specific NFT_WORKDIR make parallel config evaluation safe.

// Input options
params {
    input = {
        def template_by_profile_name = [
            'REGENIE standard Step 1 test profile'          : 'samplesheet_regenie_standard.csv',
            'REGENIE chunked Step 1 test profile'           : 'samplesheet_regenie_chunked.csv',
            'REGENIE binary-trait test profile'             : 'samplesheet_regenie_binary.csv',
            'LDAK-KVIK all-predictors test profile'         : 'samplesheet_ldak_kvik_all.csv',
            'LDAK-KVIK thin-common test profile'            : 'samplesheet_ldak_kvik_thin_common.csv',
            'LDAK-KVIK provided-predictors test profile'    : 'samplesheet_ldak_kvik_provided.csv',
            'LDAK-KVIK binary-trait test profile'           : 'samplesheet_ldak_kvik_binary.csv',
            'LDAK REML heritability test profile'           : 'samplesheet_ldak_reml.csv',
            'LDAK shared relatedness matrix test profile'   : 'samplesheet_ldak_relatedness_shared.csv',
            'LDAK distinct relatedness matrix test profile' : 'samplesheet_ldak_relatedness_distinct.csv',
            'LDAK same-weight-content test profile'         : 'samplesheet_ldak_relatedness_same_weights.csv',
            'LDAK different-weight-content test profile'    : 'samplesheet_ldak_relatedness_different_weights.csv',
        ]
        def template_name = template_by_profile_name[params.config_profile_name]
        def canonical_prefix = 'https://raw.githubusercontent.com/nf-core/test-datasets/gwas/'
        def fixture_base = canonical_prefix
        def fixture_override_valid = true
        def declared_fixture_root = System.getenv('GWAS_TEST_FIXTURES')
        if (declared_fixture_root) {
            def fixture_root = new File(declared_fixture_root).absoluteFile
            def fixture_marker = new File(fixture_root, 'results/fixtures/genotypes/example_all.pgen')
            fixture_override_valid = fixture_marker.exists()
            if (fixture_override_valid) {
                fixture_base = fixture_root.toString() + '/'
            }
        }

        def template = new File(projectDir.toString(), "assets/test_profiles/${template_name}")
        def template_text = template.text
        def support_payloads = [:]
        if (fixture_override_valid && template_text.contains('__KVIK_PROVIDED__')) {
            def bim_source = "${fixture_base}results/fixtures/genotypes/example_all.bim"
            def bim_text = bim_source.startsWith('http') ? new URL(bim_source).text : new File(bim_source).text
            support_payloads['support/kvik/provided.in'] = bim_text
                .readLines()
                .findAll { line -> line }
                .collect { line -> line.split(/\s+/)[1] }
                .join('\n') + '\n'
        }
        if (fixture_override_valid && template_text.contains('__LDAK_WEIGHT_')) {
            def pvar_source = "${fixture_base}results/fixtures/genotypes/example_all.pvar"
            def pvar_text = pvar_source.startsWith('http') ? new URL(pvar_source).text : new File(pvar_source).text
            def predictors = pvar_text
                .readLines()
                .findAll { line -> line && !line.startsWith('#') }
                .collect { line -> line.tokenize()[2] }
            def weight_one = predictors.collect { predictor -> "${predictor} 1" }.join('\n') + '\n'
            def weight_two = predictors.collect { predictor -> "${predictor} 2" }.join('\n') + '\n'
            support_payloads['support/weights/one-a/example_all.pvar'] = weight_one
            support_payloads['support/weights/one-b/example_all.pvar'] = weight_one
            support_payloads['support/weights/two/example_all.pvar'] = weight_two
        }

        def digest_material = ([template_text, fixture_base] + support_payloads
            .keySet()
            .sort()
            .collect { relative_path -> "${relative_path}\n${support_payloads[relative_path]}" })
            .join('\n-- route-profile boundary --\n')
        def digest_bytes = java.security.MessageDigest.getInstance('SHA-256').digest(digest_material.getBytes('UTF-8'))
        def digest = digest_bytes.collect { byte_value -> String.format('%02x', byte_value & 0xff) }.join()
        def worker_root = new File(System.getenv('NFT_WORKDIR') ?: new File(projectDir.toString(), '.nf-test').toString())
        def resolved_root = new File(worker_root, "route-profile-inputs/${digest}")

        def resolved_support_paths = support_payloads.entrySet().collectEntries { entry ->
            def relative_path = entry.key
            def content = entry.value
            def target = new File(resolved_root, relative_path)
            if (!target.exists() || target.text != content) {
                target.parentFile.mkdirs()
                def temporary = File.createTempFile("${target.name}.", '.tmp', target.parentFile)
                temporary.setText(content, 'UTF-8')
                try {
                    java.nio.file.Files.move(
                        temporary.toPath(),
                        target.toPath(),
                        java.nio.file.StandardCopyOption.ATOMIC_MOVE,
                        java.nio.file.StandardCopyOption.REPLACE_EXISTING,
                    )
                } catch (java.nio.file.AtomicMoveNotSupportedException _error) {
                    java.nio.file.Files.move(
                        temporary.toPath(),
                        target.toPath(),
                        java.nio.file.StandardCopyOption.REPLACE_EXISTING,
                    )
                }
            }
            [(relative_path): target.absolutePath]
        }

        def resolved_text = template_text.replace(canonical_prefix, fixture_base)
        resolved_text = resolved_text
            .replace('__KVIK_PROVIDED__', resolved_support_paths['support/kvik/provided.in'] ?: '')
            .replace('__LDAK_WEIGHT_ONE_A__', resolved_support_paths['support/weights/one-a/example_all.pvar'] ?: '')
            .replace('__LDAK_WEIGHT_ONE_B__', resolved_support_paths['support/weights/one-b/example_all.pvar'] ?: '')
            .replace('__LDAK_WEIGHT_TWO__', resolved_support_paths['support/weights/two/example_all.pvar'] ?: '')

        def resolved_input = new File(resolved_root, "inputs/${template.name}")
        if (!resolved_input.exists() || resolved_input.text != resolved_text) {
            resolved_input.parentFile.mkdirs()
            def temporary = File.createTempFile("${resolved_input.name}.", '.tmp', resolved_input.parentFile)
            temporary.setText(resolved_text, 'UTF-8')
            try {
                java.nio.file.Files.move(
                    temporary.toPath(),
                    resolved_input.toPath(),
                    java.nio.file.StandardCopyOption.ATOMIC_MOVE,
                    java.nio.file.StandardCopyOption.REPLACE_EXISTING,
                )
            } catch (java.nio.file.AtomicMoveNotSupportedException _error) {
                java.nio.file.Files.move(
                    temporary.toPath(),
                    resolved_input.toPath(),
                    java.nio.file.StandardCopyOption.REPLACE_EXISTING,
                )
            }
        }
        return resolved_input.absolutePath
    }.call()
}

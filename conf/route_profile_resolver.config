/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Portable route-profile input resolver
----------------------------------------------------------------------------------------
*/

// Route profiles materialise linked manifests from one relational definition portfolio. Local development
// may replace only the canonical upstream fixture prefix through GWAS_TEST_FIXTURES; CI retains the URL.
// Content-addressed paths under the worker-specific NFT_WORKDIR make parallel config evaluation safe.

def profile_key_by_name = [
    'Fast routine test profile'                     : 'default',
    'Full-scale test profile'                       : 'full_scale',
    'REGENIE standard Step 1 test profile'          : 'regenie_standard',
    'REGENIE chunked Step 1 test profile'           : 'regenie_chunked',
    'REGENIE binary-trait test profile'             : 'regenie_binary',
    'LDAK-KVIK all-predictors test profile'         : 'ldak_kvik_all',
    'LDAK-KVIK thin-common test profile'            : 'ldak_kvik_thin_common',
    'LDAK-KVIK provided-predictors test profile'    : 'ldak_kvik_provided',
    'LDAK-KVIK binary-trait test profile'           : 'ldak_kvik_binary',
    'LDAK REML heritability test profile'           : 'ldak_reml',
    'LDAK HE and PCGC heritability test profile'    : 'ldak_estimators',
    'LDAK shared relatedness matrix test profile'   : 'ldak_relatedness_shared',
    'LDAK distinct relatedness matrix test profile' : 'ldak_relatedness_distinct',
    'LDAK same-weight-content test profile'         : 'ldak_relatedness_same_weights',
    'LDAK different-weight-content test profile'    : 'ldak_relatedness_different_weights',
    'GCTA GREML-LDMS test profile'                  : 'gcta_greml_ldms',
    'GCTA fastGWA-MLM test profile'                  : 'gcta_fastgwa',
]
def profile_key = profile_key_by_name[params.config_profile_name]
def definitions_file = new File(projectDir.toString(), 'assets/test_profiles/relational_profiles.json')
def definition = new groovy.json.JsonSlurper().parseText(definitions_file.text)[profile_key]

def canonical_prefix = 'https://raw.githubusercontent.com/nf-core/test-datasets/gwas/'
def fixture_base = canonical_prefix
def fixture_override_valid = true
def declared_fixture_root = System.getenv('GWAS_TEST_FIXTURES')
if (declared_fixture_root) {
    def fixture_root = new File(declared_fixture_root).absoluteFile
    fixture_override_valid = new File(fixture_root, 'results/fixtures/genotypes/example_all.pgen').exists()
    if (fixture_override_valid) {
        fixture_base = fixture_root.toString() + '/'
    }
}

def definition_text = groovy.json.JsonOutput.toJson(definition)
def support_payloads = [:]
if (fixture_override_valid && definition_text.contains('__KVIK_PROVIDED__')) {
    def bim_source = "${fixture_base}results/fixtures/genotypes/example_all.bim"
    def bim_text = bim_source.startsWith('http') ? new URL(bim_source).text : new File(bim_source).text
    support_payloads['support/kvik/provided.in'] = bim_text.readLines().findAll { line -> line }.collect { line -> line.split(/\s+/)[1] }.join('\n') + '\n'
}
if (fixture_override_valid && definition_text.contains('__LDAK_WEIGHT_')) {
    def pvar_source = "${fixture_base}results/fixtures/genotypes/example_all.pvar"
    def pvar_text = pvar_source.startsWith('http') ? new URL(pvar_source).text : new File(pvar_source).text
    def predictors = pvar_text.readLines().findAll { line -> line && !line.startsWith('#') }.collect { line -> line.tokenize()[2] }
    def weight_one = predictors.collect { predictor -> "${predictor} 1" }.join('\n') + '\n'
    support_payloads['support/weights/one-a/example_all.pvar'] = weight_one
    support_payloads['support/weights/one-b/example_all.pvar'] = weight_one
    support_payloads['support/weights/two/example_all.pvar'] = predictors.collect { predictor -> "${predictor} 2" }.join('\n') + '\n'
}

def digest_material = ([definition_text, fixture_base] + support_payloads.keySet().sort().collect { path -> "${path}\n${support_payloads[path]}" }).join('\n-- route-profile boundary --\n')
def digest_bytes = java.security.MessageDigest.getInstance('SHA-256').digest(digest_material.getBytes('UTF-8'))
def digest = digest_bytes.collect { byte_value -> String.format('%02x', byte_value & 0xff) }.join()
def worker_root = new File(System.getenv('NFT_WORKDIR') ?: new File(projectDir.toString(), '.nf-test').toString())
def resolved_root = new File(worker_root, "route-profile-inputs/${digest}")

def write_atomic = { File target, String content ->
    if (!target.exists() || target.text != content) {
        target.parentFile.mkdirs()
        def temporary = File.createTempFile("${target.name}.", '.tmp', target.parentFile)
        temporary.setText(content, 'UTF-8')
        try {
            java.nio.file.Files.move(temporary.toPath(), target.toPath(), java.nio.file.StandardCopyOption.ATOMIC_MOVE, java.nio.file.StandardCopyOption.REPLACE_EXISTING)
        } catch (java.nio.file.AtomicMoveNotSupportedException _error) {
            java.nio.file.Files.move(temporary.toPath(), target.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING)
        }
    }
}

def resolved_support_paths = support_payloads.collectEntries { path, content ->
    def target = new File(resolved_root, path)
    write_atomic(target, content)
    [(path): target.absolutePath]
}
def resolve_text = { value ->
    value.toString()
        .replace(canonical_prefix, fixture_base)
        .replace('__KVIK_PROVIDED__', resolved_support_paths['support/kvik/provided.in'] ?: '')
        .replace('__LDAK_WEIGHT_ONE_A__', resolved_support_paths['support/weights/one-a/example_all.pvar'] ?: '')
        .replace('__LDAK_WEIGHT_ONE_B__', resolved_support_paths['support/weights/one-b/example_all.pvar'] ?: '')
        .replace('__LDAK_WEIGHT_TWO__', resolved_support_paths['support/weights/two/example_all.pvar'] ?: '')
}
def quote_csv = { value ->
    def text = resolve_text(value ?: '')
    return text.contains(',') || text.contains('"') ? '"' + text.replace('"', '""') + '"' : text
}
def manifest_text = { rows ->
    def header = rows.first().keySet().toList()
    return ([header.join(',')] + rows.collect { row -> header.collect { field -> quote_csv(row[field]) }.join(',') }).join('\n') + '\n'
}

def cohort_manifest_file = new File(resolved_root, 'inputs/cohort_manifest.csv')
def analysis_manifest_file = new File(resolved_root, 'inputs/analysis_manifest.csv')
def method_options_file = new File(resolved_root, 'inputs/method_options.json')
write_atomic(cohort_manifest_file, manifest_text(definition.cohorts))
write_atomic(analysis_manifest_file, manifest_text(definition.analyses))
def resolved_options_text = resolve_text(groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(definition.method_options))) + '\n'
write_atomic(method_options_file, resolved_options_text)

// Input options
params {
    cohort_manifest   = cohort_manifest_file.absolutePath
    analysis_manifest = analysis_manifest_file.absolutePath
    method_options    = definition.method_options ? method_options_file.absolutePath : null
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    LDAK-KVIK thin-common route test options
------------------------------------------------------------------------------------------
*/

route_profile_template = 'samplesheet_ldak_kvik_thin_common.csv'
includeConfig 'test_route_profile_resolver.config'

process {
    resourceLimits = [cpus: 4, memory: '8.GB', time: '1.h']

    // LDAK-KVIK estimates stochastic model components. Pin its documented seed for snapshots.
    withName: 'LDAK_KVIKSTEP1|LDAK_KVIKSTEP2' {
        ext.args = [
            '--mpheno 1',
            '--random-seed 7',
        ].join(' ').trim()
    }
}

params {
    // Config options
    config_profile_name        = 'LDAK-KVIK thin-common test profile'
    config_profile_description = 'Quantitative LDAK-KVIK route using generated common predictors'

}

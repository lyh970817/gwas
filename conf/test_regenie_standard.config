/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/gwas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REGENIE standard Step 1 route test options
------------------------------------------------------------------------------------------
*/

route_profile_template = 'samplesheet_regenie_standard.csv'
includeConfig 'test_route_profile_resolver.config'

process {
    resourceLimits = [cpus: 4, memory: '8.GB', time: '1.h']
}

params {
    // Config options
    config_profile_name = 'REGENIE standard Step 1 test profile'
    config_profile_description = 'Quantitative REGENIE route with standard Step 1'
}

nextflow_pipeline {

    name "Test GENIE additive direct-genotype heritability route"
    script "../main.nf"
    tag "pipeline"
    tag "heritability"
    tag "genie"

    def executionModes = [
        [suffix: '', stub: false],
        [suffix: ' - stub', stub: true],
    ]

    // Whether every recorded token appears in the emitted command in the recorded order, not necessarily
    // contiguously. Equality is impossible: the command additionally carries the file and runtime bindings.
    def isSubsequence = { recorded, emitted ->
        def cursor = 0
        for (token in recorded) {
            cursor = emitted.findIndexOf(cursor) { candidate -> candidate == token }
            if (cursor < 0) {
                return false
            }
            cursor += 1
        }
        return true
    }

    def commands = { outputDir ->
        def scripts = []
        new File(new File(outputDir.toString()).parentFile, 'work').eachFileRecurse { entry ->
            if (entry.isFile() && entry.name == '.command.sh') {
                scripts << entry.text.replaceAll(/\\\s+/, ' ').replaceAll(/\s+/, ' ')
            }
        }
        return scripts
    }

    executionModes.each { mode ->
        test("genie rows estimate from raw genotypes and build no relatedness matrix at all${mode.suffix}") {

            tag "genie_direct"
            if (mode.stub) {
                options "-stub"
            }

            when {
                params {
                    outdir = "$outputDir"
                    cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'genie_direct')
                    analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'genie_direct', { rows ->
                        rows[0].analysis_id = 'genie_plain'
                        rows[0].association_methods = ''
                        rows[0].heritability_methods = 'genie_g'
                        rows[0].quant_covariates = ''
                        rows[0].cat_covariates = ''

                        def covariates = RELATIONAL.analysis(projectDir, 'example_pgen_qt')
                        covariates.analysis_id = 'genie_covariates'
                        covariates.association_methods = ''
                        covariates.heritability_methods = 'genie_g'
                        rows << covariates

                        def mixed = RELATIONAL.analysis(projectDir, 'example_pgen_qt')
                        mixed.analysis_id = 'genie_with_ldak'
                        mixed.association_methods = ''
                        mixed.heritability_methods = 'ldak_he,genie_g'
                        rows << mixed
                    })
                    method_options = RELATIONAL.methodOptions(outputDir, 'genie_direct', [analyses: [
                        genie_plain: [genie: [seed: 7, random_vectors: 20]],
                        genie_covariates: [genie: [seed: 7, random_vectors: 20, jackknife_blocks: 100]],
                        genie_with_ldak: [
                            genie: [seed: 7, random_vectors: 20, memory_efficient: true],
                            ldak: [model: 'human_default', power: -0.25, weights_policy: 'equal'],
                        ],
                    ]])
                }
            }

            then {
                def individual = new File("${params.outdir}/heritability/individual")
                def genie = new File(individual, 'genie_g')
                def versions = new File("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")
                assertAll(
                    { assert workflow.success },
                    // The cohort is converted to PLINK 1 once, and only the co-selected row builds a kinship.
                    // This is the claim the whole route exists to make.
                    { assert TRACE.count(workflow, 'PLINK2_MAKEBED') == 1 },
                    { assert TRACE.count(workflow, 'PREPARE_GENIE_INPUTS') == 3 },
                    { assert TRACE.count(workflow, 'GENIE_G') == 3 },
                    { assert TRACE.tags(workflow, 'GENIE_G') == ['genie_covariates', 'genie_plain', 'genie_with_ldak'] },
                    { assert TRACE.count(workflow, 'LDAK_CALCKINS') == 1 },
                    { assert TRACE.count(workflow, 'LDAK_HE') == 1 },
                    { assert TRACE.count(workflow, 'LDAK_FASTHE') == 0 },
                    { assert TRACE.count(workflow, 'LDAK_FILTER') == 0 },
                    { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') == 0 },
                    { assert individual.list().toList().sort() == ['genie_g', 'ldak_he'] },
                    // Exactly the native result, its log and the invocation record. The prepared inputs, the
                    // count contract, the effective settings and the memory-efficient binary intermediates
                    // stay in the work directory.
                    { assert genie.list().toList().sort() == ['genie_covariates', 'genie_plain', 'genie_with_ldak'] },
                    { assert new File(genie, 'genie_plain').list().toList().sort() == [
                        'genie_plain.genie_g.log',
                        'genie_plain.genie_g.out',
                        'genie_plain.genie_g.provenance.json',
                    ] },
                    { assert new File(genie, 'genie_with_ldak').list().toList().sort() == [
                        'genie_with_ldak.genie_g.log',
                        'genie_with_ldak.genie_g.out',
                        'genie_with_ldak.genie_g.provenance.json',
                    ] },
                    // A row selecting both families gets two estimates in two directories under two prefixes,
                    // so neither can overwrite the other.
                    { assert new File(individual, 'ldak_he/genie_with_ldak/genie_with_ldak.ldak_he.he').isFile() },
                )
                if (!mode.stub) {
                    def runCommands = commands(params.outdir)
                    def genieCommands = runCommands.findAll { command -> command.contains('-m G -np 0 -i 1') }
                    def plain = new File(genie, 'genie_plain/genie_plain.genie_g.out')
                    def slurper = new groovy.json.JsonSlurper()
                    def provenance = { analysis_id -> slurper.parseText(new File(genie, "${analysis_id}/${analysis_id}.genie_g.provenance.json").text) }
                    assertAll(
                        { assert genieCommands.size() == 3 },
                        // The model, projection and intercept flags are the atom's literals; the four flags
                        // that would change the estimand are unreachable because the pipeline exposes no
                        // native-argument surface for GENIE.
                        { assert genieCommands.every { command -> command.contains('-s 7') && command.contains('-k 20') } },
                        // `-js` and its long form `--jack-scheme` are undocumented, absent from the usage
                        // text, and silently overwrite the jackknife count -- they win over `-jn` whichever
                        // order the two appear in. Either one reaching the command line would bypass the
                        // adapter's guard against a count the streaming executable cannot survive, so both
                        // spellings are pinned absent alongside the deferred surfaces.
                        { assert genieCommands.every { command -> !command.contains('-eXannot') && !command.contains('-js') && !command.contains('--jack-scheme') && !command.contains('-tr ') } },
                        // `-np` is honoured only when it appears after `-m`, and GENIE echoes no projection
                        // line either way, so a reordering would silently drop the setting with nothing in
                        // any output to show it. The order is asserted, not just the presence.
                        { assert genieCommands.every { command -> command.indexOf('-m G') >= 0 && command.indexOf('-m G') < command.indexOf('-np 0') } },
                        // The jackknife count each row actually ran: the clamped native default where it was
                        // left unset, the curated value where it was set, and a reduced default for the
                        // streaming row, whose executable reads past its own buffer when the trailing block
                        // outgrows the nominal one. 733 is the largest count below 1000 that 2200 variants
                        // survive there, and it was measured to run.
                        { assert genieCommands.findAll { command -> command.contains('-jn 1000') }.size() == 1 },
                        { assert genieCommands.findAll { command -> command.contains('-jn 100 ') }.size() == 1 },
                        { assert genieCommands.findAll { command -> command.contains('-jn 733') }.size() == 1 },
                        { assert genieCommands.any { command -> command.contains('GENIE_mem') } },
                        { assert genieCommands.findAll { command -> command.contains('-c "') }.size() == 2 },
                        { assert plain.text.contains('Number of individuals after filtering: 200') },
                        { assert plain.text.contains('Total h2') },
                        { assert !plain.text.contains('nan') },
                        { assert provenance('genie_plain').native_arguments == ['-m', 'G', '-np', '0', '-i', '1', '-jn', '1000', '-k', '20', '-s', '7'] },
                        // Every argument the sidecar records appears in the command it describes, in order.
                        // Equality is impossible: the command additionally carries the file and runtime
                        // bindings, which are not settings, so this is a subsequence relation and is checked
                        // as one. Without it the sidecar could drift from the invocation it claims to record.
                        { assert ['genie_plain', 'genie_covariates', 'genie_with_ldak'].every { analysis_id ->
                            def emitted = genieCommands.find { command -> command.contains("-o \"${analysis_id}.genie_g.out\"") }.tokenize(' ')
                            isSubsequence(provenance(analysis_id).native_arguments, emitted)
                        } },
                        // The check has to be able to fail: a token the command never carries must break it.
                        { assert !isSubsequence(['-m', 'G', '-eXannot'], ['-m', 'G', '-np', '0']) },
                        { assert !isSubsequence(['-s', '-m'], ['-m', 'G', '-s', '7']) },
                        { assert provenance('genie_covariates').stochastic_settings.family_options.jackknife_blocks == 100 },
                        { assert provenance('genie_covariates').stochastic_settings.family_options.jackknife_blocks_source == 'requested' },
                        { assert provenance('genie_plain').stochastic_settings.family_options.jackknife_blocks_source == 'clamped_native_default' },
                        { assert provenance('genie_with_ldak').stochastic_settings.family_options.jackknife_blocks == 733 },
                        { assert provenance('genie_with_ldak').stochastic_settings.family_options.jackknife_blocks_source == 'memory_efficient_safe_default' },
                        { assert provenance('genie_with_ldak').warnings.contains('jackknife_blocks_memory_efficient_default') },
                        { assert provenance('genie_plain').inputs.samples.retained == 200 },
                        { assert provenance('genie_plain').inputs.variants.retained == 2200 },
                        { assert provenance('genie_plain').inputs.covariates.columns == 0 },
                        { assert provenance('genie_covariates').inputs.covariates.columns == 5 },
                        { assert provenance('genie_with_ldak').software.executable == 'GENIE_mem' },
                        { assert provenance('genie_plain').software.executable == 'GENIE' },
                        { assert provenance('genie_plain').result.method == 'genie_g' },
                        { assert provenance('genie_plain').classification == null },
                        { assert provenance('genie_plain').native_checks.enforced.contains('no_nan_or_inf') },
                        { assert snapshot(removeNextflowVersion(versions.toString())).match('versions') },
                        { assert snapshot(
                            getAllFilesFromDir(genie.toString(), relative: true, includeDir: true, ignoreFile: 'tests/.nftignore'),
                        ).match('layout') },
                        // The in-memory executable's log is byte-stable at a fixed seed: its parameter block
                        // is tab-separated, and it carries no timestamp, no absolute path and no thread count,
                        // so it is content-snapshotted rather than ignored.
                        { assert snapshot(
                            getAllFilesFromDir(new File(genie, 'genie_plain').toString(), ignoreFile: 'tests/.nftignore'),
                            getAllFilesFromDir(new File(genie, 'genie_covariates').toString(), ignoreFile: 'tests/.nftignore'),
                        ).match('heritability') },
                        // The streaming executable's log is not: it ends with `GENIE ran successfully. Time
                        // elapsed = <wall clock> seconds`, which the in-memory one never prints. Its result
                        // and its invocation record are content-snapshotted; the log is asserted by shape.
                        { assert snapshot(
                            new File(genie, 'genie_with_ldak/genie_with_ldak.genie_g.out'),
                            new File(genie, 'genie_with_ldak/genie_with_ldak.genie_g.provenance.json'),
                        ).match('streamed') },
                        { assert new File(genie, 'genie_with_ldak/genie_with_ldak.genie_g.log').text.contains('#seed\t7') },
                        { assert new File(genie, 'genie_with_ldak/genie_with_ldak.genie_g.log').text.contains('Time elapsed') },
                        { assert !new File(genie, 'genie_plain/genie_plain.genie_g.log').text.contains('Time elapsed') },
                    )
                }
            }
        }
    }

    test("the memory-efficient executable reproduces the in-memory estimate at the same seed") {

        tag "genie_memory"

        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'genie_memory')
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'genie_memory', { rows ->
                    rows[0].analysis_id = 'genie_in_memory'
                    rows[0].association_methods = ''
                    rows[0].heritability_methods = 'genie_g'

                    def streamed = RELATIONAL.analysis(projectDir, 'example_pgen_qt')
                    streamed.analysis_id = 'genie_streamed'
                    streamed.association_methods = ''
                    streamed.heritability_methods = 'genie_g'
                    rows << streamed
                })
                method_options = RELATIONAL.methodOptions(outputDir, 'genie_memory', [analyses: [
                    genie_in_memory: [genie: [seed: 7, random_vectors: 20, jackknife_blocks: 50]],
                    genie_streamed: [genie: [seed: 7, random_vectors: 20, jackknife_blocks: 50, memory_efficient: true]],
                ]])
            }
        }

        then {
            // Two rows with identical inputs, identical seed and identical random-vector count, differing only
            // in which executable ran. The tolerance is valid only under exactly those conditions: across
            // seeds at GENIE's native ten vectors the same estimate moves by about a third of its own size.
            def genie = new File("${params.outdir}/heritability/individual/genie_g")
            def heritability = { analysis_id ->
                new File(genie, "${analysis_id}/${analysis_id}.genie_g.out").readLines()
                    .find { line -> line.startsWith('h2_g[0]') }
                    .split(':')[1]
                    .trim()
                    .split(/\s+/)[0] as Double
            }
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'GENIE_G') == 2 },
                { assert Math.abs(heritability('genie_in_memory') - heritability('genie_streamed')) < 1e-5 },
                // The two executables write the same numbers in two header dialects, and the count assertion
                // in the estimator tolerates both. Nothing else in the pipeline reads either line.
                { assert new File(genie, 'genie_in_memory/genie_in_memory.genie_g.out').text.contains('Number of individuals after filtering: 200') },
                { assert new File(genie, 'genie_streamed/genie_streamed.genie_g.out').text.contains('Number of individuals after filtering = 200') },
                // The streaming binary's two intermediates are never published.
                { assert new File(genie, 'genie_streamed').list().toList().sort() == [
                    'genie_streamed.genie_g.log',
                    'genie_streamed.genie_g.out',
                    'genie_streamed.genie_g.provenance.json',
                ] },
            )
        }
    }

    test("a caller annotation partitions the cohort into two components") {

        tag "genie_annotation"

        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'genie_annotation')
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'genie_annotation', { rows ->
                    rows[0].analysis_id = 'genie_partitioned'
                    rows[0].association_methods = ''
                    rows[0].heritability_methods = 'genie_g'
                })
                method_options = RELATIONAL.methodOptions(outputDir, 'genie_annotation', [analyses: [
                    genie_partitioned: [genie: [
                        seed: 7,
                        random_vectors: 20,
                        jackknife_blocks: 50,
                        annotation: RELATIONAL.resource(
                            outputDir,
                            'genie/partition.annot',
                            (0..<2200).collect { index -> index % 2 == 0 ? '1 0' : '0 1' }.join('\n') + '\n',
                        ),
                    ]],
                ]])
            }
        }

        then {
            // A disjoint partition is what makes GENIE's two heritability blocks agree: with overlapping
            // columns the same `h2_g[k]` label carries two different numbers in one published file.
            def results = new File("${params.outdir}/heritability/individual/genie_g/genie_partitioned/genie_partitioned.genie_g.out")
            def provenance = new groovy.json.JsonSlurper().parseText(
                new File("${params.outdir}/heritability/individual/genie_g/genie_partitioned/genie_partitioned.genie_g.provenance.json").text
            )
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'GENIE_G') == 1 },
                { assert results.text.contains('Number of features in bin 0 : 1100') },
                { assert results.text.contains('Number of features in bin 1 : 1100') },
                { assert results.text.contains('Sigma^2_g[1]') },
                { assert results.text.contains('Total h2') },
                { assert !results.text.contains('nan') },
                // The registry still declares `component_model: 'single'`, which names the model the pipeline
                // plans; the components the fit actually carried are recorded here instead.
                { assert provenance.inputs.variants.annotation_source == 'caller' },
                { assert provenance.inputs.variants.annotation_column_sums == [1100, 1100] },
                { assert provenance.component_plan.components.size() == 2 },
                { assert provenance.estimator.component_model == 'single' },
            )
        }
    }

    test("a genie row without a seed or a random-vector count runs and says what that costs") {

        tag "genie_warnings"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'genie_warnings')
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'genie_warnings', { rows ->
                    rows[0].analysis_id = 'unseeded_genie'
                    rows[0].association_methods = ''
                    rows[0].heritability_methods = 'genie_g'
                })
            }
        }

        then {
            // Neither is an error: an unset option stays native. Both are said out loud, because GENIE echoes
            // no seed line at all for an unseeded run and because at its native ten random vectors the point
            // estimate moves by about 35% of its own size across seeds while the reported jackknife standard
            // error contains none of that.
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'GENIE_G') == 1 },
                { assert report.contains("analysis 'unseeded_genie' selects stochastic method(s) genie_g without 'genie.seed'") },
                { assert report.contains("analysis 'unseeded_genie' runs genie_g with GENIE's native default of 10 random vectors") },
                { assert report.contains("should set 'genie.random_vectors' explicitly") },
            )
        }
    }

    def invalidRows = [
        [
            name: 'a binary row selecting the quantitative-only estimator',
            source: 'example_pgen_bt',
            methods: 'genie_g',
            expected: ["field 'heritability_methods'", 'support quantitative traits only', "trait_type 'binary'"],
        ],
        [
            name: 'a negative seed',
            source: 'example_pgen_qt',
            methods: 'genie_g',
            options: [genie: [seed: -1]],
            expected: ["option 'genie.seed'", 'expected a non-negative integer or null'],
        ],
        [
            name: 'a single jackknife block',
            source: 'example_pgen_qt',
            methods: 'genie_g',
            options: [genie: [jackknife_blocks: 1]],
            expected: ["option 'genie.jackknife_blocks'", 'zero jackknife standard error'],
        ],
        [
            name: 'a zero random-vector count',
            source: 'example_pgen_qt',
            methods: 'genie_g',
            options: [genie: [random_vectors: 0]],
            expected: ["option 'genie.random_vectors'", 'expected a positive integer or null'],
        ],
        [
            name: 'the deferred trace-export surface',
            source: 'example_pgen_qt',
            methods: 'genie_g',
            options: [genie: [trace: 'x']],
            expected: ["option 'genie.trace'", 'unknown option; accepted GENIE options are'],
        ],
        [
            name: 'a genie option on a row that selects no GENIE method',
            source: 'example_pgen_qt',
            methods: 'ldak_he',
            options: [genie: [seed: 7]],
            expected: ["option 'genie.seed'", 'analysis does not select a GENIE method'],
        ],
        [
            name: 'an annotation resource that does not exist',
            source: 'example_pgen_qt',
            methods: 'genie_g',
            options: [genie: [annotation: '/definitely/missing/annotation.txt']],
            expected: ["option 'genie.annotation'", 'does not exist'],
        ],
    ]

    invalidRows.each { scenario ->
        test("linked manifests reject ${scenario.name} before any GENIE task") {

            tag "genie_validation"

            when {
                params {
                    def fixture = "genie_invalid_${scenario.name.replaceAll(/\s+/, '_')}"
                    outdir = "$outputDir"
                    cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, fixture)
                    analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, fixture, { rows ->
                        rows[0] = RELATIONAL.analysis(projectDir, scenario.source)
                        rows[0].analysis_id = 'invalid_row'
                        rows[0].association_methods = ''
                        rows[0].heritability_methods = scenario.methods
                    })
                    if (scenario.options) {
                        method_options = RELATIONAL.methodOptions(outputDir, fixture, [invalid_row: scenario.options])
                    }
                }
            }

            then {
                def report = VALIDATION.report(outputDir, workflow.stdout)
                assertAll(
                    { assert !workflow.success },
                    { assert scenario.expected.every { fragment -> report.contains(fragment) } },
                    { assert TRACE.count(workflow, 'PREPARE_GENIE_INPUTS') == 0 },
                    { assert TRACE.count(workflow, 'GENIE_G') == 0 },
                )
            }
        }
    }

    def invalidAnnotations = [
        [
            name: 'an annotation whose row count disagrees with the cohort BIM',
            content: '1\n' * 2199,
            expected: "declares 2199 row(s) but the cohort's BIM declares 2200 variant(s)",
        ],
        [
            name: 'an annotation that assigns a variant to two components at once',
            content: '1 1\n' * 2200,
            expected: 'is in 2 component columns; overlapping component',
        ],
    ]

    invalidAnnotations.each { scenario ->
        test("preparation refuses ${scenario.name}") {

            tag "genie_annotation_validation"

            when {
                params {
                    def fixture = "genie_bad_annotation_${scenario.name.replaceAll(/\s+/, '_')}"
                    outdir = "$outputDir"
                    cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, fixture)
                    analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, fixture, { rows ->
                        rows[0].analysis_id = 'bad_annotation'
                        rows[0].association_methods = ''
                        rows[0].heritability_methods = 'genie_g'
                    })
                    method_options = RELATIONAL.methodOptions(outputDir, fixture, [analyses: [
                        bad_annotation: [genie: [
                            seed: 7,
                            random_vectors: 20,
                            annotation: RELATIONAL.resource(outputDir, "${fixture}.annot", scenario.content),
                        ]],
                    ]])
                }
            }

            then {
                // Ingress can check that the resource exists; only the adapter can check it against the
                // cohort's real BIM, and GENIE treats both of these as a warning at most.
                def report = VALIDATION.report(outputDir, workflow.stdout)
                assertAll(
                    { assert !workflow.success },
                    { assert report.contains(scenario.expected) },
                    { assert TRACE.count(workflow, 'GENIE_G') == 0 },
                )
            }
        }
    }

    test("preparation refuses a jackknife count the cohort cannot support") {

        tag "genie_blocks"

        when {
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'genie_blocks')
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'genie_blocks', { rows ->
                    rows[0].analysis_id = 'too_many_blocks'
                    rows[0].association_methods = ''
                    rows[0].heritability_methods = 'genie_g'
                })
                method_options = RELATIONAL.methodOptions(outputDir, 'genie_blocks', [analyses: [
                    too_many_blocks: [genie: [seed: 7, random_vectors: 20, jackknife_blocks: 3000]],
                ]])
            }
        }

        then {
            // The bound is the cohort's variant count, which ingress cannot see. Running 2200 blocks instead
            // of the 3000 asked for would change the reported standard error with nothing to say so.
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains('genie.jackknife_blocks 3000 exceeds the 2200 variant(s) in the cohort') },
                { assert TRACE.count(workflow, 'GENIE_G') == 0 },
            )
        }
    }

    test("a covariate cell missing only for an unphenotyped sample is accepted by both direct routes") {

        tag "genie_exempt_covariates"

        when {
            params {
                // The blanked cell belongs to the first sample, whose phenotype is then removed. Ingress
                // polices only the cells of phenotyped samples, so this file is admitted; the GENIE adapter
                // must admit it too rather than killing the run on an invariant ingress never asserted.
                def incomplete = RELATIONAL.covariatesWithMissingCell(projectDir, outputDir, 'exempt.qcovar', 'example.qcovar', 'AGE')
                def phenotype = RELATIONAL.phenotypeWithoutSample(projectDir, outputDir, 'exempt.pheno', 'example.pheno', 'QT', incomplete.fid, incomplete.iid)
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'genie_exempt')
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'genie_exempt', { rows ->
                    rows[0].analysis_id = 'exempt_genie'
                    rows[0].association_methods = ''
                    rows[0].heritability_methods = 'genie_g'
                    rows[0].quant_covariates = incomplete.path
                    rows[0].phenotype = phenotype

                    def fast = RELATIONAL.analysis(projectDir, 'example_pgen_qt')
                    fast.analysis_id = 'exempt_ldak_fast'
                    fast.association_methods = ''
                    fast.heritability_methods = 'ldak_fast_he'
                    fast.quant_covariates = incomplete.path
                    fast.phenotype = phenotype
                    rows << fast
                })
                method_options = RELATIONAL.methodOptions(outputDir, 'genie_exempt', [analyses: [
                    exempt_genie: [genie: [seed: 7, random_vectors: 20, jackknife_blocks: 100]],
                    exempt_ldak_fast: [ldak: [model: 'human_default', power: -0.25, weights_policy: 'equal', fast_seed: 7]],
                ]])
            }
        }

        then {
            // The end-to-end proof that the two direct-genotype families accept exactly the same covariate
            // file. A refusal on either side here would mean one route imposes a rule ingress does not.
            def genie = new File("${params.outdir}/heritability/individual/genie_g/exempt_genie")
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'PREPARE_GENIE_INPUTS') == 1 },
                { assert TRACE.count(workflow, 'GENIE_G') == 1 },
                { assert TRACE.count(workflow, 'LDAK_FASTHE') == 1 },
                { assert new File(genie, 'exempt_genie.genie_g.out').isFile() },
                { assert new File(genie, 'exempt_genie.genie_g.out').text.contains('Number of individuals after filtering: 199') },
                { assert new File(genie, 'exempt_genie.genie_g.out').text.contains('Total h2') },
                { assert !new File(genie, 'exempt_genie.genie_g.out').text.contains('nan') },
                { assert new File("${params.outdir}/heritability/individual/ldak_fast_he/exempt_ldak_fast/exempt_ldak_fast.ldak_fast_he.fasthe").isFile() },
            )
        }
    }

    test("preparation refuses an incomplete covariate file on a genie row") {

        tag "genie_covariates"

        when {
            params {
                def incomplete = RELATIONAL.covariatesWithMissingCell(projectDir, outputDir, 'genie_missing.qcovar', 'example.qcovar', 'AGE')
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'genie_covariates')
                analysis_manifest = RELATIONAL.analyses(projectDir, outputDir, 'genie_covariates', { rows ->
                    rows[0].analysis_id = 'incomplete_covariates'
                    rows[0].association_methods = ''
                    rows[0].heritability_methods = 'genie_g'
                    rows[0].quant_covariates = incomplete.path
                })
            }
        }

        then {
            // GENIE reads an unparsable `-c` cell as a value and excludes neither the sample nor the column,
            // exactly as LDAK does. `genie_g` therefore declares `requires_complete_covariates` and the shared
            // preparation rule refuses the analysis, which is the end-to-end proof that the two tools now
            // follow one policy rather than two.
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert TRACE.count(workflow, 'PREPARE_PHENOTYPE_INPUTS') == 0 },
                { assert TRACE.count(workflow, 'PREPARE_GENIE_INPUTS') == 0 },
                { assert TRACE.count(workflow, 'GENIE_G') == 0 },
                { assert report.contains('missing covariate cells') },
                { assert report.contains('S001 S001 AGE') },
            )
        }
    }
}

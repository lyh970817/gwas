nextflow_pipeline {

    name "Test MPH bivariate REML relationship routes"
    script "../main.nf"
    tag "pipeline"
    tag "relational"
    tag "genetic_correlation"
    tag "mph"
    tag "mph_bivariate_reml"

    // Both MPH pair selectors are quantitative-only, so every valid case declares two quantitative endpoints.
    // The shipped fixture carries one quantitative and one binary trait, so the second quantitative endpoint
    // reads the binary column as a quantitative variable rather than inventing a phenotype file. Unlike the
    // HEreg helper this one keeps the shipped pair covariates, because MPH does fit them and reports a BLUE per
    // trait for each.
    def quantitativePair = { projectDir, outputDir, name, methods, pairOptions = [:], mutateAnalyses = null ->
        def analyses = RELATIONAL.analyses(projectDir, outputDir, name, { rows ->
            def second = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
            second.analysis_id = 'example_pgen_qt2'
            second.trait_id = 'QT2'
            second.trait_type = 'quantitative'
            second.control_value = ''
            second.case_value = ''
            rows << second
            rows.each { row ->
                row.association_methods = ''
                row.heritability_methods = ''
            }
            if (mutateAnalyses) {
                mutateAnalyses(rows)
            }
        })
        def relationships = RELATIONAL.relationships(projectDir, outputDir, name, { rows ->
            rows[0].relationship_id = 'qt_qt2'
            rows[0].right_analysis_id = 'example_pgen_qt2'
            rows[0].relationship_methods = methods
        })
        return [
            cohort: RELATIONAL.cohorts(projectDir, outputDir, name),
            analyses: analyses,
            relationships: relationships,
            options: RELATIONAL.methodOptions(outputDir, name, [analyses: [:], pair_requests: pairOptions]),
        ]
    }

    def commands = { outputDir ->
        def scripts = []
        new File(new File(outputDir.toString()).parentFile, 'work').eachFileRecurse { entry ->
            if (entry.isFile() && entry.name == '.command.sh') {
                scripts << entry.text.replaceAll(/\\\s+/, ' ').replaceAll(/\s+/, ' ')
            }
        }
        return scripts
    }

    def slurper = new groovy.json.JsonSlurper()

    // MPH prints `-nan` or `nan` for a correlation it could not form, at exit 0 and beside a complete result
    // set. The sidecar publishes such an entry as null rather than rewriting it, so a test comparing the two
    // has to read the native token the same way.
    def nativeDouble = { token ->
        try {
            def parsed = token as Double
            return parsed.isNaN() || parsed.isInfinite() ? null : parsed
        }
        catch (NumberFormatException ignored) {
            return null
        }
    }

    // The six names every MPH pair request publishes: the five native files MPH writes for a multi-trait fit
    // and the pipeline's own sidecar. `native.mq.py.csv` is one projected phenotype per individual and stays in
    // the work directory for the reason LDAK's per-individual heritabilities do.
    def PUBLISHED = [
        'derived.provenance.json',
        'native.log',
        'native.mq.blue.csv',
        'native.mq.cor.csv',
        'native.mq.iter.csv',
        'native.mq.vc.csv',
    ]

    test("one relationship selecting both MPH tokens publishes two native families and two records") {

        // `seed: 7` is load-bearing rather than cosmetic. MPH's trace estimator is randomised and its default
        // seed is the fixed integer 0; on this fixture that seed leaves the dense pair's aggregate correlation
        // non-finite, so a future reader deleting the seed would get a `completed_nonestimable` result and
        // conclude the route had broken.
        when {
            def inputs = quantitativePair(
                projectDir,
                outputDir,
                'mph_bivariate_both',
                'mph_bivariate_reml,mph_bivariate_reml_ldms',
                [
                    'mph_bivariate_reml--qt_qt2': [seed: 7],
                    'mph_bivariate_reml_ldms--qt_qt2': [ld_score_region_kb: 50, ld_bins: 2, ldms_maf_edges: [0.0, 0.5], seed: 7],
                ],
            )
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = inputs.options
                gcta_grm_parts = 1
            }
        }

        then {
            def requests = new File("${params.outdir}/requests")
            def dense = new File(requests, 'mph_bivariate_reml/mph_bivariate_reml--qt_qt2')
            def stratified = new File(requests, 'mph_bivariate_reml_ldms/mph_bivariate_reml_ldms--qt_qt2')
            def remlCommands = commands(params.outdir).findAll { command -> command.contains('mph --reml') }
            def denseRecord = slurper.parseText(new File(dense, 'derived.provenance.json').text)
            def stratifiedRecord = slurper.parseText(new File(stratified, 'derived.provenance.json').text)
            def correlationRows = { file ->
                def lines = file.readLines()
                def header = lines.first().split(',').toList()
                return lines.tail().collect { row -> [header, row.split(',').toList()].transpose().collectEntries() }
            }
            def stratifiedCorrelations = correlationRows(new File(stratified, 'native.mq.cor.csv'))
            assertAll(
                { assert workflow.success },
                // The cohort is converted once, the component plan is built once, and two matrix families come
                // out of it. The prepared pair is built once however many pair methods select the relationship.
                { assert TRACE.count(workflow, 'PLINK2_MAKEBED') == 1 },
                { assert TRACE.count(workflow, 'GCTA_CALCULATELDSCORES') == 1 },
                { assert TRACE.count(workflow, 'CUSTOM_GCTASTRATIFYLDSCORES') == 1 },
                { assert TRACE.count(workflow, 'CUSTOM_MPHSNPINFO') == 2 },
                { assert TRACE.count(workflow, 'MPH_MAKEGRM') == 3 },
                { assert TRACE.count(workflow, 'PREPARE_BIVARIATE_TRAITS') == 1 },
                { assert TRACE.count(workflow, 'PREPARE_MPH_INPUTS') == 2 },
                { assert TRACE.count(workflow, 'MPH_REML') == 2 },
                { assert TRACE.count(workflow, 'SUMMARISE_MPH_RESULT') == 2 },
                { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') == 0 },
                { assert TRACE.count(workflow, 'LDAK_CALCKINS') == 0 },
                // Each request publishes under its own deterministic identity, so neither can overwrite the
                // other, and both publish the same six names.
                { assert requests.list().toList().sort() == ['mph_bivariate_reml', 'mph_bivariate_reml_ldms'] },
                { assert dense.list().toList().sort() == PUBLISHED },
                { assert stratified.list().toList().sort() == PUBLISHED },
                { assert PUBLISHED.every { name -> new File(dense, name).isFile() } },
                // The declared left/right order reaches the fit verbatim, and the covariate list is the encoded
                // design rather than the researcher's raw columns: `SEX` became the treatment-coded `SEX_2`
                // and `intercept` is explicit because MPH synthesises one only when no covariate is named.
                { assert remlCommands.size() == 2 },
                { assert remlCommands.every { command -> command.contains('--trait_names "QT,QT2"') } },
                { assert remlCommands.every { command -> command.contains('--seed 7') } },
                { assert remlCommands.every { command -> command.contains('--covariate_names "intercept,AGE,Q1,Q2,Q3,SEX_2"') } },
                { assert remlCommands.every { command -> command.contains('--grm_list') } },
                { assert remlCommands.every { command -> !command.contains('--num_random_vectors') } },
                // MPH itself prints the genome-wide correlation and its standard error, so the sidecar carries
                // MPH's own numbers and the pipeline derives nothing. The values on this fixture are
                // scientifically meaningless, so nothing here asserts a magnitude.
                { assert new File(stratified, 'native.log').text.contains('Non-missing analysis set contains 200 individuals') },
                { assert stratifiedRecord.result.kind == 'pairwise' },
                { assert stratifiedRecord.result.request_id == 'mph_bivariate_reml_ldms--qt_qt2' },
                { assert stratifiedRecord.result.relationship_id == 'qt_qt2' },
                { assert stratifiedRecord.result.left_analysis_id == 'example_pgen_qt' },
                { assert stratifiedRecord.result.right_analysis_id == 'example_pgen_qt2' },
                { assert stratifiedRecord.correlations.declared_trait_order == ['QT', 'QT2'] },
                // The observed label order is recorded rather than trusted: MPH reverses the pair, and the
                // rows are matched back by trait name.
                { assert stratifiedRecord.correlations.native_pair_order == 'reversed' },
                { assert stratifiedRecord.correlations.native_trait_pair_labels == [trait_x: 'QT2', trait_y: 'QT'] },
                { assert stratifiedRecord.correlations.components.size() == 2 },
                { assert stratifiedRecord.correlations.components.collect { component -> component.name } == ['ld01_maf01', 'ld02_maf01'] },
                { assert stratifiedRecord.correlations.total.vc_name == 'G' },
                { assert stratifiedRecord.correlations.residual.vc_name == 'err' },
                // Every published correlation is MPH's own value, matched by component name rather than by row
                // position, so this compares the sidecar against the native file it was read from.
                { assert stratifiedRecord.correlations.total.correlation == nativeDouble(stratifiedCorrelations.find { row -> row.vc_name == 'G' }.cor) },
                { assert stratifiedRecord.correlations.total.se == nativeDouble(stratifiedCorrelations.find { row -> row.vc_name == 'G' }.se) },
                { assert stratifiedRecord.correlations.residual.correlation == nativeDouble(stratifiedCorrelations.find { row -> row.vc_name == 'err' }.cor) },
                { assert stratifiedRecord.correlations.components.every { component ->
                    component.correlation == nativeDouble(stratifiedCorrelations.find { row -> row.vc_name == component.vc_name }.cor)
                } },
                // On this fixture, at this seed, MPH forms no correlation for one stratum and prints `-nan` for
                // it, at exit 0 with every other row complete. The record publishes that entry as null and
                // names it in the warning vocabulary rather than clamping, censoring or dropping it, and the
                // aggregate row MPH still produced stays populated beside it.
                { assert stratifiedCorrelations.any { row -> nativeDouble(row.cor) == null } },
                { assert stratifiedRecord.correlations.components.any { component -> component.correlation == null } },
                { assert stratifiedRecord.correlations.total.correlation != null },
                { assert stratifiedRecord.warnings.any { warning -> warning.startsWith('non_finite_correlation:') } },
                { assert stratifiedRecord.classification == 'estimable_with_warning' },
                // A one-component fit has nothing to aggregate, so MPH's synthetic total is that component.
                { assert denseRecord.correlations.components.size() == 1 },
                { assert denseRecord.correlations.total.correlation == denseRecord.correlations.components.first().correlation },
                // MPH always estimates the residual covariance of a multi-trait model and has no option to
                // drop it, which is what makes an MPH pair and a GCTA HEreg pair different models.
                { assert stratifiedRecord.residual_covariance == 'estimated' },
                { assert denseRecord.residual_covariance == 'estimated' },
                // Both endpoints are complete on this fixture, so the complete-case rule costs nothing here
                // and the four shared core counts agree.
                { assert stratifiedRecord.inputs.samples.left_nonmissing == 200 },
                { assert stratifiedRecord.inputs.samples.right_nonmissing == 200 },
                { assert stratifiedRecord.inputs.samples.both == 200 },
                { assert stratifiedRecord.inputs.samples.union == 200 },
                { assert stratifiedRecord.inputs.samples.retained == 200 },
                { assert stratifiedRecord.inputs.samples.detail.sample_policy == 'complete_case_intersection' },
                { assert stratifiedRecord.stochastic_settings.seed == 7 },
                { assert stratifiedRecord.stochastic_settings.num_threads != null },
                { assert stratifiedRecord.component_plan.components.collect { component -> component.name } == ['ld01_maf01', 'ld02_maf01'] },
                { assert stratifiedRecord.component_plan.components.every { component -> component.native_predictor_count == component.plan_predictor_count } },
                // The ignore globs exist because the log carries a container-local timestamp and every
                // `mq.*.csv` moves in the sixth to seventh significant figure with the thread count. They are
                // proved here rather than assumed.
                { assert getAllFilesFromDir("${params.outdir}", relative: true, ignoreFile: 'tests/.nftignore')
                    .collect { path -> path.toString() }
                    .findAll { path -> path.startsWith('requests/mph_bivariate_reml') }
                    .every { path -> !path.endsWith('native.log') && !path.contains('native.mq.') && !path.endsWith('derived.provenance.json') } },
                { assert snapshot(removeNextflowVersion("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")).match('versions') },
            )
        }
    }

    test("an MPH pair and a GCTA pair over one relationship share the component plan and the prepared pair") {

        // #12 asks that the two estimators consume the same scientific LDMS component plan and the same ordered
        // SNP membership, and that is what this case asserts: one plan, one LD-score pass, one stratification,
        // one prepared pair, and the same per-component predictor count on both sides.
        //
        // It deliberately makes no numeric comparison of the two estimates, for two measured reasons. MPH's
        // REML is unconstrained and has no option to constrain, while the pipeline's GCTA bivariate routes run
        // constrained by default, so the pipeline's own default GCTA result is not a matched model to an MPH
        // fit. And the matched configuration is not reachable on this fixture: adding `--reml-no-constrain
        // --reml-maxit 500` to this GCTA pair request makes GCTA 1.94.1 diverge on this near-zero-signal pair
        // and terminate with exit status 139 partway through its iteration trace. Building a fixture with
        // enough signal for a meaningful numeric comparison is a fixture change rather than a routing one.
        //
        // The plan is one stratum rather than two for the same reason the shipped GCTA REML-LDMS route test
        // uses one: the two-stratum constrained fit of this covariate-adjusted pair cycles between five
        // parameter states and exits 1 at the iteration cap. One stratum is enough to prove the plan is built
        // once and read by both builders, which is the claim.
        when {
            def inputs = quantitativePair(
                projectDir,
                outputDir,
                'mph_bivariate_parity',
                'gcta_bivariate_reml_ldms,mph_bivariate_reml_ldms',
                [
                    'gcta_bivariate_reml_ldms--qt_qt2': [ld_score_region_kb: 50, ld_bins: 1, ldms_maf_edges: [0.0, 0.5], native_args: ['--reml-maxit', '500']],
                    'mph_bivariate_reml_ldms--qt_qt2': [ld_score_region_kb: 50, ld_bins: 1, ldms_maf_edges: [0.0, 0.5], seed: 7],
                ],
            )
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = inputs.options
                gcta_grm_parts = 1
                save_relatedness_matrices = true
            }
        }

        then {
            def mphRequest = new File("${params.outdir}/requests/mph_bivariate_reml_ldms/mph_bivariate_reml_ldms--qt_qt2")
            def gctaRequest = new File("${params.outdir}/requests/gcta_bivariate_reml_ldms/gcta_bivariate_reml_ldms--qt_qt2")
            def plans = new File("${params.outdir}/quality_control/ldms_component_plans")
            def gctaCommand = commands(params.outdir).find { command -> command.contains('--reml-bivar') }
            def mphRecord = slurper.parseText(new File(mphRequest, 'derived.provenance.json').text)
            def gctaResult = new File(gctaRequest, 'native.hsq').readLines()
            def mphResult = new File(mphRequest, 'native.mq.vc.csv').readLines()
            def mphHeader = mphResult.first().split(',').toList()
            def mphRows = mphResult.tail().collect { row -> [mphHeader, row.split(',').toList()].transpose().collectEntries() }
            def mphComponents = mphRecord.component_plan.components
            assertAll(
                { assert workflow.success },
                // One plan, one LD-score pass, one stratification: both matrix families are built from the same
                // published component plan, which is the acceptance criterion this case exists for.
                { assert TRACE.count(workflow, 'GCTA_CALCULATELDSCORES') == 1 },
                { assert TRACE.count(workflow, 'CUSTOM_GCTASTRATIFYLDSCORES') == 1 },
                { assert plans.list().toList().size() == 1 },
                // One component family per tool: they are different on-disk formats and are never
                // interchanged, so both are built rather than one being reused as the other.
                { assert TRACE.count(workflow, 'MPH_MAKEGRM') == 1 },
                { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') == 1 },
                // One prepared pair for both estimators: the two adapters serialise one scientific pair rather
                // than each resolving the endpoints again.
                { assert TRACE.count(workflow, 'PREPARE_BIVARIATE_TRAITS') == 1 },
                // Both estimators fitted the same stratum of the same plan. The MPH side is matched by label
                // -- `vc_name` against the staged matrix prefix -- and never by row position, and its achieved
                // predictor count equals the count the plan declared for that stratum.
                { assert gctaCommand != null },
                { assert mphComponents.size() == 1 },
                { assert mphComponents.collect { component -> component.name } == ['ld01_maf01'] },
                { assert mphComponents.every { component -> component.native_predictor_count == component.plan_predictor_count } },
                { assert mphRows.findAll { row -> row.vc_name != 'err' }.collect { row -> row.m as int }.unique()
                    == mphComponents.collect { component -> component.plan_predictor_count } },
                // A one-component `--mgrm` fit is GCTA's one-component layout: `V(G)_tr1` rather than a
                // numbered `V(G1)_tr1`, and no second component row at all.
                { assert gctaResult.any { line -> line.startsWith('V(G)_tr1\t') } },
                { assert !gctaResult.any { line -> line.startsWith('V(G2)_tr1\t') } },
                // Both native families are published under their own request identities, so a reader can
                // compare them without the pipeline joining them into one table.
                { assert new File(mphRequest, 'native.mq.vc.csv').isFile() },
                { assert new File(gctaRequest, 'native.hsq').isFile() },
            )
        }
    }

    test("a unary and a pairwise MPH request at equal settings share one plan and one matrix family") {

        // #12's matrix-reuse acceptance criterion. The matrix reuse key is derived from the cohort, the
        // genotype bundle and the declared plan settings only, never from the request domain, so an analysis
        // row and a relationship row cost one construction between them.
        when {
            def inputs = quantitativePair(
                projectDir,
                outputDir,
                'mph_bivariate_dedup',
                'mph_bivariate_reml_ldms',
                ['mph_bivariate_reml_ldms--qt_qt2': [ld_score_region_kb: 50, ld_bins: 2, ldms_maf_edges: [0.0, 0.5], seed: 7]],
                { rows -> rows[0].heritability_methods = 'mph_reml_ldms' },
            )
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = RELATIONAL.methodOptions(outputDir, 'mph_bivariate_dedup', [
                    analyses: [example_pgen_qt: [gcta: [ld_score_region_kb: 50, ld_bins: 2, ldms_maf_edges: [0.0, 0.5]], mph: [seed: 7]]],
                    pair_requests: ['mph_bivariate_reml_ldms--qt_qt2': [ld_score_region_kb: 50, ld_bins: 2, ldms_maf_edges: [0.0, 0.5], seed: 7]],
                ])
                gcta_grm_parts = 1
                save_relatedness_matrices = true
            }
        }

        then {
            def plans = new File("${params.outdir}/quality_control/ldms_component_plans")
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'GCTA_CALCULATELDSCORES') == 1 },
                { assert TRACE.count(workflow, 'CUSTOM_GCTASTRATIFYLDSCORES') == 1 },
                { assert plans.list().toList().size() == 1 },
                // One family of two strata, not two families of two: the unary and the pair request resolved
                // the same settings and therefore the same key.
                { assert TRACE.count(workflow, 'CUSTOM_MPHSNPINFO') == 1 },
                { assert TRACE.count(workflow, 'MPH_MAKEGRM') == 2 },
                // Both results are published, each under its own identity.
                { assert TRACE.count(workflow, 'MPH_REML') == 2 },
                { assert new File("${params.outdir}/heritability/individual/mph_reml_ldms/example_pgen_qt").isDirectory() },
                { assert new File("${params.outdir}/requests/mph_bivariate_reml_ldms/mph_bivariate_reml_ldms--qt_qt2").isDirectory() },
                // One published matrix family under one key, which is what "one construction between them"
                // means on disk.
                { assert new File("${params.outdir}/quality_control/relatedness_matrices").list().toList().size() == 1 },
            )
        }
    }

    test("a partially overlapping relationship is fitted on the complete-case intersection and says so") {

        // The scientific difference between the two pair families, asserted rather than asserted about. MPH
        // restricts the fit to individuals observed for both traits and every named covariate; GCTA bivariate
        // REML keeps every individual and fits an unbalanced design, so over a partially overlapping
        // relationship the two are not matched models. The sidecar is where that becomes visible.
        when {
            def source = new File("${FIXTURES.base(projectDir)}results/fixtures/pheno_cov/example.pheno")
            def lines = source.readLines()
            def header = lines.first().split('\t').toList()
            def column = header.indexOf('BT')
            def thinned = RELATIONAL.resource(
                outputDir,
                'mph_bivariate_overlap.pheno',
                ([lines.first()] + lines.tail().withIndex().collect { line, index ->
                    def fields = line.split('\t').toList()
                    if (index >= 120) {
                        fields[column] = 'NA'
                    }
                    return fields.join('\t')
                }).join('\n') + '\n',
            )
            def inputs = quantitativePair(
                projectDir,
                outputDir,
                'mph_bivariate_overlap',
                'mph_bivariate_reml',
                ['mph_bivariate_reml--qt_qt2': [seed: 7]],
                { rows -> rows[1].phenotype = thinned },
            )
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = inputs.options
                gcta_grm_parts = 1
            }
        }

        then {
            def request = new File("${params.outdir}/requests/mph_bivariate_reml/mph_bivariate_reml--qt_qt2")
            def record = slurper.parseText(new File(request, 'derived.provenance.json').text)
            assertAll(
                { assert workflow.success },
                // MPH's own report is the authority on which sample the estimate describes, and the sidecar's
                // shared `retained` key is that number rather than the number of rows the adapter wrote.
                { assert new File(request, 'native.log').text.contains('Non-missing analysis set contains 120 individuals') },
                { assert record.inputs.samples.left_nonmissing == 200 },
                { assert record.inputs.samples.right_nonmissing == 120 },
                { assert record.inputs.samples.both == 120 },
                { assert record.inputs.samples.union == 200 },
                { assert record.inputs.samples.retained == 120 },
                { assert record.inputs.samples.dropped == 80 },
                { assert record.inputs.samples.detail.sample_policy == 'complete_case_intersection' },
                // Attrition is recorded and classified, never refused: a partially overlapping relationship is
                // a valid analysis whose reader has to be told how much of the cohort it used.
                { assert record.warnings.any { warning -> warning.startsWith('complete_case_attrition') } },
                { assert record.classification == 'estimable_with_warning' },
            )
        }
    }

    test("changing the seed reruns the fit and its record while the plan, the matrices and the pair stay cached") {

        tag "mph_bivariate_resume"

        when {
            def inputs = quantitativePair(
                projectDir,
                outputDir,
                'mph_bivariate_resume',
                'mph_bivariate_reml_ldms',
                ['mph_bivariate_reml_ldms--qt_qt2': [ld_score_region_kb: 50, ld_bins: 2, ldms_maf_edges: [0.0, 0.5], seed: 7]],
            )
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = inputs.options
                gcta_grm_parts = 1
            }
        }

        then {
            def rerun = RESUME.rerun(outputDir, [
                method_options: RELATIONAL.methodOptions(outputDir, 'mph_bivariate_resume_reseeded', [
                    analyses: [:],
                    pair_requests: ['mph_bivariate_reml_ldms--qt_qt2': [ld_score_region_kb: 50, ld_bins: 2, ldms_maf_edges: [0.0, 0.5], seed: 8]],
                ]),
            ])
            assertAll(
                { assert workflow.success },
                // The seed reaches the fit and nothing above it. The prepared pair stays cached because its
                // identity is the relationship's, not the request's: this is the property that makes sharing
                // the preparation between a GCTA and an MPH request safe.
                { assert RESUME.statuses(rerun, 'GCTA_CALCULATELDSCORES') == ['CACHED'] },
                { assert RESUME.statuses(rerun, 'CUSTOM_GCTASTRATIFYLDSCORES') == ['CACHED'] },
                { assert RESUME.statuses(rerun, 'CUSTOM_MPHSNPINFO') == ['CACHED'] },
                { assert RESUME.statuses(rerun, 'MPH_MAKEGRM').unique() == ['CACHED'] },
                { assert RESUME.statuses(rerun, 'PREPARE_BIVARIATE_TRAITS') == ['CACHED'] },
                { assert RESUME.statuses(rerun, 'MPH_REML') == ['COMPLETED'] },
                { assert RESUME.statuses(rerun, 'SUMMARISE_MPH_RESULT') == ['COMPLETED'] },
                // The serializer reruns too, because the effective settings it records are part of its task
                // identity; the CSVs it writes are byte-identical either way.
                { assert RESUME.statuses(rerun, 'PREPARE_MPH_INPUTS') == ['COMPLETED'] },
            )
        }
    }

    test("MPH pair routes preserve topology under stub execution beside the GCTA pair routes") {
        options "-stub"

        when {
            def inputs = quantitativePair(
                projectDir,
                outputDir,
                'mph_bivariate_stub',
                'mph_bivariate_reml,mph_bivariate_reml_ldms,gcta_bivariate_reml,gcta_bivariate_reml_ldms',
                [
                    'mph_bivariate_reml_ldms--qt_qt2': [ld_score_region_kb: 50, ld_bins: 2, ldms_maf_edges: [0.0, 0.5]],
                    'gcta_bivariate_reml_ldms--qt_qt2': [ld_score_region_kb: 50, ld_bins: 2, ldms_maf_edges: [0.0, 0.5]],
                ],
            )
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = inputs.options
                gcta_grm_parts = 1
            }
        }

        then {
            def requests = new File("${params.outdir}/requests")
            assertAll(
                { assert workflow.success },
                // Four estimator tasks over one prepared pair, and both tools build their own matrices: the
                // two formats are never interchanged.
                { assert TRACE.count(workflow, 'PREPARE_BIVARIATE_TRAITS') == 1 },
                { assert TRACE.count(workflow, 'MPH_REML') == 2 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEREML') == 1 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEREMLLDMS') == 1 },
                { assert TRACE.count(workflow, 'MPH_MAKEGRM') > 0 },
                { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') > 0 },
                { assert requests.list().toList().sort() == [
                    'gcta_bivariate_reml',
                    'gcta_bivariate_reml_ldms',
                    'mph_bivariate_reml',
                    'mph_bivariate_reml_ldms',
                ] },
            )
        }
    }

    def rejections = [
        [
            name: 'a binary endpoint',
            fixture: 'mph_bivariate_binary',
            methods: 'mph_bivariate_reml',
            pairOptions: [:],
            mutateAnalyses: null,
            keepBinary: true,
            message: 'support two quantitative endpoints only',
        ],
        [
            name: 'a curated MPH option on a GCTA pair request',
            fixture: 'mph_bivariate_wrong_family',
            methods: 'gcta_bivariate_reml',
            pairOptions: ['gcta_bivariate_reml--qt_qt2': [seed: 7]],
            mutateAnalyses: null,
            keepBinary: false,
            message: 'unknown option; accepted options are',
        ],
        [
            name: 'a fractional seed on an MPH pair request',
            fixture: 'mph_bivariate_bad_seed',
            methods: 'mph_bivariate_reml',
            pairOptions: ['mph_bivariate_reml--qt_qt2': [seed: 1.5]],
            mutateAnalyses: null,
            keepBinary: false,
            message: "request_id 'mph_bivariate_reml--qt_qt2', option 'seed': expected an integer or null",
        ],
        [
            name: 'a wrapper-owned MPH flag in native_args',
            fixture: 'mph_bivariate_reserved_flag',
            methods: 'mph_bivariate_reml',
            pairOptions: ['mph_bivariate_reml--qt_qt2': [native_args: ['--seed', '3']]],
            mutateAnalyses: null,
            keepBinary: false,
            message: 'is not an accepted MPH native argument',
        ],
        [
            name: 'a GCTA flag in an MPH pair request native_args',
            fixture: 'mph_bivariate_foreign_flag',
            methods: 'mph_bivariate_reml',
            pairOptions: ['mph_bivariate_reml--qt_qt2': [native_args: ['--reml-no-constrain']]],
            mutateAnalyses: null,
            keepBinary: false,
            message: 'is not an accepted MPH native argument',
        ],
    ]

    rejections.each { scenario ->
        test("validation refuses ${scenario.name}") {

            when {
                def analyses = RELATIONAL.analyses(projectDir, outputDir, scenario.fixture, { rows ->
                    def second = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                    second.analysis_id = 'example_pgen_qt2'
                    if (!scenario.keepBinary) {
                        second.trait_id = 'QT2'
                        second.trait_type = 'quantitative'
                        second.control_value = ''
                        second.case_value = ''
                    }
                    rows << second
                    rows.each { row ->
                        row.association_methods = ''
                        row.heritability_methods = ''
                    }
                })
                def relationships = RELATIONAL.relationships(projectDir, outputDir, scenario.fixture, { rows ->
                    rows[0].relationship_id = 'qt_qt2'
                    rows[0].right_analysis_id = 'example_pgen_qt2'
                    rows[0].relationship_methods = scenario.methods
                })
                params {
                    outdir = "$outputDir"
                    cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, scenario.fixture)
                    analysis_manifest = analyses
                    relationship_manifest = relationships
                    method_options = RELATIONAL.methodOptions(outputDir, scenario.fixture, [analyses: [:], pair_requests: scenario.pairOptions])
                    gcta_grm_parts = 1
                }
            }

            then {
                // Every one of these is knowable from the manifests alone, so it must be refused before any
                // task is submitted rather than after an estimator has run.
                assertAll(
                    { assert !workflow.success },
                    { assert VALIDATION.report(outputDir, workflow.stdout).contains(scenario.message) },
                    { assert TRACE.count(workflow, 'MPH_REML') == 0 },
                    { assert TRACE.count(workflow, 'GCTA_BIVARIATEREML') == 0 },
                )
            }
        }
    }

    test("validation refuses a reversed duplicate of a relationship an MPH pair method already binds") {

        when {
            def analyses = RELATIONAL.analyses(projectDir, outputDir, 'mph_bivariate_reversed', { rows ->
                def second = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                second.analysis_id = 'example_pgen_qt2'
                second.trait_id = 'QT2'
                second.trait_type = 'quantitative'
                second.control_value = ''
                second.case_value = ''
                rows << second
                rows.each { row ->
                    row.association_methods = ''
                    row.heritability_methods = ''
                }
            })
            def relationships = RELATIONAL.relationships(projectDir, outputDir, 'mph_bivariate_reversed', { rows ->
                rows[0].relationship_id = 'qt_qt2'
                rows[0].right_analysis_id = 'example_pgen_qt2'
                rows[0].relationship_methods = 'mph_bivariate_reml'
                def reversed = new LinkedHashMap(rows[0])
                reversed.relationship_id = 'qt2_qt'
                reversed.left_analysis_id = 'example_pgen_qt2'
                reversed.right_analysis_id = 'example_pgen_qt'
                rows << reversed
            })
            params {
                outdir = "$outputDir"
                cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, 'mph_bivariate_reversed')
                analysis_manifest = analyses
                relationship_manifest = relationships
                method_options = RELATIONAL.methodOptions(outputDir, 'mph_bivariate_reversed', [analyses: [:], pair_requests: [:]])
                gcta_grm_parts = 1
            }
        }

        then {
            // Declared orientation is the execution and presentation order, and it also perturbs MPH's own
            // randomised trace, so the two rows are not the same request twice and neither is a duplicate the
            // pipeline may silently collapse.
            assertAll(
                { assert !workflow.success },
                { assert VALIDATION.report(outputDir, workflow.stdout).contains('unordered endpoint binding duplicates relationship_id') },
                { assert TRACE.count(workflow, 'MPH_REML') == 0 },
            )
        }
    }
}

nextflow_pipeline {

    name "Test PLINK 2 --glm association route"
    script "../main.nf"
    tag "pipeline"
    tag "association"
    tag "plink2"

    // These tests run the phenotype normaliser and PLINK 2 over the real fixture bundle, so every
    // sheet is built with SAMPLESHEET.fixtures rather than with the placeholder sheets the validation
    // suite uses: normalisation reads the phenotype file's header and recodes its values, so an empty
    // placeholder would prove nothing.
    //
    // Rows of assets/samplesheet.csv, and therefore of every sheet below before it is mutated:
    //   index 0 -> example_pgen_qt   cohort example_pgen, quantitative, source column QT at position 3
    //   index 1 -> example_pgen_bt   cohort example_pgen, binary,       source column BT at position 4
    //   index 2 -> example_bfile_qt  cohort example_bfile, PLINK 1 genotypes, no association method
    //   index 3 -> example_vcf_qt    cohort example_vcf,   VCF genotypes,     no association method
    //
    // Only rows 0 and 1 select plink2, so an association result is expected for those two and for no
    // other row.

    // Adds a second PLINK 1 cohort and three further analysis units on the VCF cohort, giving four
    // cohorts carrying 1, 1, 2 and 4 analysis units. Identical to the sheet
    // tests/prepared_genotypes.nf.test uses, so the two files make their per-cohort and per-analysis
    // claims about the same run shape.
    def spread = { rows ->
        def second_plink1 = new LinkedHashMap(rows[2])
        second_plink1.analysis_id = 'example_bfile2_qt'
        second_plink1.cohort_id = 'example_bfile2'
        rows << second_plink1

        (2..4).each { index ->
            def extra_trait = new LinkedHashMap(rows[3])
            extra_trait.analysis_id = "example_vcf_qt${index}"
            extra_trait.trait_id = "QT${index}"
            rows << extra_trait
        }
    }

    // Every file a task wrote or had staged, read out of the run's working directory.
    //
    // Two of this route's properties are about files that are deliberately *not* published, so they
    // cannot be asserted from the output directory: the headerless serialisation GCTA and LDAK take,
    // which carries the same content as its headered counterpart, and the covariate file that a row
    // without covariates must not have had fabricated for it.
    def work_files = { output_dir ->
        def files = []
        new File(new File(output_dir.toString()).parentFile, 'work').eachFileRecurse { entry ->
            if (entry.isFile()) {
                files << entry
            }
        }
        return files
    }

    test("normalisation runs once per analysis unit where cohort preparation runs once per cohort") {

        when {
            params {
                outdir = "$outputDir"
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "association_spread", spread)
                save_normalised_phenotypes = true
            }
        }

        then {
            def analyses = [
                'example_bfile2_qt',
                'example_bfile_qt',
                'example_pgen_bt',
                'example_pgen_qt',
                'example_vcf_qt',
                'example_vcf_qt2',
                'example_vcf_qt3',
                'example_vcf_qt4',
            ]
            def normalised = new File("${params.outdir}/phenotypes")
            assert workflow.success
            assertAll(
                // Asserted from the trace rather than from published files: a cached task publishes
                // the same files as a re-executed one, so only the trace answers "how many ran".
                { assert TRACE.tags(workflow, 'NORMALISE_PHENOTYPES') == analyses },
                // The contrast is what makes the claim mean anything. The same eight analysis units
                // sit on four cohorts, and preparation still ran once per cohort that needed one —
                // normalisation is keyed to the analysis unit, preparation to the cohort.
                { assert TRACE.tags(workflow, 'PLINK2_MAKEPGEN') == ['example_bfile', 'example_bfile2'] },
                { assert TRACE.tags(workflow, 'PLINK2_VCF') == ['example_vcf'] },
                // Two of the eight units select plink2.
                { assert TRACE.count(workflow, 'PLINK2_GLM') == 2 },
                { assert normalised.list().toList().sort() == analyses },
                // Quantitative and categorical covariates are separate outputs, which is what lets
                // GCTA take them through --qcovar and --covar and LDAK through --covar and --factors.
                // The merged file beside them is the single file PLINK 2 and REGENIE take instead.
                { assert new File(normalised, 'example_pgen_qt').list().toList().sort() == [
                    'example_pgen_qt.catcovar',
                    'example_pgen_qt.covar',
                    'example_pgen_qt.pheno',
                    'example_pgen_qt.qcovar',
                ] },
                { assert new File(normalised, 'example_pgen_qt/example_pgen_qt.qcovar').readLines().first().split('\t').toList() == [
                    'FID',
                    'IID',
                    'AGE',
                    'PC1',
                    'PC2',
                    'PC3',
                    'PC4',
                    'PC5',
                ] },
                { assert new File(normalised, 'example_pgen_qt/example_pgen_qt.catcovar').readLines().first().split('\t').toList() == ['FID', 'IID', 'SEX'] },
                // The merged file is the two joined on FID and IID, quantitative columns first.
                { assert new File(normalised, 'example_pgen_qt/example_pgen_qt.covar').readLines().first().split('\t').toList() == [
                    'FID',
                    'IID',
                    'AGE',
                    'PC1',
                    'PC2',
                    'PC3',
                    'PC4',
                    'PC5',
                    'SEX',
                ] },
            )
        }
    }

    test("the normalised trait sits at a fixed column position whatever its source name and position") {

        when {
            params {
                outdir = "$outputDir"
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "fixed_column", null)
                save_normalised_phenotypes = true
            }
        }

        then {
            def qt = new File("${params.outdir}/phenotypes/example_pgen_qt/example_pgen_qt.pheno").readLines()
            def bt = new File("${params.outdir}/phenotypes/example_pgen_bt/example_pgen_bt.pheno").readLines()
            def codes = bt[1..-1].collect { line -> line.split('\t')[2] }.countBy { code -> code }
            assert workflow.success
            assertAll(
                // The fixture is FID IID QT BT, so the two analysis units read source columns that
                // differ in name *and* in position, and both land in the same place: a three-column
                // file whose trait is always the third column, always called PHENO. That is what
                // turns GCTA's and LDAK's --mpheno into the constant 1 and makes PLINK 2's
                // phenotype-named output filename deterministic.
                { assert qt.first().split('\t').toList() == ['FID', 'IID', 'PHENO'] },
                { assert bt.first().split('\t').toList() == ['FID', 'IID', 'PHENO'] },
                { assert qt.size() == 501 },
                { assert bt.size() == 501 },
                { assert qt[1..-1].every { line -> line.split('\t').size() == 3 } },
                { assert bt[1..-1].every { line -> line.split('\t').size() == 3 } },
                // Source column 3, a quantitative value copied verbatim.
                { assert qt[1].split('\t').toList() == ['HG00096', 'HG00096', '0.317843'] },
                // Source column 4, recoded. The row declares control_value 1 and case_value 2, and
                // HG00096 carries BT 1, so it is a control and normalises to 0 — the coding all four
                // downstream programmes read the same way.
                { assert bt[1].split('\t').toList() == ['HG00096', 'HG00096', '0'] },
                // A tally rather than a single cell, so a recode that happened to get the first row
                // right cannot pass. The fixture is 350 controls and 150 cases.
                { assert codes == ['0': 350, '1': 150] },
                // The headerless serialisation GCTA and LDAK take is byte-identical minus line 1. It
                // is deliberately unpublished, so it is read from the working directory.
                { assert work_files(outputDir).find { entry -> entry.name == 'example_pgen_qt.noheader.pheno' }.readLines() == qt[1..-1] },
                { assert work_files(outputDir).find { entry -> entry.name == 'example_pgen_bt.noheader.pheno' }.readLines() == bt[1..-1] },
            )
        }
    }

    test("a row that omits covariates entirely completes with no placeholder file") {

        when {
            params {
                outdir = "$outputDir"
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "no_covariates", { rows ->
                    rows.each { row ->
                        row.quant_covariates = ''
                        row.cat_covariates = ''
                    }
                })
                save_normalised_phenotypes = true
            }
        }

        then {
            def written = work_files(outputDir).collect { entry -> entry.name }
            // Not a weak assertion. PLINK 2 errors out on an unadjusted --glm unless it is told the
            // omission is deliberate, so a run that reaches here proves `allow-no-covars` was applied
            // to exactly the rows that needed it.
            assert workflow.success
            assertAll(
                // Only the phenotype. No .qcovar, no .catcovar, no merged .covar.
                { assert new File("${params.outdir}/phenotypes/example_pgen_qt").list().toList() == ['example_pgen_qt.pheno'] },
                { assert new File("${params.outdir}/phenotypes/example_pgen_bt").list().toList() == ['example_pgen_bt.pheno'] },
                // Nothing was fabricated out of sight either: no covariate file of any kind was
                // written into or staged in a task's working directory.
                { assert written.findAll { name -> name.endsWith('.covar') || name.endsWith('.qcovar') || name.endsWith('.catcovar') } == [] },
                // And the association still ran.
                { assert new File("${params.outdir}/association/plink2/example_pgen_qt").list().toList() == ['example_pgen_qt.plink2.glm.linear'] },
                { assert new File("${params.outdir}/association/plink2/example_pgen_bt").list().toList() == ['example_pgen_bt.plink2.glm.logistic.hybrid'] },
            )
        }
    }

    test("the default run publishes association results by stage and method and nothing else") {

        when {
            params {
                outdir = "$outputDir"
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "association_default", null)
            }
        }

        then {
            def association = new File("${params.outdir}/association")
            def plink2 = new File(association, 'plink2')
            def versions = new File("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")
            def linear = new File(plink2, 'example_pgen_qt/example_pgen_qt.plink2.glm.linear').readLines()
            def header = linear.first().split('\t').toList()
            // The association tree only. The whole-tree snapshot is tests/default.nf.test's job, and
            // a labelled per-area snapshot is what keeps this file's diffs readable as later routes
            // add their own directories beside this one.
            // stable_name: All files + folders in ${params.outdir}/association/ with a stable name.
            // The directory it is pointed at comes back as an empty relative path, which is dropped.
            def stable_name = getAllFilesFromDir("${params.outdir}/association", relative: true, includeDir: true).findAll { path -> path.toString() }
            // stable_path: All files in ${params.outdir}/association/ with stable content
            def stable_path = getAllFilesFromDir("${params.outdir}/association", ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                // Pipeline information and the MultiQC report each have their own top-level
                // directory, the native association results have theirs, the harmonised summary
                // statistics theirs, and the heritability estimate of the one demo row that selects a
                // wired heritability method has its own; nothing else is published, because the
                // prepared cohort bundles, the normalised phenotypes and the relatedness matrix are
                // intermediates and all three save controls are unset. What this file owns is the
                // `association` tree; `tests/summary_statistics.nf.test` owns the harmonised one and
                // `tests/heritability_gcta_greml.nf.test` the heritability one.
                { assert new File("${params.outdir}").list().toList().sort() == ['association', 'heritability', 'multiqc', 'pipeline_info', 'summary_statistics'] },
                { assert !new File("${params.outdir}/genotypes").exists() },
                { assert !new File("${params.outdir}/phenotypes").exists() },
                // Both intermediates were genuinely produced, so their absence above is a publishing
                // decision rather than a step that silently did not run.
                { assert TRACE.count(workflow, 'NORMALISE_PHENOTYPES') == 4 },
                { assert TRACE.count(workflow, 'PLINK2_MAKEPGEN') == 1 },
                { assert TRACE.count(workflow, 'PLINK2_VCF') == 1 },
                // Nested by scientific stage, then method, then analysis identifier. The four demo
                // rows exercise all three association routes: two PLINK 2 analyses plus one fastGWA
                // and one LDAK-KVIK analysis.
                { assert association.list().toList().sort() == ['gcta_fastgwa', 'ldak_kvik', 'plink2'] },
                { assert plink2.list().toList().sort() == ['example_pgen_bt', 'example_pgen_qt'] },
                // The extension *is* the Firth assertion: PLINK 2 names the file after the regression
                // it actually ran, and `.logistic.hybrid` is the hybrid Firth-fallback fit. A binary
                // trait fitted without the fallback would be `.glm.logistic`.
                { assert new File(plink2, 'example_pgen_bt').list().toList() == ['example_pgen_bt.plink2.glm.logistic.hybrid'] },
                { assert new File(plink2, 'example_pgen_qt').list().toList() == ['example_pgen_qt.plink2.glm.linear'] },
                { assert new File(association, 'gcta_fastgwa/example_bfile_qt').list().toList() == ['example_bfile_qt.gcta_fastgwa.fastGWA'] },
                { assert new File(association, 'ldak_kvik/example_vcf_qt').list().toList() == ['example_vcf_qt.ldak_kvik.step2.assoc'] },
                // The filename grammar, stated once as a pattern rather than restated per file:
                // analysis identifier, then method, then the native suffix.
                { assert plink2.listFiles().every { directory ->
                    directory.list().every { name -> name ==~ "\\Q${directory.name}\\E\\.plink2\\.glm\\.(linear|logistic|logistic\\.hybrid|firth)" }
                } },
                // Allele frequency and sample count, which the harmonisation ticket that follows
                // needs and which `cols=+a1freq` states explicitly rather than inheriting.
                { assert 'A1_FREQ' in header },
                { assert 'OBS_CT' in header },
                // Every sample in the fixture was analysed. This is the contrast that gives the
                // missing-value test below its meaning.
                { assert linear[1].split('\t')[header.indexOf('OBS_CT')] == '500' },
                // Published unmodified: stable_path is a content hash of the file PLINK 2 wrote, and
                // the only thing the publish directive changes is the name.
                { assert snapshot(stable_name, stable_path).match('association') },
                // MULTIQC is deliberately absent from the versions map. Its input is the collected
                // versions file, so publishing its own version to the `versions` topic would make the
                // topic unable to close and hang the run — see modules/nf-core/multiqc/main.nf. sarek,
                // rnaseq and the nf-core template all leave it out for the same reason, and MultiQC
                // reports its version in its own report.
                { assert !versions.text.contains('MULTIQC') },
                { assert snapshot(removeNextflowVersion(versions.toString())).match('versions') },
            )
        }
    }

    test("missing values in the source files normalise to the one code every programme reads") {

        when {
            params {
                outdir = "$outputDir"
                // The committed fixtures carry no missing value of any kind, so this scenario builds
                // its own copies. Ten phenotype rows are rewritten to the spellings a researcher's
                // file may really carry — PLINK's and GCTA's -9, lower- and upper-case NA and nan, an
                // empty cell, and a value that is not a number at all — and, on the binary row, a
                // level the samplesheet declares as neither the case nor the control value. Five
                // *different* covariate rows, disjoint from those ten, lose their age, so the two
                // kinds of missingness can be told apart in the regression's sample count.
                //
                // The empty cell is the one spelling that is not just another token: it is the
                // ordinary way a tab-delimited file says "no value", and a reader that splits on
                // arbitrary whitespace collapses it away and sees a ragged row instead of a missing
                // one. It belongs in both files for that reason.
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "missing_values", { rows ->
                    def phenotype = SAMPLESHEET.rewrite(projectDir, outputDir, "missing_values", rows[0].phenotype) { lines ->
                        def spellings = ['NA', '-9', 'nan', 'NaN', 'na', 'not_a_number', '', 'NA', 'NA', 'NA']
                        (0..<lines.size()).collect { index ->
                            if (index < 1 || index > 10) {
                                return lines[index]
                            }
                            def cells = lines[index].split('\t').toList()
                            cells[2] = spellings[index - 1]
                            cells[3] = '9'
                            return cells.join('\t')
                        }
                    }
                    def quant_covariates = SAMPLESHEET.rewrite(projectDir, outputDir, "missing_values", rows[0].quant_covariates) { lines ->
                        (0..<lines.size()).collect { index ->
                            if (index < 21 || index > 25) {
                                return lines[index]
                            }
                            def cells = lines[index].split('\t').toList()
                            cells[2] = ['-9', '-9', '-9', 'NA', ''][index - 21]
                            return cells.join('\t')
                        }
                    }
                    // The two rows that select plink2; the other two would only lengthen the run.
                    rows.removeAll { row -> !(row.analysis_id in ['example_pgen_qt', 'example_pgen_bt']) }
                    rows.each { row ->
                        row.phenotype = phenotype
                        row.quant_covariates = quant_covariates
                    }
                })
                save_normalised_phenotypes = true
            }
        }

        then {
            def qt = new File("${params.outdir}/phenotypes/example_pgen_qt/example_pgen_qt.pheno").readLines()
            def bt = new File("${params.outdir}/phenotypes/example_pgen_bt/example_pgen_bt.pheno").readLines()
            def qcovar = new File("${params.outdir}/phenotypes/example_pgen_qt/example_pgen_qt.qcovar").readLines()
            def linear = new File("${params.outdir}/association/plink2/example_pgen_qt/example_pgen_qt.plink2.glm.linear").readLines()
            def obs_ct = linear.first().split('\t').toList().indexOf('OBS_CT')
            assert workflow.success
            assertAll(
                // Every spelling becomes the literal NA, which is the only missing code PLINK 2,
                // REGENIE, GCTA and LDAK all accept. -9 in particular must not survive: LDAK and
                // REGENIE reject it outright, and PLINK 2 errors out when a -9 shares a file with a
                // value in (-9, 10].
                { assert qt[1..10].collect { line -> line.split('\t')[2] } == ['NA'] * 10 },
                { assert qt[1..-1].every { line -> !(line.split('\t')[2] in ['-9', 'nan', 'NaN', 'na', 'not_a_number']) } },
                // Rows the mutation did not touch keep their value verbatim.
                { assert qt[11].split('\t').toList() == ['HG00155', 'HG00155', '-1.492103'] },
                // A binary level the row declares as neither case nor control is missing, not a third
                // code, and the rest of the recode is untouched by it.
                { assert bt[1..10].collect { line -> line.split('\t')[2] } == ['NA'] * 10 },
                { assert bt[1..-1].collect { line -> line.split('\t')[2] }.countBy { code -> code } == ['0': 342, '1': 148, 'NA': 10] },
                // Covariate missingness is normalised on the same terms, and only the cell that was
                // missing changes: the row's other covariates pass through verbatim.
                { assert qcovar[21..25].collect { line -> line.split('\t')[2] } == ['NA'] * 5 },
                { assert qcovar[21].split('\t').toList() == ['HG00263', 'HG00263', 'NA', '0.027406', '0.048594', '0.013293', '0.066562', '0.001569'] },
                { assert qcovar[26].split('\t')[2] == '67' },
                // PLINK 2 read the NA code as missing rather than as a value or an error: ten samples
                // lost their trait and five others their age, and the regression analysed the other
                // 485. Against the 500 the unmutated run reports, this is the whole missing-value
                // path end to end.
                { assert linear[1].split('\t')[obs_ct] == '485' },
            )
        }
    }

    test("an analysis identifier matching its own input filename leaves that input intact") {

        when {
            params {
                outdir = "$outputDir"
                // Normalisation writes the same extensions it reads, so an analysis unit named after
                // its own phenotype file — `example` beside `example.pheno`, which is exactly how the
                // fixture bundle names things — is the case where an output can land on a staged
                // input. Nextflow stages an input as a symlink and does not guard against that, so a
                // module writing at the task root would rewrite the researcher's own file through the
                // link and report success while doing it.
                //
                // The phenotype here is a private copy, not the shared bundle: if this ever regresses
                // the test must destroy its own file rather than the committed fixtures. The
                // covariates are dropped so that no shared file is exposed either.
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "self_named_analysis", { rows ->
                    rows.removeAll { row -> row.analysis_id != 'example_pgen_qt' }
                    rows[0].phenotype = SAMPLESHEET.rewrite(projectDir, outputDir, "self_named_analysis", rows[0].phenotype) { lines -> lines }
                    rows[0].analysis_id = 'example'
                    rows[0].quant_covariates = ''
                    rows[0].cat_covariates = ''
                })
                save_normalised_phenotypes = true
            }
        }

        then {
            def source = new File(new File(outputDir.toString()).parentFile, 'samplesheets/self_named_analysis/mutated/example.pheno').readLines()
            def normalised = new File("${params.outdir}/phenotypes/example/example.pheno").readLines()
            assert workflow.success
            assertAll(
                // The source file still declares all four of its own columns and still carries its
                // own values, so nothing was written through the staged symlink.
                { assert source.first().split('\t').toList() == ['FID', 'IID', 'QT', 'BT'] },
                { assert source.size() == 501 },
                { assert source[1].split('\t').toList() == ['HG00096', 'HG00096', '0.317843', '1'] },
                // And the normalised file is a real, separate result rather than the source read back.
                { assert normalised.first().split('\t').toList() == ['FID', 'IID', 'PHENO'] },
                { assert normalised[1].split('\t').toList() == ['HG00096', 'HG00096', '0.317843'] },
            )
        }
    }

    test("a phenotype column absent from the phenotype file is refused") {

        when {
            params {
                outdir = "$outputDir"
                // Real fixtures rather than placeholders: the column is checked against the
                // phenotype file's own header, so the file has to have one.
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "unknown_phenotype_column", { rows ->
                    rows[0].phenotype_column = 'NOT_A_COLUMN'
                })
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                // The message names the analysis unit, so a large samplesheet can be fixed without
                // bisecting it, and the column, so the fix is unambiguous.
                { assert report.contains("example_pgen_qt") },
                { assert report.contains("NOT_A_COLUMN") },
                // And it says what the file does declare, so the fix does not require opening it.
                { assert report.contains("'FID', 'IID', 'QT', 'BT'") },
            )
        }
    }

    test("binary declared values with no source matches are refused with an actionable diagnostic") {

        when {
            params {
                outdir = "$outputDir"
                // The declared PLINK-style values remain 1 (control) and 2 (case), but the private
                // fixture copy contains only a third raw value in BT. Both declarations must be
                // rejected by normalisation before PLINK 2 can mistake the all-NA output for a
                // constant canonical PHENO column.
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "unmatched_binary_case_control_values", { rows ->
                    def phenotype = SAMPLESHEET.rewrite(projectDir, outputDir, "unmatched_binary_case_control_values", rows[1].phenotype) { lines ->
                        (0..<lines.size()).collect { index ->
                            if (index == 0) {
                                return lines[index]
                            }
                            def cells = lines[index].split('\t').toList()
                            cells[3] = 'unmatched'
                            return cells.join('\t')
                        }
                    }
                    rows.removeAll { row -> row.analysis_id != 'example_pgen_bt' }
                    rows[0].phenotype = phenotype
                })
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                // The error is attributed to the researcher's analysis and source column, not to
                // PLINK 2's canonical PHENO output name.
                { assert report.contains("example_pgen_bt") },
                { assert report.contains("BT") },
                // Both declared encodings failed to match a raw source cell.
                { assert report.contains("case_value '2' matched 0") },
                { assert report.contains("control_value '1' matched 0") },
                // The raw value and count make the declaration/data mismatch fixable without opening
                // the phenotype file.
                { assert report.contains("'unmatched' (500 samples)") },
            )
        }
    }

    test("a binary case declaration absent from the source data is refused with an actionable diagnostic") {

        when {
            params {
                outdir = "$outputDir"
                // Preserve the 350 declared controls, but rewrite every one of the 150 declared
                // cases to a third value. The source data is then informative enough to say which
                // declaration failed, instead of the all-levels-absent case above.
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "unmatched_binary_case_value", { rows ->
                    def phenotype = SAMPLESHEET.rewrite(projectDir, outputDir, "unmatched_binary_case_value", rows[1].phenotype) { lines ->
                        [lines.first()] + lines.tail().collect { line ->
                            def cells = line.split('\t').toList()
                            cells[3] = cells[3] == '2' ? 'unmatched_case' : cells[3]
                            return cells.join('\t')
                        }
                    }
                    rows.removeAll { row -> row.analysis_id != 'example_pgen_bt' }
                    rows[0].phenotype = phenotype
                })
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                // The diagnostic identifies the analysis and the researcher-facing source column.
                { assert report.contains('example_pgen_bt') },
                { assert report.contains("column 'BT'") },
                // Both declarations are printed, along with their independently measured matches.
                { assert report.contains("case_value '2'") },
                { assert report.contains("control_value '1'") },
                { assert report.contains("case_value '2' matched 0") },
                { assert report.contains("control_value '1' matched 350") },
                // The third raw value is tallied, so its spelling and prevalence can be corrected.
                { assert report.contains("'unmatched_case' (150 samples)") },
            )
        }
    }

    test("a quantitative source with no numeric values is refused with an actionable diagnostic") {

        when {
            params {
                outdir = "$outputDir"
                // Every selected QT value is deliberately non-numeric. The generated source still
                // has a valid header and 500 samples, so normalisation reaches its semantic check.
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "unparseable_quantitative_values", { rows ->
                    def phenotype = SAMPLESHEET.rewrite(projectDir, outputDir, "unparseable_quantitative_values", rows[0].phenotype) { lines ->
                        [lines.first()] + lines.tail().collect { line ->
                            def cells = line.split('\t').toList()
                            cells[2] = 'not_a_number'
                            return cells.join('\t')
                        }
                    }
                    rows.removeAll { row -> row.analysis_id != 'example_pgen_qt' }
                    rows[0].phenotype = phenotype
                })
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                // The error stays attached to the analysis and original quantitative source column.
                { assert report.contains('example_pgen_qt') },
                { assert report.contains("column 'QT'") },
                { assert report.contains('matched 0 numeric values') },
                // The raw spelling and whole-source count make the otherwise non-parseable input actionable.
                { assert report.contains("'not_a_number' (500 samples)") },
            )
        }
    }

    test("unmatched binary raw values normalise to NA with a bounded deterministic diagnostic") {

        when {
            params {
                outdir = "$outputDir"
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "bounded_unmatched_binary_values", { rows ->
                    def phenotype = SAMPLESHEET.rewrite(projectDir, outputDir, "bounded_unmatched_binary_values", rows[1].phenotype) { lines ->
                        def rewritten_controls = 0
                        (0..<lines.size()).collect { index ->
                            if (index == 0) {
                                return lines[index]
                            }
                            def cells = lines[index].split('\t').toList()
                            // Eleven distinct control values leave all 150 cases represented, and
                            // exercise both the ten-value cap and lexical tie-break for equal counts.
                            if (cells[3] == '1' && rewritten_controls < 11) {
                                rewritten_controls += 1
                                cells[3] = String.format('stray_%02d', rewritten_controls)
                            }
                            return cells.join('\t')
                        }
                    }
                    rows.removeAll { row -> row.analysis_id != 'example_pgen_bt' }
                    rows[0].phenotype = phenotype
                })
            }
        }

        then {
            def phenotype = new File(work_files(outputDir).find { entry -> entry.name == 'example_pgen_bt.pheno' }.absolutePath).readLines()
            def codes = phenotype[1..-1].collect { line -> line.split('\t')[2] }.countBy { code -> code }
            def normalise_log = work_files(outputDir).find { entry -> entry.name == 'example_pgen_bt.normalise.log' }.text
            def displayed = (1..10).collect { index -> "'stray_${String.format('%02d', index)}' (1 samples)" }
            def expected_diagnostic = "unmatched raw values: ${displayed.join(', ')}; 1 further distinct unmatched raw values omitted"
            assertAll(
                { assert workflow.success },
                // The otherwise valid binary trait runs through PLINK 2, and all 11 undeclared
                // values take the one canonical missing code rather than becoming a third phenotype.
                { assert codes == ['0': 339, '1': 150, 'NA': 11] },
                // Equal counts sort lexically after the descending-count primary key. Only ten raw
                // spellings are shown; the eleventh is represented by the precise elision suffix.
                { assert normalise_log.contains(expected_diagnostic) },
                { assert !normalise_log.contains("'stray_11'") },
            )
        }
    }
}

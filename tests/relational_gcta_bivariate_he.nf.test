nextflow_pipeline {

    name "Test GCTA bivariate Haseman-Elston relationship routes"
    script "../main.nf"
    tag "pipeline"
    tag "relational"
    tag "heritability"
    tag "genetic_correlation"
    tag "gcta"
    tag "gcta_bivariate_he"

    // Both HEreg selectors are quantitative-only, and GCTA 1.94.1 `--HEreg-bivar` reads no covariate file,
    // so every valid case here declares two quantitative endpoints and no pair covariates. The shipped
    // fixture carries one quantitative and one binary trait, so the second quantitative endpoint reads the
    // binary column as a quantitative variable rather than inventing a phenotype file.
    def quantitativePair = { projectDir, outputDir, name, methods, pairOptions = [:], mutateRelationships = null ->
        def analyses = RELATIONAL.analyses(projectDir, outputDir, name, { rows ->
            def second = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
            second.analysis_id = 'example_pgen_qt2'
            second.trait_id = 'QT2'
            second.trait_type = 'quantitative'
            second.control_value = ''
            second.case_value = ''
            rows << second
            rows.each { row ->
                row.association_methods = ''
                row.heritability_methods = ''
            }
        })
        def relationships = RELATIONAL.relationships(projectDir, outputDir, name, { rows ->
            rows[0].relationship_id = 'qt_qt2'
            rows[0].right_analysis_id = 'example_pgen_qt2'
            rows[0].relationship_methods = methods
            rows[0].pair_quant_covariates = ''
            rows[0].pair_cat_covariates = ''
            if (mutateRelationships) {
                mutateRelationships(rows)
            }
        })
        return [
            cohort: RELATIONAL.cohorts(projectDir, outputDir, name),
            analyses: analyses,
            relationships: relationships,
            options: RELATIONAL.methodOptions(outputDir, name, [analyses: [:], pair_requests: pairOptions]),
        ]
    }

    def workFiles = { outputDir ->
        def files = []
        new File(new File(outputDir.toString()).parentFile, 'work').eachFileRecurse { entry ->
            if (entry.isFile()) {
                files << entry
            }
        }
        return files
    }

    // Selecting HEreg beside REML for one relationship must construct each required matrix once. That is a
    // scheduling and identity property of the reuse key, so it is asserted under `-stub`: the matrix
    // construction, the two estimators and the normalizer all still run, while the numerical behaviour of a
    // 200-sample bivariate likelihood stays out of a test about task counts. The real HEreg numbers are
    // asserted separately below.
    test("selecting dense HEreg beside dense REML constructs the shared GRM exactly once") {
        options "-stub"

        when {
            def inputs = quantitativePair(
                projectDir,
                outputDir,
                'gcta_bivariate_he_shared_dense',
                'gcta_bivariate_reml,gcta_bivariate_he',
            )
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = inputs.options
                gcta_grm_parts = 1
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // The reuse key is derived from the cohort, the genotype bundle and the declared matrix
                // settings only, never from the method token, so two estimators cost one construction.
                { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') == 1 },
                { assert TRACE.count(workflow, 'CUSTOM_GCTAMERGEGRMPARTS') == 1 },
                // Both estimators address that one matrix by the same staged basename.
                { assert TRACE.tags(workflow, 'GCTA_BIVARIATEREML') == TRACE.tags(workflow, 'GCTA_BIVARIATEHEREG') },
                // The shared two-trait table is built once for the relationship, then fanned out per method.
                { assert TRACE.count(workflow, 'PREPARE_BIVARIATE_TRAITS') == 1 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEREML') == 1 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEHEREG') == 1 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEHEREGLDMS') == 0 },
                { assert TRACE.count(workflow, 'NORMALISE_GCTA_BIVARIATE') == 2 },
                // Each estimator keeps its own request identity and published request directory.
                { assert new File("${params.outdir}/requests/gcta_bivariate_he/gcta_bivariate_he--qt_qt2/native.HEreg").isFile() },
                { assert new File("${params.outdir}/requests/gcta_bivariate_reml/gcta_bivariate_reml--qt_qt2/native.hsq").isFile() },
            )
        }
    }

    test("selecting LDMS HEreg beside LDMS REML constructs the shared matrix family exactly once") {
        options "-stub"

        when {
            def ldmsOptions = [
                ld_score_region_kb: 50,
                ld_bins: 2,
                ldms_maf_edges: [0, 0.5],
            ]
            def inputs = quantitativePair(
                projectDir,
                outputDir,
                'gcta_bivariate_he_shared_ldms',
                'gcta_bivariate_reml_ldms,gcta_bivariate_he_ldms',
                [
                    'gcta_bivariate_reml_ldms--qt_qt2': ldmsOptions,
                    'gcta_bivariate_he_ldms--qt_qt2': ldmsOptions,
                ],
            )
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = inputs.options
                gcta_grm_parts = 1
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Two estimators declaring the same component plan share one MGRM family.
                { assert TRACE.count(workflow, 'CUSTOM_GCTACREATEMGRMMANIFEST') == 1 },
                { assert TRACE.tags(workflow, 'GCTA_BIVARIATEREMLLDMS') == TRACE.tags(workflow, 'GCTA_BIVARIATEHEREGLDMS') },
                { assert TRACE.count(workflow, 'PREPARE_BIVARIATE_TRAITS') == 1 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEREMLLDMS') == 1 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEHEREGLDMS') == 1 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEHEREG') == 0 },
                { assert new File("${params.outdir}/requests/gcta_bivariate_he_ldms/gcta_bivariate_he_ldms--qt_qt2/native.HEreg").isFile() },
                { assert new File("${params.outdir}/requests/gcta_bivariate_reml_ldms/gcta_bivariate_reml_ldms--qt_qt2/native.hsq").isFile() },
            )
        }
    }

    test("dense HEreg publishes native moment estimands, its standardised covariance scale and its diagnostics") {
        when {
            def inputs = quantitativePair(projectDir, outputDir, 'gcta_bivariate_he_dense', 'gcta_bivariate_he')
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = inputs.options
                gcta_grm_parts = 1
            }
        }

        then {
            def heRequest = new File("${params.outdir}/requests/gcta_bivariate_he/gcta_bivariate_he--qt_qt2")
            def heProvenance = new groovy.json.JsonSlurper().parse(new File(heRequest, 'provenance.json'))
            def correlation = new File("${params.outdir}/genetic_correlation/gcta_bivariate_he/gcta_bivariate_he--qt_qt2/genetic_correlation.tsv")
            def covariance = new File("${params.outdir}/genetic_covariance/gcta_bivariate_he/gcta_bivariate_he--qt_qt2/genetic_covariance.tsv")
            def heritability = new File("${params.outdir}/heritability/gcta_bivariate_he/gcta_bivariate_he--qt_qt2/heritability.tsv")
            def nativeCommand = workFiles(outputDir).find { entry ->
                entry.name == '.command.sh' && entry.text.contains('--HEreg-bivar 1 2')
            }
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') == 1 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEHEREG') == 1 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEREML') == 0 },
                { assert heProvenance.matrix.kind == 'gcta_dense' },
                { assert heProvenance.matrix.basename != heProvenance.request_id },
                { assert new File(heRequest, 'native.HEreg').isFile() },
                { assert new File(heRequest, 'native.log').isFile() },
                { assert heRequest.list().sort() == ['diagnostics.tsv', 'native.HEreg', 'native.log', 'provenance.json'] },
                { assert heritability.readLines().size() == 3 },
                { assert correlation.readLines().size() == 2 },
                { assert covariance.readLines().size() == 2 },
                { assert heritability.readLines().tail().every { line -> line.split('\t')[-3] != 'NA' } },
                { assert correlation.readLines().tail().every { line -> line.split('\t')[-3] != 'NA' } },
                // Single-component output carries no `component` column, matching the dense REML view.
                { assert !heritability.readLines().first().split('\t').contains('component') },
                // HEreg standardises both phenotypes, so its covariance is on the standardised scale and is
                // labelled as such rather than borrowing REML's observed-scale label.
                { assert covariance.readLines()[1].split('\t')[-4] == 'observed_standardised' },
                // Declared orientation survives into presentation and is load-bearing for this estimator.
                { assert heProvenance.orientation.left.analysis_id == 'example_pgen_qt' },
                { assert heProvenance.orientation.right.analysis_id == 'example_pgen_qt2' },
                { assert heritability.readLines()[1..2].collect { line -> line.split('\t')[4] } == ['example_pgen_qt', 'example_pgen_qt2'] },
                // A moment estimator has no residual-covariance parameter and no covariate seam at all.
                { assert heProvenance.diagnostics.residual_covariance_status == 'no_residual_covariance_parameter' },
                { assert heProvenance.diagnostics.covariate_adjustment == 'not_supported_by_method' },
                { assert heProvenance.diagnostics.standard_error_basis == 'jackknife' },
                { assert heProvenance.diagnostics.native_estimator == 'haseman_elston_cross_product' },
                { assert heProvenance.diagnostics.native_cross_product_orientation == 'left_trait_row_right_trait_column' },
                { assert heProvenance.diagnostics.jackknife_sampling_covariance == 'available' },
                { assert heProvenance.native_sampling_covariance.parameter_order == ['G_tr1', 'G_tr2', 'G_tr12'] },
                { assert heProvenance.native_sampling_covariance.matrix.size() == 3 },
                { assert heProvenance.effective_prevalence == [] },
                { assert heProvenance.tool.version == '1.94.1' },
                // The wrapper owns the invocation: no covariate flag and no prevalence flag is emitted.
                { assert nativeCommand != null },
                { assert !nativeCommand.text.contains('--qcovar') },
                { assert !nativeCommand.text.contains('--covar') },
                { assert !nativeCommand.text.contains('--prevalence') },
                { assert snapshot(removeNextflowVersion("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")).match('versions') },
            )
        }
    }

    test("a one-stratum LDMS component plan publishes GCTA's one-component layout as the total") {
        when {
            // One LD stratum and one MAF stratum: GCTA has nothing to sum, so it writes the one-component
            // layout with no `Sum of ...` rows and no `Total rG`, and that single component is the
            // genome-wide total.
            def inputs = quantitativePair(
                projectDir,
                outputDir,
                'gcta_bivariate_he_ldms_single',
                'gcta_bivariate_he_ldms',
                [
                    'gcta_bivariate_he_ldms--qt_qt2': [
                        ld_score_region_kb: 50,
                        ld_bins: 1,
                        ldms_maf_edges: [0, 0.5],
                    ],
                ],
            )
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = inputs.options
                gcta_grm_parts = 1
            }
        }

        then {
            def heRequest = new File("${params.outdir}/requests/gcta_bivariate_he_ldms/gcta_bivariate_he_ldms--qt_qt2")
            def heProvenance = new groovy.json.JsonSlurper().parse(new File(heRequest, 'provenance.json'))
            def correlation = new File("${params.outdir}/genetic_correlation/gcta_bivariate_he_ldms/gcta_bivariate_he_ldms--qt_qt2/genetic_correlation.tsv").readLines()
            assertAll(
                { assert workflow.success },
                { assert heProvenance.matrix.kind == 'gcta_ldms' },
                { assert !new File(heRequest, 'native.HEreg').text.contains('Total rG') },
                { assert heProvenance.diagnostics.native_component_layout == 'single_component' },
                { assert heProvenance.diagnostics.primary_result_component == 'total' },
                { assert heProvenance.genetic_components == ['total'] },
                { assert correlation.size() == 2 },
                { assert correlation[1].split('\t')[3] == 'total' },
                { assert correlation[1].split('\t')[-3] != 'NA' },
            )
        }
    }


    test("multi-component LDMS HEreg publishes a native total alongside its per-component rows") {
        when {
            // Two LD-score strata: the bins are quantile defined, so both are non-empty by construction and
            // GCTA writes the multi-component layout with its own `Sum of ...` totals and `Total rG`.
            def inputs = quantitativePair(
                projectDir,
                outputDir,
                'gcta_bivariate_he_ldms_components',
                'gcta_bivariate_he_ldms',
                [
                    'gcta_bivariate_he_ldms--qt_qt2': [
                        ld_score_region_kb: 50,
                        ld_bins: 2,
                        ldms_maf_edges: [0, 0.5],
                    ],
                ],
            )
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = inputs.options
                gcta_grm_parts = 1
            }
        }

        then {
            def heRequest = new File("${params.outdir}/requests/gcta_bivariate_he_ldms/gcta_bivariate_he_ldms--qt_qt2")
            def heProvenance = new groovy.json.JsonSlurper().parse(new File(heRequest, 'provenance.json'))
            def correlation = new File("${params.outdir}/genetic_correlation/gcta_bivariate_he_ldms/gcta_bivariate_he_ldms--qt_qt2/genetic_correlation.tsv").readLines()
            def covariance = new File("${params.outdir}/genetic_covariance/gcta_bivariate_he_ldms/gcta_bivariate_he_ldms--qt_qt2/genetic_covariance.tsv").readLines()
            def heritability = new File("${params.outdir}/heritability/gcta_bivariate_he_ldms/gcta_bivariate_he_ldms--qt_qt2/heritability.tsv").readLines()
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEHEREGLDMS') == 1 },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEREMLLDMS') == 0 },
                { assert new File(heRequest, 'native.HEreg').isFile() },
                { assert new File(heRequest, 'native.HEreg').text.contains('Total rG') },
                // The primary published result is the native genome-wide total; the per-component rows stay
                // as secondary diagnostics of the same fit.
                { assert heProvenance.diagnostics.native_component_layout == 'multi_component' },
                { assert heProvenance.diagnostics.primary_result_component == 'total' },
                { assert heProvenance.diagnostics.total_result_origin == 'native' },
                { assert heProvenance.genetic_components == ['total', 'G1', 'G2'] },
                { assert correlation.first().split('\t').contains('component') },
                { assert correlation.tail().collect { line -> line.split('\t')[3] } == ['total', 'G1', 'G2'] },
                { assert covariance.tail().collect { line -> line.split('\t')[3] } == ['total', 'G1', 'G2'] },
                { assert heritability.tail().collect { line -> line.split('\t')[3] } == ['total', 'total', 'G1', 'G1', 'G2', 'G2'] },
                // Whatever the total's uncertainty turns out to be, it comes from GCTA's own `Total rG` row.
                // Two hundred samples split across two LD strata is far too little for the moment estimator
                // to resolve every jackknife standard error, so the classification is asserted rather than
                // assumed: a nonfinite primary uncertainty must be reported, never filled in from the
                // marginal component standard errors. The finite-uncertainty case is covered by the module
                // test in `modules/local/gcta/bivariateheregldms/tests`.
                { assert correlation[1].split('\t')[-3] != 'NA' },
                { assert correlation[1].split('\t')[-1] in ['estimable', 'estimable_with_warning', 'completed_nonestimable'] },
                { assert covariance[1].split('\t')[-3] != 'NA' },
                // The complete sampling covariance matrix GCTA writes only to the log is retained.
                { assert heProvenance.native_sampling_covariance.parameter_order == ['G1_tr1', 'G1_tr2', 'G1_tr12', 'G2_tr1', 'G2_tr2', 'G2_tr12'] },
                { assert heProvenance.native_sampling_covariance.matrix.size() == 6 },
            )
        }
    }

    test("HEreg relationship routes preserve topology under stub execution") {
        options "-stub"

        when {
            def inputs = quantitativePair(projectDir, outputDir, 'gcta_bivariate_he_stub', 'gcta_bivariate_he')
            params {
                outdir = "$outputDir"
                cohort_manifest = inputs.cohort
                analysis_manifest = inputs.analyses
                relationship_manifest = inputs.relationships
                method_options = inputs.options
                gcta_grm_parts = 1
            }
        }

        then {
            def request = new File("${params.outdir}/requests/gcta_bivariate_he/gcta_bivariate_he--qt_qt2")
            def provenance = new groovy.json.JsonSlurper().parse(new File(request, 'provenance.json'))
            assertAll(
                { assert workflow.success },
                { assert TRACE.count(workflow, 'GCTA_BIVARIATEHEREG') == 1 },
                { assert TRACE.count(workflow, 'NORMALISE_GCTA_BIVARIATE') == 1 },
                { assert new File(request, 'native.HEreg').isFile() },
                { assert provenance.stub == true },
            )
        }
    }

    def rejectedRequests = [
        [
            name: 'a binary endpoint',
            binaryPair: true,
            expected: 'support two quantitative endpoints only',
        ],
        [
            name: 'declared pair covariates',
            mutateRelationships: { rows -> rows[0].pair_quant_covariates = "${FIXTURES.UPSTREAM}results/fixtures/pheno_cov/example.qcovar" },
            expected: 'have no native covariate parameter',
        ],
        [
            name: 'a wrapper-owned native operation',
            pairOptions: ['gcta_bivariate_he--qt_qt2': [native_args: ['--HEreg-bivar', '1', '3']]],
            expected: 'conflicts with wrapper-owned invocation mechanics',
        ],
    ]

    rejectedRequests.each { scenario ->
        test("HEreg validation rejects ${scenario.name} before task submission") {
            when {
                def name = "gcta_bivariate_he_reject_${scenario.name.replace(' ', '_')}"
                def analyses = RELATIONAL.analyses(projectDir, outputDir, name, { rows ->
                    def second = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                    if (!scenario.binaryPair) {
                        second.analysis_id = 'example_pgen_qt2'
                        second.trait_id = 'QT2'
                        second.trait_type = 'quantitative'
                        second.control_value = ''
                        second.case_value = ''
                    }
                    else {
                        second.population_prevalence = 0.1
                    }
                    rows << second
                    rows.each { row ->
                        row.association_methods = ''
                        row.heritability_methods = ''
                    }
                })
                def relationships = RELATIONAL.relationships(projectDir, outputDir, name, { rows ->
                    rows[0].relationship_id = scenario.binaryPair ? 'qt_bt' : 'qt_qt2'
                    rows[0].right_analysis_id = scenario.binaryPair ? 'example_pgen_bt' : 'example_pgen_qt2'
                    rows[0].relationship_methods = 'gcta_bivariate_he'
                    rows[0].pair_quant_covariates = ''
                    rows[0].pair_cat_covariates = ''
                    if (scenario.mutateRelationships) {
                        scenario.mutateRelationships(rows)
                    }
                })
                params {
                    outdir = "$outputDir"
                    cohort_manifest = RELATIONAL.cohorts(projectDir, outputDir, name)
                    analysis_manifest = analyses
                    relationship_manifest = relationships
                    method_options = RELATIONAL.methodOptions(outputDir, name, [analyses: [:], pair_requests: scenario.pairOptions ?: [:]])
                    gcta_grm_parts = 1
                }
            }

            then {
                def report = VALIDATION.report(outputDir, workflow.stdout)
                assertAll(
                    { assert !workflow.success },
                    { assert report.contains(scenario.expected) },
                    { assert TRACE.count(workflow, 'GCTA_MAKEGRMPART') == 0 },
                    { assert TRACE.count(workflow, 'GCTA_BIVARIATEHEREG') == 0 },
                )
            }
        }
    }
}

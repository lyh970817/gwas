nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // The samplesheet is built from the shipped demo sheet with its file columns resolved against the
    // fixture bundle, so no machine-specific path is committed while the release fixtures are still
    // unmerged upstream. `conf/test.config` carries the committed fixture URL and is exercised by
    // running `-profile test` directly.
    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "default", null)
            }
        }

        then {
            def versions = new File("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")
            def stable_name_association = getAllFilesFromDir("${params.outdir}/association", relative: true, includeDir: true).findAll { path -> path.toString() }
            def stable_path_association = getAllFilesFromDir("${params.outdir}/association", ignoreFile: 'tests/.nftignore')
            def stable_name_heritability = getAllFilesFromDir("${params.outdir}/heritability", relative: true, includeDir: true).findAll { path -> path.toString() }
            def stable_path_heritability = getAllFilesFromDir("${params.outdir}/heritability", ignoreFile: 'tests/.nftignore')
            def stable_name_summary_statistics = getAllFilesFromDir("${params.outdir}/summary_statistics", relative: true, includeDir: true).findAll { path -> path.toString() }
            def stable_path_summary_statistics = getAllFilesFromDir("${params.outdir}/summary_statistics", ignoreFile: 'tests/.nftignore')
            def stable_name_multiqc = getAllFilesFromDir("${params.outdir}/multiqc", relative: true, includeDir: true).findAll { path -> path.toString() }
            def stable_path_multiqc = getAllFilesFromDir(
                "${params.outdir}/multiqc",
                ignore: [
                    'multiqc_data/llms-full.txt',
                    'multiqc_data/multiqc.log',
                    'multiqc_data/multiqc.parquet',
                    'multiqc_data/multiqc_data.json',
                    'multiqc_data/multiqc_software_versions.txt',
                    'multiqc_data/multiqc_sources.txt',
                    'multiqc_report.html',
                ],
            )
            def stable_name_pipeline_info = getAllFilesFromDir(
                "${params.outdir}/pipeline_info",
                relative: true,
                includeDir: true,
                ignore: ['*.{html,json,txt}'],
            ).findAll { path -> path.toString() }
            def stable_path_pipeline_info = []
            assert workflow.success
            assertAll(
                // The four demo rows cover PLINK 2, GCTA fastGWA and LDAK-KVIK association plus
                // GCTA GREML, GCTA GREML-LDMS and LDAK-REML heritability. Native association and
                // heritability results and harmonised summary statistics are published alongside
                // pipeline information and a MultiQC report. Cohort genotype preparation, phenotype
                // normalisation and relatedness matrices remain unpublished intermediates unless a
                // save control requests them, so these five top-level areas are the complete layout.
                { assert new File("${params.outdir}").list().toList().sort() == ['association', 'heritability', 'multiqc', 'pipeline_info', 'summary_statistics'] },
                { assert snapshot(removeNextflowVersion(versions.toString())).match('versions') },
                { assert snapshot(stable_name_association, stable_path_association).match('association') },
                { assert snapshot(stable_name_heritability, stable_path_heritability).match('heritability') },
                { assert snapshot(stable_name_summary_statistics, stable_path_summary_statistics).match('summary_statistics') },
                { assert snapshot(stable_name_multiqc, stable_path_multiqc).match('multiqc') },
                { assert snapshot(stable_name_pipeline_info, stable_path_pipeline_info).match('pipeline_info') },
            )
        }
    }
}

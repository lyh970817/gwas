nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // The samplesheet is built from the shipped demo sheet with its file columns resolved against the
    // fixture bundle, so no machine-specific path is committed while the release fixtures are still
    // unmerged upstream. `conf/test.config` carries the committed fixture URL and is exercised by
    // running `-profile test` directly.
    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "default", null)
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                // Cohort genotype preparation is an intermediate and the association and heritability
                // routes are wired by later tickets, so a valid run at this point legitimately
                // publishes nothing but pipeline information and a MultiQC report.
                { assert new File("${params.outdir}").list().toList().sort() == ['multiqc', 'pipeline_info'] },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_gwas_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }
}

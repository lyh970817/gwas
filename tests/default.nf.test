nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // The samplesheet is built from the shipped demo sheet with its file columns resolved against the
    // fixture bundle, so no machine-specific path is committed while the release fixtures are still
    // unmerged upstream. `conf/test.config` carries the committed fixture URL and is exercised by
    // running `-profile test` directly.
    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "default", null)
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                // Two of the four demo rows select plink2, so a valid run publishes its association
                // results alongside pipeline information and a MultiQC report. Cohort genotype
                // preparation and phenotype normalisation are intermediates and stay unpublished
                // unless a save control asks for them, and the remaining routes are wired by later
                // tickets, so those three are the whole published layout at this point.
                { assert new File("${params.outdir}").list().toList().sort() == ['association', 'multiqc', 'pipeline_info'] },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_gwas_software_mqc_versions.yml"),
                    // All stable path names, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }
}

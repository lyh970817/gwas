nextflow_pipeline {

    name "Test mandatory 35-column samplesheet header"
    script "../main.nf"
    tag "pipeline"
    tag "validation"

    test("the superseded 31-column contract names all four missing headers") {

        when {
            params {
                outdir = "$outputDir"
                input = SAMPLESHEET.withoutColumns(
                    projectDir,
                    outputDir,
                    "legacy_31_columns",
                    ['gcta_ld_score_region_kb', 'gcta_ld_bins', 'gcta_sparse_cutoff', 'ldak_weights'],
                    null,
                )
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            def header = SAMPLESHEET.demo(projectDir).header
            assertAll(
                { assert !workflow.success },
                { assert report.contains("35-column input contract") },
                { assert report.contains("missing column headers") },
                { assert report.contains("'gcta_ld_score_region_kb'") },
                { assert report.contains("'gcta_ld_bins'") },
                { assert report.contains("'gcta_sparse_cutoff'") },
                { assert report.contains("'ldak_weights'") },
                { assert header.size() == 35 },
                { assert header[24..34] == [
                    'ldak_model',
                    'ldak_power',
                    'ldak_weights',
                    'ldak_relatedness_filter',
                    'ldak_kvik_step1_subset',
                    'ldak_kvik_step1_extract',
                    'gcta_grm_parts',
                    'gcta_sparse_cutoff',
                    'gcta_ld_score_region_kb',
                    'gcta_ld_bins',
                    'gcta_ldms_maf_edges',
                ] },
            )
        }
    }

    test("the complete 35-column contract is accepted and reports software versions") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input = SAMPLESHEET.fixtures(projectDir, outputDir, "complete_35_columns", { rows ->
                    rows.retainAll { row -> row.analysis_id == 'example_pgen_qt' }
                    rows[0].association_methods = 'plink2'
                    rows[0].heritability_methods = ''
                    rows[0].gcta_grm_parts = ''
                })
            }
        }

        then {
            def versions = new File("${params.outdir}/pipeline_info/nf_core_gwas_software_mqc_versions.yml")
            assertAll(
                { assert workflow.success },
                { assert SAMPLESHEET.demo(projectDir).header.size() == 35 },
                { assert snapshot(removeNextflowVersion(versions.toString())).match('versions') },
            )
        }
    }
}

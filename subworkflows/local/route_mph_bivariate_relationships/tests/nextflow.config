process {
    // The pipeline's own blocks for these two processes are qualified by this controller's name and therefore
    // do match this scope: nf-test loads the root `nextflow.config` for every test and the fully qualified
    // process name here begins with `ROUTE_MPH_BIVARIATE_RELATIONSHIPS:`. Their publication closures would
    // evaluate an unset `params.outdir` into a literal `null/` tree beside the test. Publication is pipeline
    // policy rather than this composition's contract, so it is suppressed here; the real-mode pipeline route
    // test is where the published layout is asserted.
    withName: 'MPH_REML|SUMMARISE_MPH_RESULT' {
        publishDir = []
    }
}

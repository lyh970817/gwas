// Copy this selector into the calling pipeline configuration.
// Quantitative exporter requests require --qt; binary exporter requests omit it.
// Native optional settings such as --pc are caller choices and use ext.args.
// For heterogeneous requests, resolve those choices by the preserved meta.id.
process {
    withName: '.*:COMMON_VARIANT_META_ANALYSIS:MRMEGA' {
        ext.args = ''
    }
}

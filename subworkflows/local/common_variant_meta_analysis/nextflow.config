// Copy this selector into the calling pipeline configuration.
// The exporter trait_type and native MR-MEGA mode must agree:
// quantitative requests require --qt; binary requests omit it.
// Native optional settings such as --pc are caller choices and use ext.args.
// A heterogeneous request channel can use the standard, preserved meta.id:
// params.mrmega_args_by_id = [trait_a: '--pc 1 --qt', trait_b: '--pc 1']
// process {
//     withName: '.*:COMMON_VARIANT_META_ANALYSIS:MRMEGA' {
//         ext.args = { params.mrmega_args_by_id[meta.id] }
//     }
// }
// Pass trait_a with trait_type 'quantitative' and trait_b with 'binary'.

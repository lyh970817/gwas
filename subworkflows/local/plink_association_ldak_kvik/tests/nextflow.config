params.kvik_fit_args = '--mpheno 1 --random-seed 7'
params.kvik_test_args = '--mpheno 1 --random-seed 7'
process {
    withName: LDAK_KVIKSTEP1 {
        ext.args = params.kvik_fit_args
        ext.prefix = { meta.id }
    }
    withName: LDAK_KVIKSTEP2 {
        ext.args = params.kvik_test_args
    }
    withName: LDAK_THINCOMMON {
        ext.prefix = { meta.id }
    }
}

nextflow_workflow {
    name "Test PLINK_FIT_REGENIE"
    script "../main.nf"
    workflow "PLINK_FIT_REGENIE"
    config "./nextflow.config"
    tag "subworkflows"
    tag "plink_fit_regenie"
    tag "regenie"

    test("homo_sapiens popgen - standard fitting") {
        when {
            workflow {
                """
                def meta = [id: 'fit', single_end: false]
                def base = params.modules_testdata_base_path + 'genomics/homo_sapiens/popgen/'
                input[0] = channel.of([meta, file(base + 'plink_simulated.bed', checkIfExists: true), file(base + 'plink_simulated.bim', checkIfExists: true), file(base + 'plink_simulated.fam', checkIfExists: true)])
                input[1] = channel.of([meta, file(base + 'plink_simulated_quantitative_phenoname.phe', checkIfExists: true)])
                input[2] = channel.of([meta, file(base + 'plink_simulated_covariates.txt', checkIfExists: true)])
                input[3] = channel.of([meta, 1000])
                input[4] = channel.of([meta, 'standard'])
                input[5] = channel.of([meta, []])
                """
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.predictions*.getAt(0) == [[id: 'fit', single_end: false]] },
                { assert workflow.out.loco*.getAt(0) == [[id: 'fit', single_end: false]] },
                { assert workflow.out.logs.size() == 1 },
                {
                    def predictionList = path(workflow.out.predictions[0][1])
                    def companions = workflow.out.loco[0][1]
                    companions = companions instanceof List ? companions : [companions]
                    assert predictionList.exists()
                    assert companions.every { path(it).exists() }
                    assert predictionList.text.readLines().findAll { it }.size() == 1
                },
                {
                    // Native prediction lists contain task paths; snapshot the public names and identities.
                    assert snapshot(
                        workflow.out.predictions.collect { [it[0], path(it[1]).name] },
                        workflow.out.loco.collect { row -> [row[0], (row[1] instanceof List ? row[1] : [row[1]]).collect { path(it).name }.sort()] },
                        workflow.out.logs.collect { [it[0], path(it[1]).name] }.sort { it[1] }
                    ).match()
                }
            )
        }
    }


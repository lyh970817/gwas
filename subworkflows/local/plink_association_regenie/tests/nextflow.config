params {
    fit_args = '--phenoColList QuantitativeTrait --use-relative-path'
    test_args = '--phenoColList QuantitativeTrait'
}

process {
    withName: 'REGENIE_STEP1|REGENIE_SPLITL0|REGENIE_RUNL0|REGENIE_RUNL1' {
        ext.args = { params.fit_args }
        ext.prefix = { "${meta.id}.fit" }
    }
    withName: REGENIE_STEP2 {
        ext.args = { params.test_args }
        ext.prefix = { "${meta.id}.${plink_genotype_file.baseName}" }
    }
}

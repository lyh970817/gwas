nextflow_function {

    name "Test linked GWAS input contract functions"
    script "../method_options.nf"
    tag "function"
    tag "input"

    test("method option defaults have one canonical resolved shape") {
        function "getMethodOptionDefaults"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.gcta == [
                    grm_maf: null,
                    grm_extract: [],
                    reml_no_constrain: false,
                    sparse_cutoff: 0.05,
                    ld_score_region_kb: 200,
                    ld_bins: 4,
                    ldms_maf_edges: [0, 0.01, 0.05, 0.2, 0.5],
                ] },
                { assert function.result.genie == [
                    random_vectors: null,
                    jackknife_blocks: null,
                    seed: null,
                    memory_efficient: false,
                    annotation: [],
                ] },
                { assert function.result.ldak == [
                    model: 'human_default',
                    power: -0.25,
                    weights_policy: 'equal',
                    weights: [],
                    relatedness_filter: false,
                    kvik_step1_subset: 'all',
                    predictor_extract: [],
                    kvik_step2_keep: [],
                    fast_repetitions: null,
                    fast_num_blocks: null,
                    fast_seed: null,
                ] },
                { assert function.result.mph == [
                    iterations: null,
                    tolerance: null,
                    random_vectors: null,
                    seed: null,
                    save_memory: false,
                ] },
                { assert function.result.regenie == [
                    step1_bsize: 1000,
                    firth: true,
                    firth_approx: true,
                    firth_p_threshold: 0.01,
                    min_mac: null,
                ] },
                // The family list is the accepted-family vocabulary, so its exact set is the contract.
                { assert function.result.keySet().toList() == ['gcta', 'genie', 'ldak', 'mph', 'regenie'] },
            )
        }
    }

    test("method-family object errors retain GCTA-first attribution") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'family_object_order', [
                    example: [regenie: [], mph: [], ldak: [], genie: [], gcta: []],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: 'regenie,gcta_fastgwa', heritability_methods: 'ldak_reml', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            def report = function.stdout.join('\n')
            assertAll(
                { assert function.failed },
                { assert report.contains("option 'gcta': expected an option object") },
                { assert !report.contains("option 'genie': expected an option object") },
                { assert !report.contains("option 'ldak': expected an option object") },
                { assert !report.contains("option 'mph': expected an option object") },
                { assert !report.contains("option 'regenie': expected an option object") },
            )
        }
    }

    test("unknown options retain REGENIE-first attribution") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'unknown_option_order', [
                    example: [gcta: [mystery: true], genie: [mystery: true], ldak: [mystery: true], mph: [mystery: true], regenie: [mystery: true]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: 'regenie,gcta_fastgwa', heritability_methods: 'ldak_reml', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            def report = function.stdout.join('\n')
            assertAll(
                { assert function.failed },
                { assert report.contains("option 'regenie.mystery': unknown option") },
                { assert !report.contains("option 'gcta.mystery': unknown option") },
                { assert !report.contains("option 'genie.mystery': unknown option") },
                { assert !report.contains("option 'ldak.mystery': unknown option") },
                { assert !report.contains("option 'mph.mystery': unknown option") },
            )
        }
    }

    test("an unknown method family names the accepted family vocabulary") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'unknown_family', [
                    example: [mystery: [:]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: 'regenie', heritability_methods: '', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            def report = function.stdout.join('\n')
            assertAll(
                { assert function.failed },
                { assert report.contains("option 'mystery': unknown method family; accepted families are gcta, genie, ldak, mph, regenie") },
            )
        }
    }

    def unselectedFamilies = [
        [name: 'GENIE', family: 'genie', option: 'seed', value: 7, message: 'analysis does not select a GENIE method'],
        [name: 'MPH', family: 'mph', option: 'seed', value: 7, message: 'analysis does not select an MPH method'],
    ]

    unselectedFamilies.each { scenario ->
        // The two cases are no longer the same claim. MPH has no wired selector at all, so its query can never
        // match; GENIE's does, and this row selects `ldak_he` instead, so the rejection has to come from the
        // analysis's own selection rather than from an empty registry answer.
        test("${scenario.name} options are rejected on a row that selects no ${scenario.name} method") {
            function "validateMethodOptions"

            when {
                function {
                    """
                    input[0] = file('${RELATIONAL.methodOptions(outputDir, "unselected_${scenario.family}", [
                        example: [(scenario.family): [(scenario.option): scenario.value]],
                    ])}', checkIfExists: true)
                    input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'ldak_he', trait_type: 'quantitative']]]
                    """
                }
            }

            then {
                def report = function.stdout.join('\n')
                assertAll(
                    { assert function.failed },
                    { assert report.contains("option '${scenario.family}.${scenario.option}': ${scenario.message}") },
                )
            }
        }
    }

    def ldakFastOptions = [
        [
            name: 'a zero repetition count',
            options: [ldak: [fast_repetitions: 0]],
            heritability: 'ldak_fast_he',
            expected: "option 'ldak.fast_repetitions': expected a positive integer or null",
        ],
        [
            name: 'fewer than three jackknife blocks',
            options: [ldak: [fast_num_blocks: 2]],
            heritability: 'ldak_fast_he',
            expected: "option 'ldak.fast_num_blocks': expected an integer of at least 3 or null",
        ],
        [
            name: 'a fractional seed',
            options: [ldak: [fast_seed: 1.5]],
            heritability: 'ldak_fast_he',
            expected: "option 'ldak.fast_seed': expected an integer or null",
        ],
        [
            name: 'a stochastic control on a kinship-only row',
            options: [ldak: [fast_seed: 7]],
            heritability: 'ldak_he',
            expected: "option 'ldak.fast_seed': option is consumed by the stochastic direct-genotype LDAK estimators ldak_fast_he and ldak_fast_pcgc only",
        ],
        [
            name: 'the unrelated-sample filter on a fast-only row',
            options: [ldak: [relatedness_filter: true]],
            heritability: 'ldak_fast_he',
            expected: "option 'ldak.relatedness_filter': option is consumed by LDAK kinship methods only",
        ],
    ]

    ldakFastOptions.each { scenario ->
        test("the LDAK family rejects ${scenario.name}") {
            function "validateMethodOptions"

            when {
                function {
                    """
                    input[0] = file('${RELATIONAL.methodOptions(outputDir, "ldak_fast_${scenario.name.replace(' ', '_')}", [
                        example: scenario.options,
                    ])}', checkIfExists: true)
                    input[1] = [[[id: 'example', association_methods: '', heritability_methods: '${scenario.heritability}', trait_type: 'quantitative']]]
                    """
                }
            }

            then {
                def report = function.stdout.join('\n')
                assertAll(
                    { assert function.failed },
                    { assert report.contains(scenario.expected) },
                )
            }
        }
    }

    // Every bound below narrows GENIE's native surface at a point where the tool itself is silent: `-jn 1`
    // returns a jackknife standard error of exactly zero, a negative seed is treated as unseeded and echoes no
    // seed line at all, and a non-integer seed is parsed as zero. All three were measured on the pinned image.
    def genieOptions = [
        [
            name: 'a zero random-vector count',
            options: [genie: [random_vectors: 0]],
            expected: "option 'genie.random_vectors': expected a positive integer or null",
        ],
        [
            name: 'a single jackknife block',
            options: [genie: [jackknife_blocks: 1]],
            expected: "option 'genie.jackknife_blocks': expected an integer of at least 2 or null; one block yields a zero jackknife standard error",
        ],
        [
            name: 'a negative seed',
            options: [genie: [seed: -1]],
            expected: "option 'genie.seed': expected a non-negative integer or null; GENIE truncates a fractional seed toward zero, parses a non-numeric seed as 0, and treats a negative integer seed as unseeded while echoing no seed line at all",
        ],
        [
            name: 'a fractional seed',
            options: [genie: [seed: 1.5]],
            expected: "option 'genie.seed': expected a non-negative integer or null",
        ],
        [
            name: 'a non-boolean memory-efficiency flag',
            options: [genie: [memory_efficient: 'yes']],
            expected: "option 'genie.memory_efficient': expected a boolean",
        ],
        [
            name: 'an empty annotation path',
            options: [genie: [annotation: '']],
            expected: "option 'genie.annotation': expected a non-empty resource path string",
        ],
        [
            name: 'an annotation path that does not exist',
            options: [genie: [annotation: '/definitely/missing/annotation.txt']],
            expected: "option 'genie.annotation': resource path '/definitely/missing/annotation.txt' does not exist",
        ],
        [
            name: 'an unknown option name',
            options: [genie: [trace: 'x']],
            expected: "option 'genie.trace': unknown option; accepted GENIE options are random_vectors, jackknife_blocks, seed, memory_efficient, annotation",
        ],
    ]

    genieOptions.each { scenario ->
        test("the GENIE family rejects ${scenario.name}") {
            function "validateMethodOptions"

            when {
                function {
                    """
                    input[0] = file('${RELATIONAL.methodOptions(outputDir, "genie_${scenario.name.replace(' ', '_')}", [
                        example: scenario.options,
                    ])}', checkIfExists: true)
                    input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'genie_g', trait_type: 'quantitative']]]
                    """
                }
            }

            then {
                def report = function.stdout.join('\n')
                assertAll(
                    { assert function.failed },
                    { assert report.contains(scenario.expected) },
                )
            }
        }
    }

    test("a GENIE row resolves every supplied control into the shape the route reads") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'genie_resolved', [
                    example: [genie: [random_vectors: 20, jackknife_blocks: 100, seed: 7, memory_efficient: true]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'genie_g', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            // `annotation` stays `[]` rather than becoming null, matching every other optional resource, so
            // the spine can pass it straight through to the route without a second null guard.
            assertAll(
                { assert function.success },
                { assert function.result.example.genie == [
                    random_vectors: 20,
                    jackknife_blocks: 100,
                    seed: 7,
                    memory_efficient: true,
                    annotation: [],
                ] },
            )
        }
    }

    test("a mixed kinship and fast row keeps the unrelated-sample filter and is warned about it") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'mixed_relatedness_filter', [
                    example: [ldak: [relatedness_filter: true, fast_seed: 7]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'ldak_he,ldak_fast_he', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            // `log.warn` reaches the run log rather than the harness's captured stdout, so the report is read
            // from both, exactly as a pipeline-level validation test reads it.
            def report = VALIDATION.report(outputDir, function.stdout)
            assertAll(
                { assert function.success },
                { assert function.result.example.ldak.relatedness_filter },
                { assert function.result.example.ldak.fast_seed == 7 },
                { assert report.contains("sets 'ldak.relatedness_filter' beside direct-genotype estimator(s) ldak_fast_he") },
                { assert report.contains('estimates are computed on different sample sets') },
            )
        }
    }

    test("a documented fast row without a seed is warned that the run is not reproducible") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'unseeded_documented', [
                    example: [ldak: [fast_repetitions: 50]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'ldak_fast_he', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            def report = VALIDATION.report(outputDir, function.stdout)
            assertAll(
                { assert function.success },
                { assert report.contains("analysis 'example' selects stochastic method(s) ldak_fast_he without 'ldak.fast_seed'") },
                { assert report.contains('the native log records no seed') },
            )
        }
    }

    test("a seeded fast row is not warned") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'seeded_not_warned', [
                    example: [ldak: [fast_seed: 7]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'ldak_fast_he', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            // The negative half of the warning. Without it an unconditional `log.warn` would satisfy every
            // positive assertion and the seed would appear to matter when it did not.
            def report = VALIDATION.report(outputDir, function.stdout)
            assertAll(
                { assert function.success },
                { assert !report.contains("without 'ldak.fast_seed'") },
            )
        }
    }

    test("a kinship-only row is not warned about the unrelated-sample filter") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'kinship_only_filter', [
                    example: [ldak: [relatedness_filter: true]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'ldak_he', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            // The negative half of the mixed-row warning: with no direct-genotype estimator on the row there
            // are no two sample sets to compare, so nothing should be said.
            def report = VALIDATION.report(outputDir, function.stdout)
            assertAll(
                { assert function.success },
                { assert function.result.example.ldak.relatedness_filter },
                { assert !report.contains("sets 'ldak.relatedness_filter' beside direct-genotype estimator") },
            )
        }
    }

    test("an undocumented fast row is warned on the no-document path as well") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = []
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'ldak_fast_pcgc', trait_type: 'binary']]]
                """
            }
        }

        then {
            def report = VALIDATION.report(outputDir, function.stdout)
            assertAll(
                { assert function.success },
                { assert report.contains("analysis 'example' selects stochastic method(s) ldak_fast_pcgc without 'ldak.fast_seed'") },
            )
        }
    }

    test("a GENIE row without a seed is warned with its own family's seed option") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'unseeded_genie', [
                    example: [genie: [random_vectors: 20]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'genie_g', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            // GENIE echoes no seed line at all for an unseeded run, so the effective seed is unrecoverable even
            // from the published output. That is a different consequence from LDAK's, and the warning says so.
            def report = VALIDATION.report(outputDir, function.stdout)
            assertAll(
                { assert function.success },
                { assert report.contains("analysis 'example' selects stochastic method(s) genie_g without 'genie.seed'") },
                { assert report.contains('the native output records no seed line') },
            )
        }
    }

    test("a seeded GENIE row is not warned about its seed") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'seeded_genie', [
                    example: [genie: [seed: 7, random_vectors: 20]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'genie_g', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            def report = VALIDATION.report(outputDir, function.stdout)
            assertAll(
                { assert function.success },
                { assert function.result.example.genie.seed == 7 },
                { assert !report.contains("without 'genie.seed'") },
            )
        }
    }

    test("a row selecting both randomised families is warned once per family, each naming its own option") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = []
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'ldak_fast_he,genie_g', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            // The case that catches a merged registry query. One widened token list would emit a single
            // warning naming both selectors under whichever family's option name came first, and a researcher
            // would then set an option that does not exist for the other estimator.
            def report = VALIDATION.report(outputDir, function.stdout)
            assertAll(
                { assert function.success },
                { assert report.contains("analysis 'example' selects stochastic method(s) ldak_fast_he without 'ldak.fast_seed'") },
                { assert report.contains("analysis 'example' selects stochastic method(s) genie_g without 'genie.seed'") },
            )
        }
    }

    test("a GENIE row left on the native random-vector default is warned about the Monte-Carlo error") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'native_random_vectors', [
                    example: [genie: [seed: 7]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'genie_g', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            // A seed makes the fit repeatable, not stable: across seeds 1 to 8 at GENIE's native ten random
            // vectors the estimate moved by about 35% of its own size, and the reported jackknife standard
            // error contains none of that. The warning therefore has to fire on a fully seeded row.
            def report = VALIDATION.report(outputDir, function.stdout)
            assertAll(
                { assert function.success },
                { assert report.contains("analysis 'example' runs genie_g with GENIE's native default of 10 random vectors") },
                { assert report.contains("should set 'genie.random_vectors' explicitly") },
            )
        }
    }

    test("a GENIE row that sets the random-vector count is not warned about it") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'curated_random_vectors', [
                    example: [genie: [seed: 7, random_vectors: 100]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'genie_g', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            def report = VALIDATION.report(outputDir, function.stdout)
            assertAll(
                { assert function.success },
                { assert function.result.example.genie.random_vectors == 100 },
                { assert !report.contains('native default of 10 random vectors') },
            )
        }
    }

    test("a row selecting no GENIE method is never warned about GENIE's defaults") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = []
                input[1] = [[[id: 'example', association_methods: '', heritability_methods: 'ldak_he', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            // Both GENIE warnings read a resolved map that exists for every analysis, so what keeps them off
            // an unrelated row is the selection query rather than the absence of the option.
            def report = VALIDATION.report(outputDir, function.stdout)
            assertAll(
                { assert function.success },
                { assert !report.contains("without 'genie.seed'") },
                { assert !report.contains('native default of 10 random vectors') },
            )
        }
    }

    test("invalid resolved values retain REGENIE-first attribution") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'resolution_order', [
                    example: [
                        gcta: [sparse_cutoff: 2],
                        genie: [seed: 7],
                        ldak: [power: 'not-a-number'],
                        mph: [seed: 7],
                        regenie: [step1_bsize: 1.5],
                    ],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: 'regenie,gcta_fastgwa', heritability_methods: 'ldak_reml', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            def report = function.stdout.join('\n')
            assertAll(
                { assert function.failed },
                { assert report.contains("option 'regenie.step1_bsize': expected one positive integer") },
                { assert !report.contains("option 'gcta.sparse_cutoff'") },
                { assert !report.contains("option 'genie.seed'") },
                { assert !report.contains("option 'ldak.power'") },
            )
        }
    }
}

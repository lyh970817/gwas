nextflow_workflow {

    name "Test subworkflow VALIDATE_GWAS_INPUT"
    script "../main.nf"
    workflow "VALIDATE_GWAS_INPUT"
    tag "subworkflow"
    tag "input"
    tag "relational"

    test("linked manifests emit the canonical analysis tuple") {
        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'validate_gwas_input')}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'validate_gwas_input')}', checkIfExists: true)
                input[2] = null
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            def records = workflow.out.analyses
            def meta = records[0][0]
            assertAll(
                { assert workflow.success },
                { assert records.size() == 1 },
                { assert meta.id == 'example_pgen_qt' },
                { assert meta.cohort == 'example_pgen' },
                { assert meta.association_methods == ['regenie'] },
                { assert meta.heritability_methods == [] },
                { assert meta.genotype_format == 'plink2' },
                { assert !meta.is_binary },
                { assert meta.method_options.gcta.sparse_cutoff == 0.05 },
                { assert meta.method_options.gcta.ldms_maf_edges == [0, 0.01, 0.05, 0.2, 0.5] },
                { assert meta.method_options.ldak.weights_policy == 'equal' },
                { assert meta.method_options.regenie.step1_bsize == 1000 },
                { assert records[0][1].collect { input -> input.tokenize('.').last() } == ['pgen', 'psam', 'pvar'] },
                { assert records[0][2].endsWith('example.pheno') },
                { assert records[0][5] == [] },
                { assert records[0][6] == [] },
            )
        }
    }

    test("external-only summaries resolve typed unary and pair requests") {
        tag "external_summary"

        when {
            workflow {
                """
                input[0] = null
                input[1] = null
                input[2] = file('${RELATIONAL.summaryStatistics(projectDir, outputDir, 'external_only') { rows -> rows << RELATIONAL.summary(outputDir, 'external_bt') }}', checkIfExists: true)
                input[3] = file('${RELATIONAL.summaryRelationships(projectDir, outputDir, 'external_only')}', checkIfExists: true)
                input[4] = file('${RELATIONAL.referenceCatalog(outputDir, 'external_only')}', checkIfExists: true)
                input[5] = file('${RELATIONAL.methodOptions(outputDir, 'external_only', [
                    unary_requests: [
                        'ldsc_h2--external_qt': [reference_bundle_id: 'ldsc_eur'],
                        'ldsc_h2--external_qt--alternate': [
                            primary_request_id: 'ldsc_h2--external_qt',
                            request_name: 'alternate',
                            reference_bundle_id: 'ldsc_eur',
                            native_args: ['--chisq-max', '999'],
                        ],
                    ],
                    pair_requests: [
                        'ldsc_rg--external_pair': [reference_bundle_id: 'ldsc_eur'],
                        'ldsc_rg--external_pair--constrained': [
                            primary_request_id: 'ldsc_rg--external_pair',
                            request_name: 'constrained',
                            reference_bundle_id: 'ldsc_eur',
                            native_args: ['--intercept-gencov', '0'],
                        ],
                        'ldak_sumcors--external_pair': [reference_bundle_id: 'ldak_thin_eur'],
                    ],
                ])}', checkIfExists: true)
                """
            }
        }

        then {
            def summaries = workflow.out.summary_statistics
            def unary = workflow.out.unary_requests
            def pairs = workflow.out.pair_requests
            def summariesById = summaries.collectEntries { record -> [(record[0].summary_statistics_id): record] }
            def pairsById = pairs.collectEntries { record -> [(record[0].request_id): record] }
            assertAll(
                { assert workflow.success },
                { assert workflow.out.analyses.size() == 0 },
                { assert summariesById.keySet() == ['external_qt', 'external_bt'] as Set },
                { assert summariesById.external_qt[0].source_format == 'gwaslab' },
                { assert unary.collect { record -> record[0].request_id } as Set == ['ldsc_h2--external_qt', 'ldsc_h2--external_qt--alternate'] as Set },
                { assert unary.find { record -> record[0].request_id.endsWith('--alternate') }[0].native_args == ['--chisq-max', '999'] },
                { assert unary.every { record -> record[0].reference_bundle_id == 'ldsc_eur' } },
                { assert unary.every { record -> record[1..3].every { resource -> resource } } },
                { assert unary.every { record -> record[4] == [] } },
                { assert pairsById.keySet() == ['ldsc_rg--external_pair', 'ldsc_rg--external_pair--constrained', 'ldak_sumcors--external_pair'] as Set },
                { assert pairsById['ldsc_rg--external_pair'][0].left_summary_statistics_id == 'external_qt' },
                { assert pairsById['ldsc_rg--external_pair'][0].right_summary_statistics_id == 'external_bt' },
                { assert pairsById['ldsc_rg--external_pair'][0].left_genome_build == 'GRCh37' },
                { assert pairsById['ldsc_rg--external_pair'][0].right_ancestry == 'EUR' },
                { assert pairsById['ldsc_rg--external_pair'][1..3].every { resource -> resource } },
                { assert pairsById['ldsc_rg--external_pair--constrained'][0].primary_request_id == 'ldsc_rg--external_pair' },
                { assert pairsById['ldsc_rg--external_pair--constrained'][0].native_args == ['--intercept-gencov', '0'] },
                { assert pairsById['ldak_sumcors--external_pair'][1..3] == [[], [], []] },
                { assert pairsById['ldak_sumcors--external_pair'][4] },
            )
        }
    }

    test("declared internal summaries bind producer results and external pair endpoints") {
        tag "internal_summary"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'internal_summary') { rows ->
                    rows[0].pgen = RELATIONAL.resource(outputDir, 'internal_summary/example.pgen', '')
                    rows[0].psam = RELATIONAL.resource(outputDir, 'internal_summary/example.psam', '#IID\nexample\n')
                    rows[0].pvar = RELATIONAL.resource(outputDir, 'internal_summary/example.pvar', '#CHROM\tPOS\tID\tREF\tALT\n1\t1\trs1\tG\tA\n')
                }}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'internal_summary') { rows ->
                    rows[0].phenotype = RELATIONAL.resource(outputDir, 'internal_summary/example.pheno', 'FID IID QT\nexample example 1\n')
                    rows[0].quant_covariates = ''
                    rows[0].cat_covariates = ''
                }}', checkIfExists: true)
                input[2] = file('${RELATIONAL.summaryStatistics(projectDir, outputDir, 'internal_summary') { rows ->
                    rows.clear()
                    rows << RELATIONAL.internalSummary('example_pgen_qt', 'regenie', 'ldsc_h2')
                    rows << RELATIONAL.summary(outputDir, 'external_bt')
                }}', checkIfExists: true)
                input[3] = file('${RELATIONAL.summaryRelationships(projectDir, outputDir, 'internal_summary') { rows ->
                    rows[0].left_summary_statistics_id = 'example_pgen_qt--regenie'
                    rows[0].relationship_methods = 'ldsc_rg'
                }}', checkIfExists: true)
                input[4] = file('${RELATIONAL.referenceCatalog(outputDir, 'internal_summary')}', checkIfExists: true)
                input[5] = file('${RELATIONAL.methodOptions(outputDir, 'internal_summary', [
                    unary_requests: ['ldsc_h2--example_pgen_qt--regenie': [reference_bundle_id: 'ldsc_eur']],
                    pair_requests: ['ldsc_rg--external_pair': [reference_bundle_id: 'ldsc_eur']],
                ])}', checkIfExists: true)
                """
            }
        }

        then {
            def unary = workflow.out.unary_requests
            def pair = workflow.out.pair_requests
            assertAll(
                { assert workflow.success },
                { assert workflow.out.analyses.size() == 1 },
                { assert workflow.out.summary_statistics.size() == 1 },
                { assert workflow.out.summary_statistics[0][0].summary_statistics_id == 'external_bt' },
                { assert unary.size() == 1 },
                { assert unary[0][0].summary_statistics_id == 'example_pgen_qt--regenie' },
                { assert unary[0][0].source_kind == 'pipeline_generated' },
                { assert unary[0][0].producer_analysis_id == 'example_pgen_qt' },
                { assert unary[0][0].producer_association_method == 'regenie' },
                { assert pair.size() == 1 },
                { assert pair[0][0].left_summary_statistics_id == 'example_pgen_qt--regenie' },
                { assert pair[0][0].right_summary_statistics_id == 'external_bt' },
            )
        }
    }

    test("internal summary methods retain producer prevalence metadata") {
        tag "internal_summary"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'internal_summary_prevalence') { rows ->
                    rows[0].pgen = RELATIONAL.resource(outputDir, 'internal_summary_prevalence/example.pgen', '')
                    rows[0].psam = RELATIONAL.resource(outputDir, 'internal_summary_prevalence/example.psam', '#IID\nexample\n')
                    rows[0].pvar = RELATIONAL.resource(outputDir, 'internal_summary_prevalence/example.pvar', '#CHROM\tPOS\tID\tREF\tALT\n1\t1\trs1\tG\tA\n')
                }}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'internal_summary_prevalence') { rows ->
                    rows.clear()
                    def analysis = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                    analysis.phenotype = RELATIONAL.resource(outputDir, 'internal_summary_prevalence/example.pheno', 'FID IID BT\nexample example 1\n')
                    analysis.quant_covariates = ''
                    analysis.cat_covariates = ''
                    analysis.population_prevalence = 0.1
                    analysis.sample_prevalence = 0.2
                    rows << analysis
                }}', checkIfExists: true)
                input[2] = file('${RELATIONAL.summaryStatistics(projectDir, outputDir, 'internal_summary_prevalence') { rows ->
                    rows.clear()
                    rows << RELATIONAL.internalSummary('example_pgen_bt', 'regenie', 'ldsc_h2')
                }}', checkIfExists: true)
                input[3] = null
                input[4] = file('${RELATIONAL.referenceCatalog(outputDir, 'internal_summary_prevalence')}', checkIfExists: true)
                input[5] = file('${RELATIONAL.methodOptions(outputDir, 'internal_summary_prevalence', [
                    unary_requests: ['ldsc_h2--example_pgen_bt--regenie': [reference_bundle_id: 'ldsc_eur']],
                ])}', checkIfExists: true)
                """
            }
        }

        then {
            def request = workflow.out.unary_requests[0][0]
            assertAll(
                { assert workflow.success },
                { assert request.summary_statistics_id == 'example_pgen_bt--regenie' },
                { assert request.population_prevalence == 0.1 },
                { assert request.sample_prevalence == 0.2 },
            )
        }
    }

    test("pair-only internal summaries retain ordered producer prevalence metadata") {
        tag "internal_summary"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'pair_only_internal_prevalence')}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'pair_only_internal_prevalence') { rows ->
                    rows.clear()
                    rows << RELATIONAL.analysis(projectDir, 'example_pgen_qt')
                    def binary = RELATIONAL.analysis(projectDir, 'example_pgen_bt')
                    binary.population_prevalence = 0.1
                    binary.sample_prevalence = 0.2
                    rows << binary
                }}', checkIfExists: true)
                input[2] = file('${RELATIONAL.summaryStatistics(projectDir, outputDir, 'pair_only_internal_prevalence') { rows ->
                    rows.clear()
                    rows << RELATIONAL.internalSummary('example_pgen_qt', 'regenie')
                    rows << RELATIONAL.internalSummary('example_pgen_bt', 'regenie')
                }}', checkIfExists: true)
                input[3] = file('${RELATIONAL.summaryRelationships(projectDir, outputDir, 'pair_only_internal_prevalence') { rows ->
                    rows[0].relationship_id = 'internal_pair'
                    rows[0].left_summary_statistics_id = 'example_pgen_qt--regenie'
                    rows[0].right_summary_statistics_id = 'example_pgen_bt--regenie'
                    rows[0].relationship_methods = 'ldak_sumcors,ldsc_rg'
                }}', checkIfExists: true)
                input[4] = file('${RELATIONAL.referenceCatalog(outputDir, 'pair_only_internal_prevalence')}', checkIfExists: true)
                input[5] = file('${RELATIONAL.methodOptions(outputDir, 'pair_only_internal_prevalence', [
                    pair_requests: [
                        'ldak_sumcors--internal_pair': [reference_bundle_id: 'ldak_thin_eur'],
                        'ldsc_rg--internal_pair': [reference_bundle_id: 'ldsc_eur'],
                    ],
                ])}', checkIfExists: true)
                """
            }
        }

        then {
            def requests = workflow.out.pair_requests.collectEntries { record -> [(record[0].request_id): record[0]] }
            assertAll(
                { assert workflow.success },
                { assert workflow.out.unary_requests.size() == 0 },
                { assert requests.keySet() == ['ldak_sumcors--internal_pair', 'ldsc_rg--internal_pair'] as Set },
                { assert requests.values().every { meta -> meta.left_summary_statistics_id == 'example_pgen_qt--regenie' } },
                { assert requests.values().every { meta -> meta.right_summary_statistics_id == 'example_pgen_bt--regenie' } },
                { assert requests.values().every { meta -> !meta.left_is_binary } },
                { assert requests.values().every { meta -> meta.left_population_prevalence == null } },
                { assert requests.values().every { meta -> meta.left_sample_prevalence == null } },
                { assert requests.values().every { meta -> meta.right_is_binary } },
                { assert requests.values().every { meta -> meta.right_population_prevalence == 0.1 } },
                { assert requests.values().every { meta -> meta.right_sample_prevalence == 0.2 } },
            )
        }
    }

    test("pipeline-generated summaries require the producer-derived identity") {
        tag "summary_invalid"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'invalid_internal_id') { rows ->
                    rows[0].pgen = RELATIONAL.resource(outputDir, 'invalid_internal_id/example.pgen', '')
                    rows[0].psam = RELATIONAL.resource(outputDir, 'invalid_internal_id/example.psam', '#IID\nexample\n')
                    rows[0].pvar = RELATIONAL.resource(outputDir, 'invalid_internal_id/example.pvar', '#CHROM\tPOS\tID\tREF\tALT\n1\t1\trs1\tG\tA\n')
                }}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'invalid_internal_id') { rows ->
                    rows[0].phenotype = RELATIONAL.resource(outputDir, 'invalid_internal_id/example.pheno', 'FID IID QT\nexample example 1\n')
                    rows[0].quant_covariates = ''
                    rows[0].cat_covariates = ''
                }}', checkIfExists: true)
                input[2] = file('${RELATIONAL.summaryStatistics(projectDir, outputDir, 'invalid_internal_id') { rows ->
                    rows.clear()
                    def internal = RELATIONAL.internalSummary('example_pgen_qt', 'regenie', 'ldsc_h2')
                    internal.summary_statistics_id = 'wrong_internal_id'
                    rows << internal
                }}', checkIfExists: true)
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            assertAll(
                { assert !workflow.success },
                { assert workflow.stdout.any { line -> line.contains("pipeline-generated result must use deterministic identifier 'example_pgen_qt--regenie'") } },
            )
        }
    }

    test("an internal summary naming the retired plink2 producer is rejected, not reinterpreted") {
        tag "summary_invalid"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'retired_plink2_producer') { rows ->
                    rows[0].pgen = RELATIONAL.resource(outputDir, 'retired_plink2_producer/example.pgen', '')
                    rows[0].psam = RELATIONAL.resource(outputDir, 'retired_plink2_producer/example.psam', '#IID\nexample\n')
                    rows[0].pvar = RELATIONAL.resource(outputDir, 'retired_plink2_producer/example.pvar', '#CHROM\tPOS\tID\tREF\tALT\n1\t1\trs1\tG\tA\n')
                }}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'retired_plink2_producer') { rows ->
                    rows[0].phenotype = RELATIONAL.resource(outputDir, 'retired_plink2_producer/example.pheno', 'FID IID QT\nexample example 1\n')
                    rows[0].quant_covariates = ''
                    rows[0].cat_covariates = ''
                }}', checkIfExists: true)
                input[2] = file('${RELATIONAL.summaryStatistics(projectDir, outputDir, 'retired_plink2_producer') { rows ->
                    rows.clear()
                    rows << RELATIONAL.internalSummary('example_pgen_qt', 'plink2', 'ldsc_h2')
                }}', checkIfExists: true)
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            // The analysis row selects `regenie`, and `plink2` is no longer a selectable association method,
            // so a `--plink2` identity resolves to no internal producer and is refused rather than reinterpreted.
            assertAll(
                { assert !workflow.success },
                { assert workflow.stdout.any { line -> line.contains("analysis 'example_pgen_qt' does not select association method 'plink2'") } },
            )
        }
    }

    test("external summaries cannot collide with pipeline-generated identities") {
        tag "summary_invalid"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'external_internal_collision') { rows ->
                    rows[0].pgen = RELATIONAL.resource(outputDir, 'external_internal_collision/example.pgen', '')
                    rows[0].psam = RELATIONAL.resource(outputDir, 'external_internal_collision/example.psam', '#IID\nexample\n')
                    rows[0].pvar = RELATIONAL.resource(outputDir, 'external_internal_collision/example.pvar', '#CHROM\tPOS\tID\tREF\tALT\n1\t1\trs1\tG\tA\n')
                }}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'external_internal_collision') { rows ->
                    rows[0].phenotype = RELATIONAL.resource(outputDir, 'external_internal_collision/example.pheno', 'FID IID QT\nexample example 1\n')
                    rows[0].quant_covariates = ''
                    rows[0].cat_covariates = ''
                }}', checkIfExists: true)
                input[2] = file('${RELATIONAL.summaryStatistics(projectDir, outputDir, 'external_internal_collision') { rows ->
                    rows.clear()
                    def external = RELATIONAL.summary(outputDir, 'external_qt')
                    external.summary_statistics_id = 'example_pgen_qt--regenie'
                    rows << external
                }}', checkIfExists: true)
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            assertAll(
                { assert !workflow.success },
                { assert workflow.stdout.any { line -> line.contains("external result collides with pipeline-generated result 'example_pgen_qt--regenie'") } },
            )
        }
    }

    test("schema-optional manifest columns may be omitted") {
        tag "manifest_schema"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.retainColumns(
                    RELATIONAL.cohorts(projectDir, outputDir, 'omitted_optional_columns'),
                    ['cohort_id', 'genome_build', 'ancestry', 'pgen', 'psam', 'pvar'],
                )}', checkIfExists: true)
                input[1] = file('${RELATIONAL.retainColumns(
                    RELATIONAL.analyses(projectDir, outputDir, 'omitted_optional_columns'),
                    ['analysis_id', 'cohort_id', 'trait_id', 'trait_type', 'phenotype', 'phenotype_column', 'association_methods'],
                )}', checkIfExists: true)
                input[2] = null
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            def analysis = workflow.out.analyses[0]
            assertAll(
                { assert workflow.success },
                { assert analysis[0].id == 'example_pgen_qt' },
                { assert analysis[1].collect { genotype -> genotype.toString().tokenize('.').last() } == ['pgen', 'psam', 'pvar'] },
                { assert analysis[3..6].every { optional -> optional == [] } },
            )
        }
    }

    test("quoted manifest headers preserve the schema contract") {
        tag "manifest_schema"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.quoteHeaders(RELATIONAL.cohorts(projectDir, outputDir, 'quoted_headers'))}', checkIfExists: true)
                input[1] = file('${RELATIONAL.quoteHeaders(RELATIONAL.analyses(projectDir, outputDir, 'quoted_headers'))}', checkIfExists: true)
                input[2] = null
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.analyses[0][0].id == 'example_pgen_qt' },
            )
        }
    }

    test("repeated manifest headers are rejected before schema map conversion") {
        tag "manifest_schema"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.appendColumn(
                    RELATIONAL.cohorts(projectDir, outputDir, 'repeated_headers'),
                    'pgen',
                    "${FIXTURES.UPSTREAM}results/fixtures/genotypes/example_all.pgen",
                )}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'repeated_headers')}', checkIfExists: true)
                input[2] = null
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            assertAll(
                { assert !workflow.success },
                { assert workflow.stdout.join('\n').contains("header row 1 repeats column 'pgen'") },
            )
        }
    }

    test("unexpected manifest columns are rejected by the schema") {
        tag "manifest_schema"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.appendColumn(
                    RELATIONAL.cohorts(projectDir, outputDir, 'unexpected_header'),
                    'vcf_index',
                    'unused.vcf.gz.tbi',
                )}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'unexpected_header')}', checkIfExists: true)
                input[2] = null
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains('vcf_index') },
                { assert report.contains('False schema always fails') },
            )
        }
    }

    // A cohort that declares no view identity must carry no `genotype_view_id` key at all, not a null one:
    // analysis metadata is a task-hash input everywhere downstream, so an unconditional null would move every
    // existing analysis's hash and every pinned snapshot for cohorts that declare nothing.
    test("an undeclared genotype view identity leaves the key absent from analysis metadata") {
        tag "genotype_view_id"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'undeclared_view_id')}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'undeclared_view_id')}', checkIfExists: true)
                input[2] = null
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert !workflow.out.analyses[0][0].containsKey('genotype_view_id') },
            )
        }
    }

    def declaredViewIds = [
        [name: 'a bare hexadecimal digest', token: '52d1d326413775cd52d1d326413775cd52d1d326413775cd52d1d326413775cd'],
        [name: 'a shortest-accepted digest', token: '52d1d326413775cd'],
        [name: 'a backend-namespaced identity', token: 'biofuse:52d1d326413775cd'],
    ]

    declaredViewIds.each { scenario ->
        test("${scenario.name} declared as genotype_view_id reaches the analysis metadata") {
            tag "genotype_view_id"

            when {
                workflow {
                    """
                    input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, "declared_view_id_${scenario.token.replaceAll(/[^a-z0-9]/, '_')}", { rows -> rows[0].genotype_view_id = scenario.token })}', checkIfExists: true)
                    input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, "declared_view_id_${scenario.token.replaceAll(/[^a-z0-9]/, '_')}")}', checkIfExists: true)
                    input[2] = null
                    input[3] = null
                    input[4] = null
                    input[5] = null
                    """
                }
            }

            then {
                assertAll(
                    { assert workflow.success },
                    { assert workflow.out.analyses[0][0].genotype_view_id == scenario.token },
                )
            }
        }
    }

    def rejectedViewIds = [
        [name: 'an upper-case digest', token: '52D1D326413775CD'],
        [name: 'a digest shorter than sixteen characters', token: '52d1d32641377'],
        [name: 'a path', token: '/mnt/views/52d1d326413775cd'],
        [name: 'a namespace with no digest', token: 'biofuse:'],
    ]

    rejectedViewIds.eachWithIndex { scenario, index ->
        test("${scenario.name} is refused as a genotype_view_id") {
            tag "genotype_view_id"

            when {
                workflow {
                    """
                    input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, "rejected_view_id_${index}", { rows -> rows[0].genotype_view_id = scenario.token })}', checkIfExists: true)
                    input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, "rejected_view_id_${index}")}', checkIfExists: true)
                    input[2] = null
                    input[3] = null
                    input[4] = null
                    input[5] = null
                    """
                }
            }

            then {
                def report = VALIDATION.report(outputDir, workflow.stdout)
                assertAll(
                    { assert !workflow.success },
                    { assert report.contains('genotype_view_id') },
                    { assert report.contains('16 to 64 lowercase hexadecimal characters') },
                )
            }
        }
    }

    // A REGENIE analysis unit's `analysis_id` is not only a pipeline label: batching makes it a native
    // REGENIE phenotype column name, a `--phenoColList` token on a command line, and the stem REGENIE names
    // the result file after. The manifest pattern `^\S+$` is much wider than those roles allow, so the
    // narrower class is enforced at ingress where the message can name the manifest field.
    def rejectedRegenieAnalysisIds = [
        [name: 'a leading dash, which REGENIE would read as an option', token: '-example'],
        [name: 'a comma, which would split one analysis into two columns', token: 'exam,ple'],
        [name: 'a command substitution', token: 'example\$(id)'],
        [name: 'a backtick', token: 'example`id`'],
        [name: 'a glob', token: 'example*'],
        [name: 'the phenotype file key column FID', token: 'FID'],
        [name: 'the phenotype file key column IID', token: 'IID'],
    ]

    rejectedRegenieAnalysisIds.eachWithIndex { scenario, index ->
        test("${scenario.name} is refused as a REGENIE analysis_id") {
            tag "regenie_column_name"

            when {
                workflow {
                    """
                    input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, "rejected_regenie_id_${index}")}', checkIfExists: true)
                    input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, "rejected_regenie_id_${index}", { rows ->
                        rows[0].analysis_id = scenario.token
                        rows[0].association_methods = 'regenie'
                        rows[0].heritability_methods = ''
                    })}', checkIfExists: true)
                    input[2] = null
                    input[3] = null
                    input[4] = null
                    input[5] = null
                    """
                }
            }

            then {
                def report = VALIDATION.report(outputDir, workflow.stdout)
                assertAll(
                    { assert !workflow.success },
                    { assert report.contains("field 'analysis_id'") },
                    { assert report.contains('native REGENIE phenotype column name') },
                )
            }
        }
    }

    test("an analysis_id in the safe column-name class is accepted for REGENIE") {
        tag "regenie_column_name"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'accepted_regenie_id')}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'accepted_regenie_id', { rows ->
                    rows[0].analysis_id = 'a.b-c_1'
                    rows[0].association_methods = 'regenie'
                    rows[0].heritability_methods = ''
                })}', checkIfExists: true)
                input[2] = null
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.analyses[0][0].id == 'a.b-c_1' },
            )
        }
    }

    test("an analysis_id outside that class is accepted when no REGENIE method is selected") {
        tag "regenie_column_name"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'unconstrained_id')}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'unconstrained_id', { rows ->
                    rows[0].analysis_id = '-example'
                    rows[0].association_methods = 'gcta_fastgwa'
                    rows[0].heritability_methods = ''
                })}', checkIfExists: true)
                input[2] = null
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            // The rule is a REGENIE contract, not a global tightening of the manifest pattern: an
            // identifier only has to be a native column name for the routes that make it one.
            assertAll(
                { assert workflow.success },
                { assert workflow.out.analyses[0][0].id == '-example' },
            )
        }
    }

    // Two rows sharing a `cohort_id` are one cohort, so their declared identities must agree. Without the
    // identity in the compared definition the second row would be discarded silently and the run would key
    // every shared artifact on whichever row happened to be read first.
    test("conflicting genotype view identities on one cohort_id are rejected by name") {
        tag "genotype_view_id"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'conflicting_view_id', { rows ->
                    rows[0].genotype_view_id = '52d1d326413775cd'
                    def duplicate = new LinkedHashMap(rows[0])
                    duplicate.genotype_view_id = 'ab1d1d326413775c'
                    rows << duplicate
                })}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'conflicting_view_id')}', checkIfExists: true)
                input[2] = null
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains("duplicate cohort_id 'example_pgen' conflicts with row 2") },
                { assert report.contains("'genotype_view_id'") },
            )
        }
    }

    // Every PLINK, GCTA and REGENIE consumer addresses a fileset by one prefix. Before representation-
    // preserving preparation a mismatched trio failed once, deep inside the mandatory PGEN conversion; with
    // passthrough there is no such single point, so it is refused at ingress where the cohort can be named.
    test("a genotype group whose members do not share one basename stem is rejected at ingress") {
        tag "genotype_view_id"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'mismatched_stems', { rows ->
                    rows[0].pvar = rows[0].pvar.toString().replace('example_all.pvar', 'example_chr1.pvar')
                })}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'mismatched_stems')}', checkIfExists: true)
                input[2] = null
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains("row 2 (cohort_id 'example_pgen')") },
                { assert report.contains('do not share one basename stem') },
                { assert report.contains("pgen='example_all'") },
                { assert report.contains("pvar='example_chr1'") },
            )
        }
    }

    // A `.pvar.zst` needs plink2's `vzs` modifier, which no consumer in this pipeline passes: every one of
    // them derives a bare `--pfile`/`--mpfile` prefix. It is refused at ingress rather than left reachable.
    //
    // The file at that path is materialised, not merely named. The schema property carries both `exists` and
    // the extension pattern under one `errorMessage`, so pointing at a path with nothing behind it would be
    // refused by `exists` and the assertions below would hold with the pattern reverted — the test would pin
    // nothing. With the file present, only the pattern can refuse.
    test("a Zstandard-compressed pvar is refused at ingress") {
        tag "genotype_view_id"

        when {
            workflow {
                """
                input[0] = file('${RELATIONAL.cohorts(projectDir, outputDir, 'zstd_pvar', { rows ->
                    rows[0].pvar = RELATIONAL.copyResource(outputDir, 'example_all.pvar.zst', "${FIXTURES.base(projectDir)}results/fixtures/genotypes/example_all.pvar")
                })}', checkIfExists: true)
                input[1] = file('${RELATIONAL.analyses(projectDir, outputDir, 'zstd_pvar')}', checkIfExists: true)
                input[2] = null
                input[3] = null
                input[4] = null
                input[5] = null
                """
            }
        }

        then {
            def report = VALIDATION.report(outputDir, workflow.stdout)
            assertAll(
                { assert !workflow.success },
                { assert report.contains('pvar') },
                { assert report.contains("must have extension '.pvar'") },
            )
        }
    }
}

nextflow_function {

    name "Test linked GWAS input contract functions"
    script "../native_option_policy.nf"
    tag "function"
    tag "input"

    test("the pair firewall permits non-file scientific GCTA arguments") {
        function "validateNativeArgumentTokens"

        when {
            function {
                """
                input[0] = 'method_options.json'
                input[1] = 'gcta_bivariate_reml--example'
                input[2] = ['--reml-maxit', '500', '--reml-bivar-nocove']
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['--reml-maxit', '500', '--reml-bivar-nocove'] },
            )
        }
    }

    def firewallCases = [
        [name: 'wrapper output', args: ['--out', 'hijacked'], expected: 'wrapper-owned invocation mechanics'],
        [name: 'alternate operation', args: ['--pca', '10'], expected: 'different primary GCTA operation'],
        [name: 'file-taking input', args: ['--keep', 'samples.txt'], expected: 'wrapper-owned invocation mechanics'],
        [name: 'undeclared file-like value', args: ['--mystery', 'samples.txt'], expected: 'undeclared file input'],
        [name: 'inline undeclared file-like value', args: ['--mystery=samples.txt'], expected: 'undeclared file input'],
        [name: 'path separator', args: ['--mystery', '../samples'], expected: 'path separator'],
        [name: 'environment assignment', args: ['--reml-maxit', 'KEY=value'], expected: 'environment assignment'],
    ]

    firewallCases.each { scenario ->
        test("the pair firewall rejects ${scenario.name}") {
            function "validateNativeArgumentTokens"

            when {
                function {
                    """
                    input[0] = 'method_options.json'
                    input[1] = 'gcta_bivariate_reml--example'
                    input[2] = ${groovy.json.JsonOutput.toJson(scenario.args)}
                    """
                }
            }

            then {
                assertAll(
                    { assert function.failed },
                    { assert function.stdout.join('\n').contains(scenario.expected) },
                )
            }
        }
    }

    test("the summary firewall rejects inline undeclared files") {
        function "validateSummaryNativeArgumentTokens"

        when {
            function {
                """
                input[0] = 'method_options.json'
                input[1] = 'unary_requests'
                input[2] = 'ldsc_h2--example'
                input[3] = 'ldsc_h2'
                input[4] = ['--mystery=samples.sumstats']
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.join('\n').contains('undeclared file input') },
            )
        }
    }

    test("the summary firewall permits non-file LDSC scientific arguments") {
        function "validateSummaryNativeArgumentTokens"

        when {
            function {
                """
                input[0] = 'method_options.json'
                input[1] = 'pair_requests'
                input[2] = 'ldsc_rg--example'
                input[3] = 'ldsc_rg'
                input[4] = ['--n-blocks', '20', '--intercept-gencov=0']
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['--n-blocks', '20', '--intercept-gencov=0'] },
            )
        }
    }

    def ldscFileOptions = [
        '--annot',
        '--bfile',
        '--cts-bin',
        '--extract',
        '--frqfile',
        '--frqfile-chr',
        '--h2-cts',
        '--keep',
        '--print-snps',
        '--ref-ld',
        '--ref-ld-chr-cts',
        '--w-ld',
    ]
    ['ldsc_h2', 'ldsc_rg'].each { method ->
        ldscFileOptions.each { option ->
            [
                [name: 'bare', args: [option, 'opaque_resource']],
                [name: 'inline', args: ["${option}=opaque_resource"]],
            ].each { form ->
                test("the ${method} firewall structurally rejects ${form.name} ${option}") {
                    function "validateSummaryNativeArgumentTokens"

                    when {
                        function {
                            """
                            input[0] = 'method_options.json'
                            input[1] = '${method == 'ldsc_h2' ? 'unary_requests' : 'pair_requests'}'
                            input[2] = '${method}--example'
                            input[3] = '${method}'
                            input[4] = ${groovy.json.JsonOutput.toJson(form.args)}
                            """
                        }
                    }

                    then {
                        assertAll(
                            { assert function.failed },
                            { assert function.stdout.join('\n').contains('requires a typed staged resource') },
                        )
                    }
                }
            }
        }

        test("the ${method} firewall rejects the alternate LD-score operation") {
            function "validateSummaryNativeArgumentTokens"

            when {
                function {
                    """
                    input[0] = 'method_options.json'
                    input[1] = '${method == 'ldsc_h2' ? 'unary_requests' : 'pair_requests'}'
                    input[2] = '${method}--example'
                    input[3] = '${method}'
                    input[4] = ['--l2']
                    """
                }
            }

            then {
                assertAll(
                    { assert function.failed },
                    { assert function.stdout.join('\n').contains("selects a different primary operation from wrapper-owned method '${method}'") },
                )
            }
        }

        test("the ${method} firewall rejects the other summary-statistics operation") {
            function "validateSummaryNativeArgumentTokens"

            when {
                function {
                    """
                    input[0] = 'method_options.json'
                    input[1] = '${method == 'ldsc_h2' ? 'unary_requests' : 'pair_requests'}'
                    input[2] = '${method}--example'
                    input[3] = '${method}'
                    input[4] = ['${method == 'ldsc_h2' ? '--rg' : '--h2'}']
                    """
                }
            }

            then {
                assertAll(
                    { assert function.failed },
                    { assert function.stdout.join('\n').contains("selects a different primary operation from wrapper-owned method '${method}'") },
                )
            }
        }
    }

    def ldscProtectedOptions = [
        ldsc_h2: [
            '--h2',
            '--ref-ld-chr',
            '--w-ld-chr',
            '--samp-prev',
            '--pop-prev',
            '--out',
            '--annot',
            '--bfile',
            '--cts-bin',
            '--extract',
            '--frqfile',
            '--frqfile-chr',
            '--h2-cts',
            '--keep',
            '--print-snps',
            '--ref-ld',
            '--ref-ld-chr-cts',
            '--w-ld',
            '--l2',
            '--rg',
        ],
        ldsc_rg: [
            '--rg',
            '--ref-ld-chr',
            '--w-ld-chr',
            '--samp-prev',
            '--pop-prev',
            '--out',
            '--annot',
            '--bfile',
            '--cts-bin',
            '--extract',
            '--frqfile',
            '--frqfile-chr',
            '--h2-cts',
            '--keep',
            '--print-snps',
            '--ref-ld',
            '--ref-ld-chr-cts',
            '--w-ld',
            '--l2',
            '--h2',
        ],
    ]
    ldscProtectedOptions.each { method, protectedOptions ->
        def protectedSet = protectedOptions.toSet()
        def properPrefixes = protectedOptions
            .collectMany { option -> (3..<option.size()).collect { prefixLength -> option.substring(0, prefixLength) } }
            .findAll { prefix -> !(prefix in protectedSet) }
            .toSet()
            .sort()
        def properPrefixArguments = properPrefixes
            .collectMany { prefix -> [prefix, "${prefix}=opaque_value"] }
            .sort()

        test("the ${method} matcher covers bare and inline forms of every proper protected-option prefix") {
            function "getLdscProtectedNativeArgumentMatches"
            tag "ldsc_prefix_firewall"

            when {
                function {
                    """
                    input[0] = '${method}'
                    input[1] = new groovy.json.JsonSlurper().parseText('${groovy.json.JsonOutput.toJson(properPrefixArguments)}')
                    """
                }
            }

            then {
                assertAll(
                    { assert function.success },
                    { assert function.result.keySet().toSet() == properPrefixArguments.toSet() },
                    { assert function.result.values().every { protection -> protection && !protection.exact } },
                    { assert function.result.every { _argument, protection -> protection.matches.any { match -> match.option.startsWith(protection.option_name) } } },
                )
            }
        }
    }

    def ldscAbbreviationExamples = [
        [name: 'annotation file', option: '--ann'],
        [name: 'binary genotype prefix', option: '--bfi'],
        [name: 'ambiguous category-bin prefix', option: '--cts-b'],
        [name: 'partitioned heritability input', option: '--h2-c'],
        [name: 'regression-weight reference', option: '--w-ld-c'],
        [name: 'ambiguous LD-score reference', option: '--ref-ld-c'],
        [name: 'LD-score operation', option: '--l'],
    ]
    ['ldsc_h2', 'ldsc_rg'].each { method ->
        def methodExamples = ldscAbbreviationExamples + [
            [
                name: method == 'ldsc_h2' ? 'ambiguous RG-operation/reference prefix' : 'alternate heritability-operation prefix',
                option: method == 'ldsc_h2' ? '--r' : '--h',
            ],
        ]
        methodExamples.each { scenario ->
            [
                [name: 'bare', token: scenario.option],
                [name: 'inline', token: "${scenario.option}=opaque_value"],
            ].each { form ->
                test("the ${method} firewall rejects ${form.name} ${scenario.name} abbreviation ${scenario.option}") {
                    function "validateSummaryNativeArgumentTokens"
                    tag "ldsc_prefix_firewall"

                    when {
                        function {
                            """
                            input[0] = 'method_options.json'
                            input[1] = '${method == 'ldsc_h2' ? 'unary_requests' : 'pair_requests'}'
                            input[2] = '${method}--example'
                            input[3] = '${method}'
                            input[4] = ['${form.token}']
                            """
                        }
                    }

                    then {
                        assertAll(
                            { assert function.failed },
                            { assert function.stdout.join('\n').contains('protected LDSC option abbreviation') },
                        )
                    }
                }
            }
        }
    }

}

nextflow_function {

    name "Test linked GWAS input contract functions"
    script "../method_registry.nf"
    tag "function"
    tag "input"

    test("quantitative fastGWA maps the native beta and sample-count columns") {
        function "getAssociationColumnMappingJson"

        when {
            function {
                """
                input[0] = 'gcta_fastgwa'
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert new groovy.json.JsonSlurper().parseText(function.result) == [
                    snpid: 'SNP',
                    chrom: 'CHR',
                    pos: 'POS',
                    ea: 'A1',
                    nea: 'A2',
                    eaf: 'AF1',
                    n: 'N',
                    beta: 'BETA',
                    se: 'SE',
                    p: 'P',
                ] },
            )
        }
    }

    test("binary fastGWA retains the native beta mapping without inventing an odds-ratio column") {
        function "getAssociationColumnMappingJson"

        when {
            function {
                """
                input[0] = 'gcta_fastgwa'
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert new groovy.json.JsonSlurper().parseText(function.result) == [
                    snpid: 'SNP',
                    chrom: 'CHR',
                    pos: 'POS',
                    ea: 'A1',
                    nea: 'A2',
                    eaf: 'AF1',
                    n: 'N',
                    beta: 'BETA',
                    se: 'SE',
                    p: 'P',
                ] },
            )
        }
    }

    test("quantitative KVIK maps its A1 frequency and effective analysis size without an extra Z field") {
        function "getAssociationColumnMappingJson"
        tag "kvik_mapping"

        when {
            function {
                """
                input[0] = 'ldak_kvik'
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert new groovy.json.JsonSlurper().parseText(function.result) == [
                    snpid: 'Predictor',
                    chrom: 'Chromosome',
                    pos: 'Basepair',
                    ea: 'A1',
                    nea: 'A2',
                    eaf: 'EAF',
                    neff: 'N',
                    p: 'Wald_P',
                    beta: 'Effect',
                    se: 'SE',
                ] },
            )
        }
    }

    test("the association mapping registry preserves its established public projection") {
        function "getAssociationColumnMappings"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.keySet().toList() == ['regenie', 'gcta_fastgwa', 'ldak_kvik'] },
                { assert function.result.values().every { mapping -> mapping.keySet().every { section -> section in ['common', 'quantitative', 'binary'] } } },
                { assert function.result.regenie.keySet().toList() == ['common'] },
                { assert function.result.ldak_kvik.keySet().toList() == ['common', 'quantitative', 'binary'] },
            )
        }
    }

    test("method capabilities retain selector, matrix, prevalence and citation knowledge") {
        function "getMethodCapabilities"
        tag "summary_capabilities"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.keySet().toList() == [
                    'regenie',
                    'gcta_fastgwa',
                    'ldak_kvik',
                    'gcta_greml',
                    'gcta_greml_ldms',
                    'gcta_bivariate_reml',
                    'gcta_bivariate_reml_ldms',
                    'gcta_bivariate_he',
                    'gcta_bivariate_he_ldms',
                    'ldak_sumher',
                    'ldak_sumcors',
                    'ldsc_h2',
                    'ldsc_rg',
                    'ldak_reml',
                    'ldak_he',
                    'ldak_pcgc',
                ] },
                { assert function.result.gcta_fastgwa.matrix_kind == 'gcta_sparse' },
                { assert function.result.gcta_greml.matrix_kind == 'gcta_dense' },
                { assert function.result.gcta_greml_ldms.matrix_kind == 'gcta_ldms' },
                { assert function.result.gcta_bivariate_reml.domain == 'pairwise' },
                { assert function.result.gcta_bivariate_reml.matrix_kind == 'gcta_dense' },
                { assert function.result.gcta_bivariate_reml_ldms.domain == 'pairwise' },
                { assert function.result.gcta_bivariate_reml_ldms.matrix_kind == 'gcta_ldms' },
                // Each Haseman-Elston selector consumes the same relatedness backend as its REML sibling,
                // which is what makes selecting the two together cost one matrix construction. Both are
                // quantitative-only and neither can honour a covariate file.
                { assert function.result.gcta_bivariate_he.domain == 'pairwise' },
                { assert function.result.gcta_bivariate_he.matrix_kind == 'gcta_dense' },
                { assert function.result.gcta_bivariate_he.estimator_family == 'moment_he' },
                { assert function.result.gcta_bivariate_he.trait_support == [quantitative: true, binary: false] },
                { assert function.result.gcta_bivariate_he.supports_covariates == false },
                { assert function.result.gcta_bivariate_he.prevalence.population == 'not_consumed' },
                { assert function.result.gcta_bivariate_he_ldms.matrix_kind == 'gcta_ldms' },
                { assert function.result.gcta_bivariate_he_ldms.citation_keys == ['gcta_hereg', 'gcta_greml_ldms'] },
                { assert function.result.ldak_sumher.domain == 'summary_unary' },
                { assert function.result.ldak_sumher.reference_family == 'ldak' },
                { assert function.result.ldak_sumher.prevalence.population == 'consumed' },
                { assert function.result.ldak_sumcors.endpoint_domain == 'summary_statistics' },
                { assert function.result.ldak_sumcors.prevalence == [population: 'consumed', sample: 'consumed'] },
                { assert function.result.ldsc_h2.reference_family == 'ldsc' },
                { assert function.result.ldsc_h2.prevalence.sample == 'consumed' },
                { assert function.result.ldsc_rg.endpoint_domain == 'summary_statistics' },
                { assert function.result.ldsc_rg.prevalence == [population: 'consumed', sample: 'consumed'] },
                { assert function.result.ldak_reml.matrix_kind == 'ldak_kinship' },
                { assert function.result.ldak_pcgc.prevalence.population == 'required' },
                { assert function.result.ldak_he.citation_keys == function.result.ldak_pcgc.citation_keys },
            )
        }
    }

    test("the capability contract fixes one closed vocabulary per declared field") {
        function "getMethodCapabilityContract"
        tag "method_capabilities"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.required_fields == [
                    'domain',
                    'estimator_family',
                    'input_backend',
                    'trait_support',
                    'prevalence',
                    'citation_keys',
                ] },
                { assert function.result.queryable_fields == [
                    'domain',
                    'option_family',
                    'matrix_kind',
                    'endpoint_domain',
                    'reference_family',
                    'estimator_family',
                    'input_backend',
                    'trait_support',
                    'supports_covariates',
                    'prevalence',
                    'citation_keys',
                ] },
                { assert function.result.estimator_families == [
                    'whole_genome_regression',
                    'mixed_linear_model',
                    'reml',
                    'moment_he',
                    'pcgc',
                    'ld_score_regression',
                    'summary_tagging_regression',
                ] },
                { assert function.result.input_backends == [
                    'dense_grm',
                    'ldms_grm_family',
                    'ldak_kinship',
                    'sparse_grm',
                    'direct_plink_genotypes',
                    'summary_statistics',
                ] },
                { assert function.result.prevalence_requirements == ['not_consumed', 'consumed', 'required'] },
                { assert function.result.trait_support_fields == ['quantitative', 'binary'] },
            )
        }
    }

    test("every registered method declares every capability field in the contract vocabulary") {
        function "getMethodCapabilities"
        tag "method_capabilities"

        then {
            def requiredFields = [
                'domain',
                'estimator_family',
                'input_backend',
                'trait_support',
                'prevalence',
                'citation_keys',
            ]
            def estimatorFamilies = [
                'whole_genome_regression',
                'mixed_linear_model',
                'reml',
                'moment_he',
                'pcgc',
                'ld_score_regression',
                'summary_tagging_regression',
            ]
            def inputBackends = [
                'dense_grm',
                'ldms_grm_family',
                'ldak_kinship',
                'sparse_grm',
                'direct_plink_genotypes',
                'summary_statistics',
            ]
            def prevalenceRequirements = ['not_consumed', 'consumed', 'required']
            assertAll(
                { assert function.success },
                { assert function.result.every { _token, details -> requiredFields.every { field -> details.containsKey(field) } } },
                // Exact set equality in both directions, not membership: no registered method may declare a
                // value outside the vocabulary, AND no vocabulary value may be left without a member. The
                // removal of the `plink2` entry would otherwise have left `generalised_linear_model` declared
                // and dead. Both literals are pinned to the contract itself by the closed-vocabulary test
                // above, so neither this list nor the contract can drift alone.
                { assert function.result.collect { _token, details -> details.estimator_family }.unique().sort() == estimatorFamilies.toSorted() },
                { assert function.result.collect { _token, details -> details.input_backend }.unique().sort() == inputBackends.toSorted() },
                { assert function.result.every { _token, details -> details.prevalence.keySet().toList() == ['population', 'sample'] } },
                { assert function.result.every { _token, details -> details.prevalence.values().every { requirement -> requirement in prevalenceRequirements } } },
                { assert function.result.every { _token, details -> details.trait_support.keySet().toList() == ['quantitative', 'binary'] } },
                { assert function.result.every { _token, details -> details.trait_support.quantitative || details.trait_support.binary } },
                { assert function.result.every { _token, details -> details.citation_keys instanceof List && details.citation_keys } },
            )
        }
    }

    test("the retired plink2 association selector leaves no registry entry") {
        function "getMethodCapabilities"
        tag "method_capabilities"

        then {
            assertAll(
                { assert function.success },
                { assert !function.result.containsKey('plink2') },
            )
        }
    }

    test("the association selector vocabulary is exactly the three wired routes") {
        function "getAssociationMethodTokens"
        tag "method_capabilities"

        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['regenie', 'gcta_fastgwa', 'ldak_kvik'] },
            )
        }
    }

    test("the retired generalised_linear_model estimator family is gone from the contract vocabulary") {
        function "getMethodCapabilityContract"
        tag "method_capabilities"

        then {
            // A targeted regression guard for this removal specifically: the `plink2` entry was the family's
            // only member. The general rule that no declared family may be memberless is enforced by the exact
            // set equality in "every registered method declares every capability field in the contract
            // vocabulary", against the vocabulary pinned in "the capability contract fixes one closed
            // vocabulary per declared field".
            assertAll(
                { assert function.success },
                { assert !function.result.estimator_families.contains('generalised_linear_model') },
            )
        }
    }

    test("the registry contains only fields with active consumers") {
        function "getMethodCapabilities"
        tag "method_capabilities"

        then {
            def activeFields = [
                'domain',
                'option_family',
                'matrix_kind',
                'endpoint_domain',
                'reference_family',
                'estimator_family',
                'input_backend',
                'trait_support',
                'supports_covariates',
                'prevalence',
                'citation_keys',
            ] as Set
            assertAll(
                { assert function.success },
                { assert function.result.every { _token, details -> activeFields.containsAll(details.keySet()) } },
            )
        }
    }

    test("the PLINK 1 compatibility route is derived from declared backends, not a repeated method list") {
        function "getPlink1GenotypeMethodTokens"
        tag "method_capabilities"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.sort() == [
                    'gcta_bivariate_he_ldms',
                    'gcta_bivariate_reml_ldms',
                    'gcta_greml_ldms',
                    'ldak_he',
                    'ldak_kvik',
                    'ldak_pcgc',
                    'ldak_reml',
                ] },
            )
        }
    }

    def capabilitySelections = [
        [name: 'the LDAK association estimator', required: [domain: 'association', option_family: 'ldak'], expected: ['ldak_kvik']],
        [name: 'the sparse-matrix association estimator', required: [domain: 'association', input_backend: 'sparse_grm'], expected: ['gcta_fastgwa']],
        [name: 'the GCTA GREML estimators', required: [domain: 'heritability', option_family: 'gcta', estimator_family: 'reml'], expected: ['gcta_greml', 'gcta_greml_ldms']],
        [name: 'the dense-GRM GCTA heritability estimator', required: [domain: 'heritability', option_family: 'gcta', input_backend: 'dense_grm'], expected: ['gcta_greml']],
        [name: 'the LDMS GCTA heritability estimator', required: [domain: 'heritability', input_backend: 'ldms_grm_family'], expected: ['gcta_greml_ldms']],
        [name: 'the LDAK kinship heritability estimators', required: [domain: 'heritability', input_backend: 'ldak_kinship'], expected: ['ldak_reml', 'ldak_he', 'ldak_pcgc']],
        [name: 'the LDSC estimators', required: [option_family: 'ldsc'], expected: ['ldsc_h2', 'ldsc_rg']],
        [name: 'the LDAK summary estimators', required: [option_family: 'ldak', input_backend: 'summary_statistics'], expected: ['ldak_sumher', 'ldak_sumcors']],
        [name: 'the LDAK summary pair estimator', required: [domain: 'pairwise', reference_family: 'ldak'], expected: ['ldak_sumcors']],
        [name: 'the REGENIE association estimator', required: [domain: 'association', option_family: 'regenie'], expected: ['regenie']],
    ]

    capabilitySelections.each { scenario ->
        test("capability selection resolves ${scenario.name}") {
            function "getMethodTokensWithCapabilities"
            tag "method_capabilities"

            when {
                function {
                    """
                    input[0] = ${scenario.required.inspect()}
                    """
                }
            }

            then {
                assertAll(
                    { assert function.success },
                    { assert function.result == scenario.expected },
                )
            }
        }
    }

    test("capability selection refuses an unregistered field rather than silently matching nothing") {
        function "getMethodTokensWithCapabilities"
        tag "method_capabilities"

        when {
            function {
                """
                input[0] = [mystery_capability: true]
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.join('\n').contains("unregistered field 'mystery_capability'") },
            )
        }
    }
}

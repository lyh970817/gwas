nextflow_function {

    name "Test linked GWAS input contract functions"
    script "../method_registry.nf"
    tag "function"
    tag "input"

    test("quantitative fastGWA maps the native beta and sample-count columns") {
        function "getAssociationColumnMappingJson"

        when {
            function {
                """
                input[0] = 'gcta_fastgwa'
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert new groovy.json.JsonSlurper().parseText(function.result) == [
                    snpid: 'SNP',
                    chrom: 'CHR',
                    pos: 'POS',
                    ea: 'A1',
                    nea: 'A2',
                    eaf: 'AF1',
                    n: 'N',
                    beta: 'BETA',
                    se: 'SE',
                    p: 'P',
                ] },
            )
        }
    }

    test("binary fastGWA retains the native beta mapping without inventing an odds-ratio column") {
        function "getAssociationColumnMappingJson"

        when {
            function {
                """
                input[0] = 'gcta_fastgwa'
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert new groovy.json.JsonSlurper().parseText(function.result) == [
                    snpid: 'SNP',
                    chrom: 'CHR',
                    pos: 'POS',
                    ea: 'A1',
                    nea: 'A2',
                    eaf: 'AF1',
                    n: 'N',
                    beta: 'BETA',
                    se: 'SE',
                    p: 'P',
                ] },
            )
        }
    }

    test("quantitative KVIK maps its A1 frequency and effective analysis size without an extra Z field") {
        function "getAssociationColumnMappingJson"
        tag "kvik_mapping"

        when {
            function {
                """
                input[0] = 'ldak_kvik'
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert new groovy.json.JsonSlurper().parseText(function.result) == [
                    snpid: 'Predictor',
                    chrom: 'Chromosome',
                    pos: 'Basepair',
                    ea: 'A1',
                    nea: 'A2',
                    eaf: 'EAF',
                    neff: 'N',
                    p: 'Wald_P',
                    beta: 'Effect',
                    se: 'SE',
                ] },
            )
        }
    }

    test("the association mapping registry preserves its established public projection") {
        function "getAssociationColumnMappings"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.keySet().toList() == ['plink2', 'regenie', 'gcta_fastgwa', 'ldak_kvik'] },
                { assert function.result.values().every { mapping -> mapping.keySet().every { section -> section in ['common', 'quantitative', 'binary'] } } },
                { assert function.result.plink2.keySet().toList() == ['common'] },
                { assert function.result.ldak_kvik.keySet().toList() == ['common', 'quantitative', 'binary'] },
            )
        }
    }

    test("method capabilities retain selector, matrix, prevalence and citation knowledge") {
        function "getMethodCapabilities"
        tag "summary_capabilities"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.keySet().toList() == [
                    'plink2',
                    'regenie',
                    'gcta_fastgwa',
                    'ldak_kvik',
                    'gcta_greml',
                    'gcta_greml_ldms',
                    'gcta_bivariate_reml',
                    'gcta_bivariate_reml_ldms',
                    'gcta_bivariate_he',
                    'gcta_bivariate_he_ldms',
                    'ldak_sumher',
                    'ldak_sumcors',
                    'ldsc_h2',
                    'ldsc_rg',
                    'ldak_reml',
                    'ldak_he',
                    'ldak_pcgc',
                ] },
                { assert function.result.gcta_fastgwa.matrix_kind == 'gcta_sparse' },
                { assert function.result.gcta_greml.matrix_kind == 'gcta_dense' },
                { assert function.result.gcta_greml_ldms.matrix_kind == 'gcta_ldms' },
                { assert function.result.gcta_bivariate_reml.domain == 'pairwise' },
                { assert function.result.gcta_bivariate_reml.matrix_kind == 'gcta_dense' },
                { assert function.result.gcta_bivariate_reml_ldms.domain == 'pairwise' },
                { assert function.result.gcta_bivariate_reml_ldms.matrix_kind == 'gcta_ldms' },
                // Each Haseman-Elston selector consumes the same relatedness backend as its REML sibling,
                // which is what makes selecting the two together cost one matrix construction. Both are
                // quantitative-only and neither can honour a covariate file.
                { assert function.result.gcta_bivariate_he.domain == 'pairwise' },
                { assert function.result.gcta_bivariate_he.matrix_kind == 'gcta_dense' },
                { assert function.result.gcta_bivariate_he.estimator_family == 'moment_he' },
                { assert function.result.gcta_bivariate_he.trait_support == [quantitative: true, binary: false, binary_requires: []] },
                { assert function.result.gcta_bivariate_he.supports_covariates == false },
                { assert !function.result.gcta_bivariate_he.consumes_population_prevalence },
                { assert function.result.gcta_bivariate_he_ldms.matrix_kind == 'gcta_ldms' },
                { assert function.result.gcta_bivariate_he_ldms.component_model == 'ldms_multi_component' },
                { assert function.result.gcta_bivariate_he_ldms.citation_keys == ['gcta_hereg', 'gcta_greml_ldms'] },
                { assert function.result.ldak_sumher.domain == 'summary_unary' },
                { assert function.result.ldak_sumher.reference_family == 'ldak' },
                { assert function.result.ldak_sumher.consumes_population_prevalence },
                { assert function.result.ldak_sumcors.endpoint_domain == 'summary_statistics' },
                { assert function.result.ldak_sumcors.consumes_population_prevalence },
                { assert function.result.ldak_sumcors.consumes_sample_prevalence },
                { assert function.result.ldsc_h2.reference_family == 'ldsc' },
                { assert function.result.ldsc_h2.consumes_sample_prevalence },
                { assert function.result.ldsc_rg.endpoint_domain == 'summary_statistics' },
                { assert function.result.ldsc_rg.consumes_population_prevalence },
                { assert function.result.ldsc_rg.consumes_sample_prevalence },
                { assert function.result.ldak_reml.matrix_kind == 'ldak_kinship' },
                { assert function.result.ldak_pcgc.requires_population_prevalence },
                { assert function.result.ldak_he.citation_key == function.result.ldak_pcgc.citation_key },
            )
        }
    }

    test("the capability contract fixes one closed vocabulary per declared field") {
        function "getMethodCapabilityContract"
        tag "method_capabilities"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.required_fields == [
                    'domain',
                    'estimator_family',
                    'input_backend',
                    'component_model',
                    'trait_support',
                    'stochastic',
                    'produces_likelihood',
                    'supports_partial_overlap',
                    'reference_strictness',
                    'requires_prevalence',
                    'produces_reusable_intermediates',
                    'role',
                    'citation_key',
                ] },
                { assert function.result.input_backends == [
                    'dense_grm',
                    'ldms_grm_family',
                    'ldak_kinship',
                    'sparse_grm',
                    'direct_plink_genotypes',
                    'summary_statistics',
                ] },
                { assert function.result.component_models == ['not_applicable', 'single_component', 'ldms_multi_component', 'tagging_model_defined'] },
                { assert function.result.prevalence_requirements == ['not_consumed', 'consumed', 'required'] },
                { assert function.result.reference_strictness == ['tolerant', 'model_matched', 'strict'] },
                { assert function.result.trait_support_fields == ['quantitative', 'binary', 'binary_requires'] },
            )
        }
    }

    test("every registered method declares every capability field in the contract vocabulary") {
        function "getMethodCapabilities"
        tag "method_capabilities"

        then {
            def requiredFields = [
                'domain',
                'estimator_family',
                'input_backend',
                'component_model',
                'trait_support',
                'stochastic',
                'produces_likelihood',
                'supports_partial_overlap',
                'reference_strictness',
                'requires_prevalence',
                'produces_reusable_intermediates',
                'role',
                'citation_key',
            ]
            def estimatorFamilies = [
                'generalised_linear_model',
                'whole_genome_regression',
                'mixed_linear_model',
                'reml',
                'moment_he',
                'pcgc',
                'ld_score_regression',
                'summary_tagging_regression',
            ]
            def inputBackends = [
                'dense_grm',
                'ldms_grm_family',
                'ldak_kinship',
                'sparse_grm',
                'direct_plink_genotypes',
                'summary_statistics',
            ]
            def componentModels = ['not_applicable', 'single_component', 'ldms_multi_component', 'tagging_model_defined']
            def prevalenceRequirements = ['not_consumed', 'consumed', 'required']
            assertAll(
                { assert function.success },
                { assert function.result.every { _token, details -> requiredFields.every { field -> details.containsKey(field) } } },
                { assert function.result.every { _token, details -> details.estimator_family in estimatorFamilies } },
                { assert function.result.every { _token, details -> details.input_backend in inputBackends } },
                { assert function.result.every { _token, details -> details.component_model in componentModels } },
                { assert function.result.every { _token, details -> details.role instanceof String && details.role.trim() } },
                { assert function.result.every { _token, details -> details.stochastic instanceof Boolean } },
                { assert function.result.every { _token, details -> details.produces_likelihood instanceof Boolean } },
                { assert function.result.every { _token, details -> details.produces_reusable_intermediates instanceof Boolean } },
                { assert function.result.every { _token, details -> details.requires_prevalence.keySet().toList() == ['population', 'sample'] } },
                { assert function.result.every { _token, details -> details.requires_prevalence.values().every { requirement -> requirement in prevalenceRequirements } } },
                { assert function.result.every { _token, details -> details.trait_support.keySet().toList() == ['quantitative', 'binary', 'binary_requires'] } },
                { assert function.result.every { _token, details -> details.trait_support.quantitative || details.trait_support.binary } },
            )
        }
    }

    test("declared capability fields agree with the established routing and prevalence contract") {
        function "getMethodCapabilities"
        tag "method_capabilities"

        then {
            assertAll(
                { assert function.success },
                // A reusable matrix or trace artifact exists exactly when a matrix kind is registered.
                { assert function.result.every { _token, details -> details.produces_reusable_intermediates == (details.matrix_kind != null) } },
                // Only a pairwise estimator can answer the sample-overlap question.
                { assert function.result.every { _token, details -> (details.supports_partial_overlap != null) == (details.domain == 'pairwise') } },
                // Only a method staging an external LD reference carries a strictness grade.
                { assert function.result.every { _token, details -> (details.reference_strictness != null) == (details.reference_family != null) } },
                { assert function.result.every { _token, details -> (details.requires_prevalence.population != 'not_consumed') == (details.consumes_population_prevalence == true) } },
                { assert function.result.every { _token, details -> (details.requires_prevalence.population == 'required') == (details.requires_population_prevalence == true) } },
                { assert function.result.every { _token, details -> (details.requires_prevalence.sample != 'not_consumed') == (details.consumes_sample_prevalence == true) } },
                { assert function.result.every { _token, details -> details.trait_support.binary_requires.every { field -> field in ['population_prevalence', 'sample_prevalence'] } } },
                // A binary-only estimator must state what makes it binary-only.
                { assert function.result.every { _token, details -> details.trait_support.quantitative || details.trait_support.binary_requires } },
            )
        }
    }

    def backendRepresentatives = [
        [
            name: 'GCTA GREML on one dense GRM',
            method: 'gcta_greml',
            expected: [
                estimator_family: 'reml',
                input_backend: 'dense_grm',
                component_model: 'single_component',
                produces_likelihood: true,
                produces_reusable_intermediates: true,
                stochastic: false,
                supports_partial_overlap: null,
                reference_strictness: null,
            ],
        ],
        [
            name: 'GCTA GREML-LDMS on the stratified GRM family',
            method: 'gcta_greml_ldms',
            expected: [
                estimator_family: 'reml',
                input_backend: 'ldms_grm_family',
                component_model: 'ldms_multi_component',
                produces_likelihood: true,
                produces_reusable_intermediates: true,
                stochastic: false,
                supports_partial_overlap: null,
                reference_strictness: null,
            ],
        ],
        [
            name: 'LDAK Haseman-Elston on a prebuilt kinship',
            method: 'ldak_he',
            expected: [
                estimator_family: 'moment_he',
                input_backend: 'ldak_kinship',
                component_model: 'single_component',
                produces_likelihood: false,
                produces_reusable_intermediates: true,
                stochastic: true,
                supports_partial_overlap: null,
                reference_strictness: null,
            ],
        ],
        [
            name: 'GCTA fastGWA against a sparse relatedness matrix',
            method: 'gcta_fastgwa',
            expected: [
                estimator_family: 'mixed_linear_model',
                input_backend: 'sparse_grm',
                component_model: 'single_component',
                produces_likelihood: false,
                produces_reusable_intermediates: true,
                stochastic: false,
                supports_partial_overlap: null,
                reference_strictness: null,
            ],
        ],
        [
            name: 'LDAK KVIK streaming genotypes without a prebuilt matrix',
            method: 'ldak_kvik',
            expected: [
                estimator_family: 'mixed_linear_model',
                input_backend: 'direct_plink_genotypes',
                component_model: 'single_component',
                produces_likelihood: false,
                produces_reusable_intermediates: false,
                stochastic: true,
                supports_partial_overlap: null,
                reference_strictness: null,
            ],
        ],
        [
            name: 'LDSC heritability from summary statistics and an external reference',
            method: 'ldsc_h2',
            expected: [
                estimator_family: 'ld_score_regression',
                input_backend: 'summary_statistics',
                component_model: 'single_component',
                produces_likelihood: false,
                produces_reusable_intermediates: false,
                stochastic: false,
                supports_partial_overlap: null,
                reference_strictness: 'tolerant',
            ],
        ],
        [
            name: 'LDSC genetic correlation across two overlapping summary results',
            method: 'ldsc_rg',
            expected: [
                estimator_family: 'ld_score_regression',
                input_backend: 'summary_statistics',
                component_model: 'single_component',
                produces_likelihood: false,
                produces_reusable_intermediates: false,
                stochastic: false,
                supports_partial_overlap: true,
                reference_strictness: 'tolerant',
            ],
        ],
    ]

    backendRepresentatives.each { scenario ->
        test("capabilities describe ${scenario.name}") {
            function "getMethodCapabilities"
            tag "method_capabilities"

            then {
                def details = function.result[scenario.method]
                assertAll(
                    { assert function.success },
                    { assert details },
                    { assert scenario.expected.every { field, value -> details[field] == value } },
                )
            }
        }
    }

    test("the PLINK 1 compatibility route is derived from declared backends, not a repeated method list") {
        function "getPlink1GenotypeMethodTokens"
        tag "method_capabilities"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.sort() == [
                    'gcta_bivariate_he_ldms',
                    'gcta_bivariate_reml_ldms',
                    'gcta_greml_ldms',
                    'ldak_he',
                    'ldak_kvik',
                    'ldak_pcgc',
                    'ldak_reml',
                ] },
            )
        }
    }

    def capabilitySelections = [
        [name: 'the LDAK association estimator', required: [domain: 'association', option_family: 'ldak'], expected: ['ldak_kvik']],
        [name: 'the sparse-matrix association estimator', required: [domain: 'association', input_backend: 'sparse_grm'], expected: ['gcta_fastgwa']],
        [name: 'the GCTA GREML estimators', required: [domain: 'heritability', option_family: 'gcta', estimator_family: 'reml'], expected: ['gcta_greml', 'gcta_greml_ldms']],
        [name: 'the dense-GRM GCTA heritability estimator', required: [domain: 'heritability', option_family: 'gcta', input_backend: 'dense_grm'], expected: ['gcta_greml']],
        [name: 'the LDMS GCTA heritability estimator', required: [domain: 'heritability', input_backend: 'ldms_grm_family'], expected: ['gcta_greml_ldms']],
        [name: 'the LDAK kinship heritability estimators', required: [domain: 'heritability', input_backend: 'ldak_kinship'], expected: ['ldak_reml', 'ldak_he', 'ldak_pcgc']],
        [name: 'the LDSC estimators', required: [option_family: 'ldsc'], expected: ['ldsc_h2', 'ldsc_rg']],
        [name: 'the LDAK summary estimators', required: [option_family: 'ldak', input_backend: 'summary_statistics'], expected: ['ldak_sumher', 'ldak_sumcors']],
        [name: 'the LDAK summary pair estimator', required: [domain: 'pairwise', reference_family: 'ldak'], expected: ['ldak_sumcors']],
        [name: 'the REGENIE association estimator', required: [domain: 'association', option_family: 'regenie'], expected: ['regenie']],
    ]

    capabilitySelections.each { scenario ->
        test("capability selection resolves ${scenario.name}") {
            function "getMethodTokensWithCapabilities"
            tag "method_capabilities"

            when {
                function {
                    """
                    input[0] = ${scenario.required.inspect()}
                    """
                }
            }

            then {
                assertAll(
                    { assert function.success },
                    { assert function.result == scenario.expected },
                )
            }
        }
    }

    test("capability selection refuses an unregistered field rather than silently matching nothing") {
        function "getMethodTokensWithCapabilities"
        tag "method_capabilities"

        when {
            function {
                """
                input[0] = [mystery_capability: true]
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.join('\n').contains("unregistered field 'mystery_capability'") },
            )
        }
    }
}

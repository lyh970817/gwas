nextflow_function {

    name "Test linked GWAS input contract functions"
    script "../main.nf"
    tag "function"
    tag "input"

    test("quantitative fastGWA maps the native beta and sample-count columns") {
        function "getAssociationColumnMappingJson"

        when {
            function {
                """
                input[0] = 'gcta_fastgwa'
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert new groovy.json.JsonSlurper().parseText(function.result) == [
                    snpid: 'SNP',
                    chrom: 'CHR',
                    pos: 'POS',
                    ea: 'A1',
                    nea: 'A2',
                    eaf: 'AF1',
                    n: 'N',
                    beta: 'BETA',
                    se: 'SE',
                    p: 'P',
                ] },
            )
        }
    }

    test("binary fastGWA retains the native beta mapping without inventing an odds-ratio column") {
        function "getAssociationColumnMappingJson"

        when {
            function {
                """
                input[0] = 'gcta_fastgwa'
                input[1] = true
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert new groovy.json.JsonSlurper().parseText(function.result) == [
                    snpid: 'SNP',
                    chrom: 'CHR',
                    pos: 'POS',
                    ea: 'A1',
                    nea: 'A2',
                    eaf: 'AF1',
                    n: 'N',
                    beta: 'BETA',
                    se: 'SE',
                    p: 'P',
                ] },
            )
        }
    }

    test("quantitative KVIK maps its A1 frequency and effective analysis size without an extra Z field") {
        function "getAssociationColumnMappingJson"
        tag "kvik_mapping"

        when {
            function {
                """
                input[0] = 'ldak_kvik'
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert new groovy.json.JsonSlurper().parseText(function.result) == [
                    snpid: 'Predictor',
                    chrom: 'Chromosome',
                    pos: 'Basepair',
                    ea: 'A1',
                    nea: 'A2',
                    eaf: 'EAF',
                    neff: 'N',
                    p: 'Wald_P',
                    beta: 'Effect',
                    se: 'SE',
                ] },
            )
        }
    }

    test("the association mapping registry preserves its established public projection") {
        function "getAssociationColumnMappings"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.keySet().toList() == ['plink2', 'regenie', 'gcta_fastgwa', 'ldak_kvik'] },
                { assert function.result.values().every { mapping -> mapping.keySet().every { section -> section in ['common', 'quantitative', 'binary'] } } },
                { assert function.result.plink2.keySet().toList() == ['common'] },
                { assert function.result.ldak_kvik.keySet().toList() == ['common', 'quantitative', 'binary'] },
            )
        }
    }

    test("method capabilities retain selector, matrix, prevalence and citation knowledge") {
        function "getMethodCapabilities"
        tag "summary_capabilities"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.keySet().toList() == [
                    'plink2',
                    'regenie',
                    'gcta_fastgwa',
                    'ldak_kvik',
                    'gcta_greml',
                    'gcta_greml_ldms',
                    'gcta_bivariate_reml',
                    'gcta_bivariate_reml_ldms',
                    'ldak_sumher',
                    'ldak_sumcors',
                    'ldsc_h2',
                    'ldsc_rg',
                    'ldak_reml',
                    'ldak_he',
                    'ldak_pcgc',
                ] },
                { assert function.result.gcta_fastgwa.matrix_kind == 'gcta_sparse' },
                { assert function.result.gcta_greml.matrix_kind == 'gcta_dense' },
                { assert function.result.gcta_greml_ldms.matrix_kind == 'gcta_ldms' },
                { assert function.result.gcta_bivariate_reml.domain == 'pairwise' },
                { assert function.result.gcta_bivariate_reml.matrix_kind == 'gcta_dense' },
                { assert function.result.gcta_bivariate_reml_ldms.domain == 'pairwise' },
                { assert function.result.gcta_bivariate_reml_ldms.matrix_kind == 'gcta_ldms' },
                { assert function.result.ldak_sumher.domain == 'summary_unary' },
                { assert function.result.ldak_sumher.reference_family == 'ldak' },
                { assert function.result.ldak_sumher.consumes_population_prevalence },
                { assert function.result.ldak_sumcors.endpoint_domain == 'summary_statistics' },
                { assert function.result.ldak_sumcors.consumes_population_prevalence },
                { assert function.result.ldak_sumcors.consumes_sample_prevalence },
                { assert function.result.ldsc_h2.reference_family == 'ldsc' },
                { assert function.result.ldsc_h2.consumes_sample_prevalence },
                { assert function.result.ldsc_rg.endpoint_domain == 'summary_statistics' },
                { assert function.result.ldsc_rg.consumes_population_prevalence },
                { assert function.result.ldsc_rg.consumes_sample_prevalence },
                { assert function.result.ldak_reml.matrix_kind == 'ldak_kinship' },
                { assert function.result.ldak_pcgc.requires_population_prevalence },
                { assert function.result.ldak_he.citation_key == function.result.ldak_pcgc.citation_key },
            )
        }
    }

    test("the capability contract fixes one closed vocabulary per declared field") {
        function "getMethodCapabilityContract"
        tag "method_capabilities"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.required_fields == [
                    'domain',
                    'estimator_family',
                    'input_backend',
                    'component_model',
                    'trait_support',
                    'stochastic',
                    'produces_likelihood',
                    'supports_partial_overlap',
                    'reference_strictness',
                    'requires_prevalence',
                    'produces_reusable_intermediates',
                    'role',
                    'citation_key',
                ] },
                { assert function.result.input_backends == [
                    'dense_grm',
                    'ldms_grm_family',
                    'ldak_kinship',
                    'sparse_grm',
                    'direct_plink_genotypes',
                    'summary_statistics',
                ] },
                { assert function.result.component_models == ['not_applicable', 'single_component', 'ldms_multi_component', 'tagging_model_defined'] },
                { assert function.result.prevalence_requirements == ['not_consumed', 'consumed', 'required'] },
                { assert function.result.reference_strictness == ['tolerant', 'model_matched', 'strict'] },
                { assert function.result.trait_support_fields == ['quantitative', 'binary', 'binary_requires'] },
            )
        }
    }

    test("every registered method declares every capability field in the contract vocabulary") {
        function "getMethodCapabilities"
        tag "method_capabilities"

        then {
            def requiredFields = [
                'domain',
                'estimator_family',
                'input_backend',
                'component_model',
                'trait_support',
                'stochastic',
                'produces_likelihood',
                'supports_partial_overlap',
                'reference_strictness',
                'requires_prevalence',
                'produces_reusable_intermediates',
                'role',
                'citation_key',
            ]
            def estimatorFamilies = [
                'generalised_linear_model',
                'whole_genome_regression',
                'mixed_linear_model',
                'reml',
                'moment_he',
                'pcgc',
                'ld_score_regression',
                'summary_tagging_regression',
            ]
            def inputBackends = [
                'dense_grm',
                'ldms_grm_family',
                'ldak_kinship',
                'sparse_grm',
                'direct_plink_genotypes',
                'summary_statistics',
            ]
            def componentModels = ['not_applicable', 'single_component', 'ldms_multi_component', 'tagging_model_defined']
            def prevalenceRequirements = ['not_consumed', 'consumed', 'required']
            assertAll(
                { assert function.success },
                { assert function.result.every { _token, details -> requiredFields.every { field -> details.containsKey(field) } } },
                { assert function.result.every { _token, details -> details.estimator_family in estimatorFamilies } },
                { assert function.result.every { _token, details -> details.input_backend in inputBackends } },
                { assert function.result.every { _token, details -> details.component_model in componentModels } },
                { assert function.result.every { _token, details -> details.role instanceof String && details.role.trim() } },
                { assert function.result.every { _token, details -> details.stochastic instanceof Boolean } },
                { assert function.result.every { _token, details -> details.produces_likelihood instanceof Boolean } },
                { assert function.result.every { _token, details -> details.produces_reusable_intermediates instanceof Boolean } },
                { assert function.result.every { _token, details -> details.requires_prevalence.keySet().toList() == ['population', 'sample'] } },
                { assert function.result.every { _token, details -> details.requires_prevalence.values().every { requirement -> requirement in prevalenceRequirements } } },
                { assert function.result.every { _token, details -> details.trait_support.keySet().toList() == ['quantitative', 'binary', 'binary_requires'] } },
                { assert function.result.every { _token, details -> details.trait_support.quantitative || details.trait_support.binary } },
            )
        }
    }

    test("declared capability fields agree with the established routing and prevalence contract") {
        function "getMethodCapabilities"
        tag "method_capabilities"

        then {
            assertAll(
                { assert function.success },
                // A reusable matrix or trace artifact exists exactly when a matrix kind is registered.
                { assert function.result.every { _token, details -> details.produces_reusable_intermediates == (details.matrix_kind != null) } },
                // Only a pairwise estimator can answer the sample-overlap question.
                { assert function.result.every { _token, details -> (details.supports_partial_overlap != null) == (details.domain == 'pairwise') } },
                // Only a method staging an external LD reference carries a strictness grade.
                { assert function.result.every { _token, details -> (details.reference_strictness != null) == (details.reference_family != null) } },
                { assert function.result.every { _token, details -> (details.requires_prevalence.population != 'not_consumed') == (details.consumes_population_prevalence == true) } },
                { assert function.result.every { _token, details -> (details.requires_prevalence.population == 'required') == (details.requires_population_prevalence == true) } },
                { assert function.result.every { _token, details -> (details.requires_prevalence.sample != 'not_consumed') == (details.consumes_sample_prevalence == true) } },
                { assert function.result.every { _token, details -> details.trait_support.binary_requires.every { field -> field in ['population_prevalence', 'sample_prevalence'] } } },
                // A binary-only estimator must state what makes it binary-only.
                { assert function.result.every { _token, details -> details.trait_support.quantitative || details.trait_support.binary_requires } },
            )
        }
    }

    def backendRepresentatives = [
        [
            name: 'GCTA GREML on one dense GRM',
            method: 'gcta_greml',
            expected: [
                estimator_family: 'reml',
                input_backend: 'dense_grm',
                component_model: 'single_component',
                produces_likelihood: true,
                produces_reusable_intermediates: true,
                stochastic: false,
                supports_partial_overlap: null,
                reference_strictness: null,
            ],
        ],
        [
            name: 'GCTA GREML-LDMS on the stratified GRM family',
            method: 'gcta_greml_ldms',
            expected: [
                estimator_family: 'reml',
                input_backend: 'ldms_grm_family',
                component_model: 'ldms_multi_component',
                produces_likelihood: true,
                produces_reusable_intermediates: true,
                stochastic: false,
                supports_partial_overlap: null,
                reference_strictness: null,
            ],
        ],
        [
            name: 'LDAK Haseman-Elston on a prebuilt kinship',
            method: 'ldak_he',
            expected: [
                estimator_family: 'moment_he',
                input_backend: 'ldak_kinship',
                component_model: 'single_component',
                produces_likelihood: false,
                produces_reusable_intermediates: true,
                stochastic: true,
                supports_partial_overlap: null,
                reference_strictness: null,
            ],
        ],
        [
            name: 'GCTA fastGWA against a sparse relatedness matrix',
            method: 'gcta_fastgwa',
            expected: [
                estimator_family: 'mixed_linear_model',
                input_backend: 'sparse_grm',
                component_model: 'single_component',
                produces_likelihood: false,
                produces_reusable_intermediates: true,
                stochastic: false,
                supports_partial_overlap: null,
                reference_strictness: null,
            ],
        ],
        [
            name: 'LDAK KVIK streaming genotypes without a prebuilt matrix',
            method: 'ldak_kvik',
            expected: [
                estimator_family: 'mixed_linear_model',
                input_backend: 'direct_plink_genotypes',
                component_model: 'single_component',
                produces_likelihood: false,
                produces_reusable_intermediates: false,
                stochastic: true,
                supports_partial_overlap: null,
                reference_strictness: null,
            ],
        ],
        [
            name: 'LDSC heritability from summary statistics and an external reference',
            method: 'ldsc_h2',
            expected: [
                estimator_family: 'ld_score_regression',
                input_backend: 'summary_statistics',
                component_model: 'single_component',
                produces_likelihood: false,
                produces_reusable_intermediates: false,
                stochastic: false,
                supports_partial_overlap: null,
                reference_strictness: 'tolerant',
            ],
        ],
        [
            name: 'LDSC genetic correlation across two overlapping summary results',
            method: 'ldsc_rg',
            expected: [
                estimator_family: 'ld_score_regression',
                input_backend: 'summary_statistics',
                component_model: 'single_component',
                produces_likelihood: false,
                produces_reusable_intermediates: false,
                stochastic: false,
                supports_partial_overlap: true,
                reference_strictness: 'tolerant',
            ],
        ],
    ]

    backendRepresentatives.each { scenario ->
        test("capabilities describe ${scenario.name}") {
            function "getMethodCapabilities"
            tag "method_capabilities"

            then {
                def details = function.result[scenario.method]
                assertAll(
                    { assert function.success },
                    { assert details },
                    { assert scenario.expected.every { field, value -> details[field] == value } },
                )
            }
        }
    }

    test("the PLINK 1 compatibility route is derived from declared backends, not a repeated method list") {
        function "getPlink1GenotypeMethodTokens"
        tag "method_capabilities"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.sort() == [
                    'gcta_bivariate_reml_ldms',
                    'gcta_greml_ldms',
                    'ldak_he',
                    'ldak_kvik',
                    'ldak_pcgc',
                    'ldak_reml',
                ] },
            )
        }
    }

    def capabilitySelections = [
        [name: 'the LDAK association estimator', required: [domain: 'association', option_family: 'ldak'], expected: ['ldak_kvik']],
        [name: 'the sparse-matrix association estimator', required: [domain: 'association', input_backend: 'sparse_grm'], expected: ['gcta_fastgwa']],
        [name: 'the GCTA GREML estimators', required: [domain: 'heritability', option_family: 'gcta', estimator_family: 'reml'], expected: ['gcta_greml', 'gcta_greml_ldms']],
        [name: 'the dense-GRM GCTA heritability estimator', required: [domain: 'heritability', option_family: 'gcta', input_backend: 'dense_grm'], expected: ['gcta_greml']],
        [name: 'the LDMS GCTA heritability estimator', required: [domain: 'heritability', input_backend: 'ldms_grm_family'], expected: ['gcta_greml_ldms']],
        [name: 'the LDAK kinship heritability estimators', required: [domain: 'heritability', input_backend: 'ldak_kinship'], expected: ['ldak_reml', 'ldak_he', 'ldak_pcgc']],
        [name: 'the LDSC estimators', required: [option_family: 'ldsc'], expected: ['ldsc_h2', 'ldsc_rg']],
        [name: 'the LDAK summary estimators', required: [option_family: 'ldak', input_backend: 'summary_statistics'], expected: ['ldak_sumher', 'ldak_sumcors']],
        [name: 'the LDAK summary pair estimator', required: [domain: 'pairwise', reference_family: 'ldak'], expected: ['ldak_sumcors']],
        [name: 'the REGENIE association estimator', required: [domain: 'association', option_family: 'regenie'], expected: ['regenie']],
    ]

    capabilitySelections.each { scenario ->
        test("capability selection resolves ${scenario.name}") {
            function "getMethodTokensWithCapabilities"
            tag "method_capabilities"

            when {
                function {
                    """
                    input[0] = ${scenario.required.inspect()}
                    """
                }
            }

            then {
                assertAll(
                    { assert function.success },
                    { assert function.result == scenario.expected },
                )
            }
        }
    }

    test("capability selection refuses an unregistered field rather than silently matching nothing") {
        function "getMethodTokensWithCapabilities"
        tag "method_capabilities"

        when {
            function {
                """
                input[0] = [mystery_capability: true]
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.join('\n').contains("unregistered field 'mystery_capability'") },
            )
        }
    }

    test("pair LDMS settings resolve independently of either endpoint analysis") {
        function "resolvePairLdmsMatrixSettings"

        when {
            function {
                """
                input[0] = [ld_score_region_kb: 50, ld_bins: 1, ldms_maf_edges: [0, 0.5]]
                input[1] = [ld_score_region_kb: 200, ld_bins: 4, maf_edges: [0, 0.01, 0.05, 0.2, 0.5]]
                input[2] = { option, reason -> error("\${option}: \${reason}") }
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == [ld_score_region_kb: 50, ld_bins: 1, maf_edges: [0, 0.5]] },
            )
        }
    }

    def invalidPairLdmsSettings = [
        [name: 'non-positive LD bins', options: [ld_bins: 0], expected: 'ld_bins: expected one positive integer'],
        [name: 'non-increasing MAF boundaries', options: [ldms_maf_edges: [0, 0.05, 0.01, 0.5]], expected: 'ldms_maf_edges: boundaries must be strictly increasing'],
    ]

    invalidPairLdmsSettings.each { scenario ->
        test("pair LDMS settings reject ${scenario.name}") {
            function "resolvePairLdmsMatrixSettings"

            when {
                function {
                    """
                    input[0] = ${scenario.options.inspect()}
                    input[1] = [ld_score_region_kb: 200, ld_bins: 4, maf_edges: [0, 0.01, 0.05, 0.2, 0.5]]
                    input[2] = { option, reason -> error("\${option}: \${reason}") }
                    """
                }
            }

            then {
                assertAll(
                    { assert function.failed },
                    { assert function.stdout.join('\n').contains(scenario.expected) },
                )
            }
        }
    }

    test("internal summary-statistics identities are explicit and deterministic") {
        function "getSummaryStatisticsId"

        when {
            function {
                """
                input[0] = 'analysis_a'
                input[1] = 'regenie'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'analysis_a--regenie' },
            )
        }
    }

    def prevalenceCases = [
        [
            name: 'quantitative pair omits prevalence',
            left: [is_binary: false, population_prevalence: null],
            right: [is_binary: false, population_prevalence: null],
            expected: [],
        ],
        [
            name: 'binary left mixed pair retains the sole prevalence',
            left: [is_binary: true, population_prevalence: 0.2],
            right: [is_binary: false, population_prevalence: null],
            expected: [0.2],
        ],
        [
            name: 'binary right mixed pair retains the sole prevalence',
            left: [is_binary: false, population_prevalence: null],
            right: [is_binary: true, population_prevalence: 0.1],
            expected: [0.1],
        ],
        [
            name: 'complete binary pair retains ordered prevalences',
            left: [is_binary: true, population_prevalence: 0.2],
            right: [is_binary: true, population_prevalence: 0.1],
            expected: [0.2, 0.1],
        ],
        [
            name: 'incomplete binary pair omits native conversion',
            left: [is_binary: true, population_prevalence: 0.2],
            right: [is_binary: true, population_prevalence: null],
            expected: [],
        ],
    ]

    prevalenceCases.each { scenario ->
        test("${scenario.name}") {
            function "getGctaBivariatePrevalence"

            when {
                function {
                    """
                    input[0] = new groovy.json.JsonSlurper().parseText('${groovy.json.JsonOutput.toJson(scenario.left)}')
                    input[1] = new groovy.json.JsonSlurper().parseText('${groovy.json.JsonOutput.toJson(scenario.right)}')
                    """
                }
            }

            then {
                assertAll(
                    { assert function.success },
                    { assert function.result == scenario.expected },
                )
            }
        }
    }

    test("the pair firewall permits non-file scientific GCTA arguments") {
        function "validateNativeArgumentTokens"

        when {
            function {
                """
                input[0] = 'method_options.json'
                input[1] = 'gcta_bivariate_reml--example'
                input[2] = ['--reml-maxit', '500', '--reml-bivar-nocove']
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['--reml-maxit', '500', '--reml-bivar-nocove'] },
            )
        }
    }

    def firewallCases = [
        [name: 'wrapper output', args: ['--out', 'hijacked'], expected: 'wrapper-owned invocation mechanics'],
        [name: 'alternate operation', args: ['--pca', '10'], expected: 'different primary GCTA operation'],
        [name: 'file-taking input', args: ['--keep', 'samples.txt'], expected: 'wrapper-owned invocation mechanics'],
        [name: 'undeclared file-like value', args: ['--mystery', 'samples.txt'], expected: 'undeclared file input'],
        [name: 'inline undeclared file-like value', args: ['--mystery=samples.txt'], expected: 'undeclared file input'],
        [name: 'path separator', args: ['--mystery', '../samples'], expected: 'path separator'],
        [name: 'environment assignment', args: ['--reml-maxit', 'KEY=value'], expected: 'environment assignment'],
    ]

    firewallCases.each { scenario ->
        test("the pair firewall rejects ${scenario.name}") {
            function "validateNativeArgumentTokens"

            when {
                function {
                    """
                    input[0] = 'method_options.json'
                    input[1] = 'gcta_bivariate_reml--example'
                    input[2] = ${groovy.json.JsonOutput.toJson(scenario.args)}
                    """
                }
            }

            then {
                assertAll(
                    { assert function.failed },
                    { assert function.stdout.join('\n').contains(scenario.expected) },
                )
            }
        }
    }

    test("the summary firewall rejects inline undeclared files") {
        function "validateSummaryNativeArgumentTokens"

        when {
            function {
                """
                input[0] = 'method_options.json'
                input[1] = 'unary_requests'
                input[2] = 'ldsc_h2--example'
                input[3] = 'ldsc_h2'
                input[4] = ['--mystery=samples.sumstats']
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.join('\n').contains('undeclared file input') },
            )
        }
    }

    test("the summary firewall permits non-file LDSC scientific arguments") {
        function "validateSummaryNativeArgumentTokens"

        when {
            function {
                """
                input[0] = 'method_options.json'
                input[1] = 'pair_requests'
                input[2] = 'ldsc_rg--example'
                input[3] = 'ldsc_rg'
                input[4] = ['--n-blocks', '20', '--intercept-gencov=0']
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['--n-blocks', '20', '--intercept-gencov=0'] },
            )
        }
    }

    def ldscFileOptions = [
        '--annot',
        '--bfile',
        '--cts-bin',
        '--extract',
        '--frqfile',
        '--frqfile-chr',
        '--h2-cts',
        '--keep',
        '--print-snps',
        '--ref-ld',
        '--ref-ld-chr-cts',
        '--w-ld',
    ]
    ['ldsc_h2', 'ldsc_rg'].each { method ->
        ldscFileOptions.each { option ->
            [
                [name: 'bare', args: [option, 'opaque_resource']],
                [name: 'inline', args: ["${option}=opaque_resource"]],
            ].each { form ->
                test("the ${method} firewall structurally rejects ${form.name} ${option}") {
                    function "validateSummaryNativeArgumentTokens"

                    when {
                        function {
                            """
                            input[0] = 'method_options.json'
                            input[1] = '${method == 'ldsc_h2' ? 'unary_requests' : 'pair_requests'}'
                            input[2] = '${method}--example'
                            input[3] = '${method}'
                            input[4] = ${groovy.json.JsonOutput.toJson(form.args)}
                            """
                        }
                    }

                    then {
                        assertAll(
                            { assert function.failed },
                            { assert function.stdout.join('\n').contains('requires a typed staged resource') },
                        )
                    }
                }
            }
        }

        test("the ${method} firewall rejects the alternate LD-score operation") {
            function "validateSummaryNativeArgumentTokens"

            when {
                function {
                    """
                    input[0] = 'method_options.json'
                    input[1] = '${method == 'ldsc_h2' ? 'unary_requests' : 'pair_requests'}'
                    input[2] = '${method}--example'
                    input[3] = '${method}'
                    input[4] = ['--l2']
                    """
                }
            }

            then {
                assertAll(
                    { assert function.failed },
                    { assert function.stdout.join('\n').contains("selects a different primary operation from wrapper-owned method '${method}'") },
                )
            }
        }

        test("the ${method} firewall rejects the other summary-statistics operation") {
            function "validateSummaryNativeArgumentTokens"

            when {
                function {
                    """
                    input[0] = 'method_options.json'
                    input[1] = '${method == 'ldsc_h2' ? 'unary_requests' : 'pair_requests'}'
                    input[2] = '${method}--example'
                    input[3] = '${method}'
                    input[4] = ['${method == 'ldsc_h2' ? '--rg' : '--h2'}']
                    """
                }
            }

            then {
                assertAll(
                    { assert function.failed },
                    { assert function.stdout.join('\n').contains("selects a different primary operation from wrapper-owned method '${method}'") },
                )
            }
        }
    }

    def ldscProtectedOptions = [
        ldsc_h2: [
            '--h2',
            '--ref-ld-chr',
            '--w-ld-chr',
            '--samp-prev',
            '--pop-prev',
            '--out',
            '--annot',
            '--bfile',
            '--cts-bin',
            '--extract',
            '--frqfile',
            '--frqfile-chr',
            '--h2-cts',
            '--keep',
            '--print-snps',
            '--ref-ld',
            '--ref-ld-chr-cts',
            '--w-ld',
            '--l2',
            '--rg',
        ],
        ldsc_rg: [
            '--rg',
            '--ref-ld-chr',
            '--w-ld-chr',
            '--samp-prev',
            '--pop-prev',
            '--out',
            '--annot',
            '--bfile',
            '--cts-bin',
            '--extract',
            '--frqfile',
            '--frqfile-chr',
            '--h2-cts',
            '--keep',
            '--print-snps',
            '--ref-ld',
            '--ref-ld-chr-cts',
            '--w-ld',
            '--l2',
            '--h2',
        ],
    ]
    ldscProtectedOptions.each { method, protectedOptions ->
        def protectedSet = protectedOptions.toSet()
        def properPrefixes = protectedOptions
            .collectMany { option -> (3..<option.size()).collect { prefixLength -> option.substring(0, prefixLength) } }
            .findAll { prefix -> !(prefix in protectedSet) }
            .toSet()
            .sort()
        def properPrefixArguments = properPrefixes
            .collectMany { prefix -> [prefix, "${prefix}=opaque_value"] }
            .sort()

        test("the ${method} matcher covers bare and inline forms of every proper protected-option prefix") {
            function "getLdscProtectedNativeArgumentMatches"
            tag "ldsc_prefix_firewall"

            when {
                function {
                    """
                    input[0] = '${method}'
                    input[1] = new groovy.json.JsonSlurper().parseText('${groovy.json.JsonOutput.toJson(properPrefixArguments)}')
                    """
                }
            }

            then {
                assertAll(
                    { assert function.success },
                    { assert function.result.keySet().toSet() == properPrefixArguments.toSet() },
                    { assert function.result.values().every { protection -> protection && !protection.exact } },
                    { assert function.result.every { _argument, protection -> protection.matches.any { match -> match.option.startsWith(protection.option_name) } } },
                )
            }
        }
    }

    def ldscAbbreviationExamples = [
        [name: 'annotation file', option: '--ann'],
        [name: 'binary genotype prefix', option: '--bfi'],
        [name: 'ambiguous category-bin prefix', option: '--cts-b'],
        [name: 'partitioned heritability input', option: '--h2-c'],
        [name: 'regression-weight reference', option: '--w-ld-c'],
        [name: 'ambiguous LD-score reference', option: '--ref-ld-c'],
        [name: 'LD-score operation', option: '--l'],
    ]
    ['ldsc_h2', 'ldsc_rg'].each { method ->
        def methodExamples = ldscAbbreviationExamples + [
            [
                name: method == 'ldsc_h2' ? 'ambiguous RG-operation/reference prefix' : 'alternate heritability-operation prefix',
                option: method == 'ldsc_h2' ? '--r' : '--h',
            ],
        ]
        methodExamples.each { scenario ->
            [
                [name: 'bare', token: scenario.option],
                [name: 'inline', token: "${scenario.option}=opaque_value"],
            ].each { form ->
                test("the ${method} firewall rejects ${form.name} ${scenario.name} abbreviation ${scenario.option}") {
                    function "validateSummaryNativeArgumentTokens"
                    tag "ldsc_prefix_firewall"

                    when {
                        function {
                            """
                            input[0] = 'method_options.json'
                            input[1] = '${method == 'ldsc_h2' ? 'unary_requests' : 'pair_requests'}'
                            input[2] = '${method}--example'
                            input[3] = '${method}'
                            input[4] = ['${form.token}']
                            """
                        }
                    }

                    then {
                        assertAll(
                            { assert function.failed },
                            { assert function.stdout.join('\n').contains('protected LDSC option abbreviation') },
                        )
                    }
                }
            }
        }
    }

    test("method option defaults have one canonical resolved shape") {
        function "getMethodOptionDefaults"

        then {
            assertAll(
                { assert function.success },
                { assert function.result.gcta == [
                    grm_maf: null,
                    grm_extract: [],
                    reml_no_constrain: false,
                    sparse_cutoff: 0.05,
                    ld_score_region_kb: 200,
                    ld_bins: 4,
                    ldms_maf_edges: [0, 0.01, 0.05, 0.2, 0.5],
                ] },
                { assert function.result.ldak == [
                    model: 'human_default',
                    power: -0.25,
                    weights_policy: 'equal',
                    weights: [],
                    relatedness_filter: false,
                    kvik_step1_subset: 'all',
                    predictor_extract: [],
                ] },
                { assert function.result.regenie == [
                    step1_bsize: 1000,
                    firth: true,
                    firth_approx: true,
                    firth_p_threshold: 0.01,
                    min_mac: null,
                ] },
            )
        }
    }

    test("method-family object errors retain GCTA-first attribution") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'family_object_order', [
                    example: [regenie: [], ldak: [], gcta: []],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: 'regenie,gcta_fastgwa', heritability_methods: 'ldak_reml', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            def report = function.stdout.join('\n')
            assertAll(
                { assert function.failed },
                { assert report.contains("option 'gcta': expected an option object") },
                { assert !report.contains("option 'ldak': expected an option object") },
                { assert !report.contains("option 'regenie': expected an option object") },
            )
        }
    }

    test("unknown options retain REGENIE-first attribution") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'unknown_option_order', [
                    example: [gcta: [mystery: true], ldak: [mystery: true], regenie: [mystery: true]],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: 'regenie,gcta_fastgwa', heritability_methods: 'ldak_reml', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            def report = function.stdout.join('\n')
            assertAll(
                { assert function.failed },
                { assert report.contains("option 'regenie.mystery': unknown option") },
                { assert !report.contains("option 'gcta.mystery': unknown option") },
                { assert !report.contains("option 'ldak.mystery': unknown option") },
            )
        }
    }

    test("invalid resolved values retain REGENIE-first attribution") {
        function "validateMethodOptions"

        when {
            function {
                """
                input[0] = file('${RELATIONAL.methodOptions(outputDir, 'resolution_order', [
                    example: [
                        gcta: [sparse_cutoff: 2],
                        ldak: [power: 'not-a-number'],
                        regenie: [step1_bsize: 1.5],
                    ],
                ])}', checkIfExists: true)
                input[1] = [[[id: 'example', association_methods: 'regenie,gcta_fastgwa', heritability_methods: 'ldak_reml', trait_type: 'quantitative']]]
                """
            }
        }

        then {
            def report = function.stdout.join('\n')
            assertAll(
                { assert function.failed },
                { assert report.contains("option 'regenie.step1_bsize': expected one positive integer") },
                { assert !report.contains("option 'gcta.sparse_cutoff'") },
                { assert !report.contains("option 'ldak.power'") },
            )
        }
    }
}

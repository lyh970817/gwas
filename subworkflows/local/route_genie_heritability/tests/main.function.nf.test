nextflow_function {

    name "Test GENIE route metadata restoration"
    script "../main.nf"
    tag "function"
    tag "heritability"
    tag "genie"

    test("the three route-local keys are stripped and nothing else is") {
        function "restoreFocalMeta"

        when {
            function {
                """
                input[0] = [
                    id: 'alpha',
                    cohort: 'cohort_a',
                    heritability_methods: ['genie_g'],
                    method_options: [genie: [seed: 7]],
                    genie_method: 'genie_g',
                    genie_capability: [option_family: 'genie'],
                    genie_effective: [native_args: ['-jn', '220', '-s', '7']],
                ]
                """
            }
        }

        then {
            // The route's own bookkeeping decides the prefix, the publication path and the native argument
            // list, so it has to reach the tasks -- and must not reach a consumer, which would otherwise join
            // on a key that exists only inside this controller.
            assertAll(
                { assert function.success },
                { assert function.result.keySet().toList().sort() == ['cohort', 'heritability_methods', 'id', 'method_options'] },
                { assert function.result.id == 'alpha' },
                { assert function.result.method_options == [genie: [seed: 7]] },
            )
        }
    }

    test("a meta that never carried a route-local key is returned unchanged") {
        function "restoreFocalMeta"

        when {
            function {
                """
                input[0] = [id: 'alpha', cohort: 'cohort_a', trait: 'QT']
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == [id: 'alpha', cohort: 'cohort_a', trait: 'QT'] },
            )
        }
    }
}

// Component-local test arguments, loaded explicitly from this subworkflow's test.
//
// The production `withName: 'PLINK2_VCF'` selector in `conf/modules/genotypes.config` reaches every process
// of that simple name, including the ones this test builds in a setup block, and it renders the pipeline's
// own import policy — which carries no `dosage=` modifier, deliberately. An aliased setup process escapes
// that selector, because a `withName` regex must match the simple name in full, so this is where a
// dosage-bearing PGEN can be built without changing what the pipeline itself imports.
process {
    withName: 'PHASED_DOSAGE_PGEN' {
        ext.args = 'dosage=HDS --double-id --vcf-half-call error'
    }
}

nextflow_function {

    name "Test REGENIE batch identity"
    script "../main.nf"
    tag "function"
    tag "regenie"
    tag "prediction"
    tag "batching"

    def resource = { outputDir, name, content ->
        def written = new File(outputDir.toString(), name)
        written.parentFile.mkdirs()
        written.text = content
        return written
    }

    // The three keys are pinned rather than only compared to each other. A key names a task, a cache entry
    // and a published path, so a silent change to what it covers -- or to how a value is rendered into it
    // -- would move results without anything failing. The pins make that a test failure and a deliberate
    // re-pin instead.

    test("the fit compatibility key covers every setting that must agree before analyses share a fit") {
        function "buildRegenieFitCompatibilityKey"

        when {
            function {
                """
                def fixtures = '${FIXTURES.base(projectDir)}results/fixtures/pheno_cov/'
                input[0] = 'prepared_view_a'
                input[1] = false
                input[2] = file(fixtures + 'example.qcovar', checkIfExists: true)
                input[3] = 'a1b2c3d4e5f6'
                input[4] = 1000
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == '5867469c7ee2' },
            )
        }
    }

    test("an absent covariate file is a declared value in the compatibility key, not a missing one") {
        function "buildRegenieFitCompatibilityKey"

        when {
            function {
                """
                input[0] = 'prepared_view_a'
                input[1] = false
                input[2] = []
                input[3] = 'a1b2c3d4e5f6'
                input[4] = 1000
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'b91185818c60' },
            )
        }
    }

    test("the fit batch key names its members and their content, so two member sets never collide") {
        function "buildRegenieFitBatchKey"

        when {
            function {
                """
                input[0] = 'aaaaaaaaaaaa'
                input[1] = [
                    [meta: [id: 'alpha'], phenotype_digest: '1111'],
                    [meta: [id: 'beta'], phenotype_digest: '2222'],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'c8ebbcb796d9' },
            )
        }
    }

    test("the fit batch key changes when a member's phenotype content changes") {
        function "buildRegenieFitBatchKey"

        when {
            function {
                """
                input[0] = 'aaaaaaaaaaaa'
                input[1] = [
                    [meta: [id: 'alpha'], phenotype_digest: '1111'],
                    [meta: [id: 'beta'], phenotype_digest: '3333'],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == '3fb482420df2' },
            )
        }
    }

    test("the test batch key separates sub-batches that disagree on an invocation-global Step 2 option") {
        function "buildRegenieTestBatchKey"

        when {
            function {
                """
                input[0] = 'aaaaaaaaaaaa'
                input[1] = [is_binary: false, firth: false, firth_approx: false, firth_p_threshold: null, min_mac: 5]
                input[2] = ['alpha', 'beta']
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == '06bf2994a800' },
            )
        }
    }

    def policyScenarios = [
        [
            name: 'a binary trait with approximate Firth',
            meta: "[is_binary: true, method_options: [regenie: [firth: true, firth_approx: true, firth_p_threshold: 0.01, min_mac: null]]]",
            expected: [is_binary: true, firth: true, firth_approx: true, firth_p_threshold: 0.01, min_mac: null],
        ],
        [
            name: 'a binary trait with Firth disabled',
            meta: "[is_binary: true, method_options: [regenie: [firth: false, firth_approx: true, firth_p_threshold: 0.01, min_mac: 5]]]",
            expected: [is_binary: true, firth: false, firth_approx: false, firth_p_threshold: null, min_mac: 5],
        ],
        [
            // Firth is a binary-trait option, so the quantitative policy folds it away entirely rather than
            // carrying a value the rendered command would never contain.
            name: 'a quantitative trait carrying binary-only options',
            meta: "[is_binary: false, method_options: [regenie: [firth: true, firth_approx: true, firth_p_threshold: 0.01, min_mac: null]]]",
            expected: [is_binary: false, firth: false, firth_approx: false, firth_p_threshold: null, min_mac: null],
        ],
    ]

    policyScenarios.each { scenario ->
        test("the Step 2 policy of ${scenario.name} is the effective command") {
            function "getRegenieStep2Policy"

            when {
                function {
                    """
                    input[0] = ${scenario.meta}
                    """
                }
            }

            then {
                assertAll(
                    { assert function.success },
                    { assert function.result == scenario.expected },
                )
            }
        }
    }

    test("the phenotype identity separates content from the sample set the compatibility key needs") {
        function "readPhenotypeIdentity"

        when {
            def prepared = resource(outputDir, 'identity/alpha.pheno', 'FID\tIID\tPHENO\nF1\tI1\t1.5\nF1\tI2\tNA\nF2\tI3\t3.5\n')
            function {
                """
                input[0] = file('${prepared}', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // The content digest stays the full-strength file digest the route has always used; the
                // sample-set digest is the canonical-text digest every other route key is built from.
                { assert function.result.content ==~ /^[0-9a-f]{64}$/ },
                { assert function.result.sample_set == '260164361f56' },
            )
        }
    }

    test("two analyses with different values over the same non-missing samples stay compatible") {
        function "readPhenotypeIdentity"

        when {
            def prepared = resource(outputDir, 'identity/beta.pheno', 'FID\tIID\tPHENO\nF1\tI1\t9.5\nF1\tI2\tNA\nF2\tI3\t7.5\n')
            function {
                """
                input[0] = file('${prepared}', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                // The same sample set as the case above, from different values: which is exactly the pair
                // that must share a fit, and exactly the pair whose batch key must still differ.
                { assert function.result.sample_set == '260164361f56' },
            )
        }
    }

    test("a native result is attributed to the analysis that named its column") {
        function "attributeRegenieResult"

        when {
            function {
                """
                input[0] = [id: 'regenie.abc123', phenotype_columns: ['alpha', 'beta']]
                input[1] = file('${outputDir}/regenie.abc123_beta.regenie.gz')
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'beta' },
            )
        }
    }

    test("a native result naming no phenotype column fails rather than being mis-attributed") {
        function "attributeRegenieResult"

        when {
            function {
                """
                input[0] = [id: 'regenie.abc123', phenotype_columns: ['alpha', 'beta']]
                input[1] = file('${outputDir}/regenie.abc123_gamma.regenie.gz')
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.join('\n').contains("names none of its phenotype columns 'alpha', 'beta'") },
            )
        }
    }

    test("a complete prediction list covers its batch") {
        function "validateRegenieFitPredictionCoverage"

        when {
            def predictions = resource(outputDir, 'coverage/complete_pred.list', 'alpha /work/fit_1.loco.gz\nbeta /work/fit_2.loco.gz\n')
            function {
                """
                input[0] = [id: 'regenie.abc123', phenotype_columns: ['alpha', 'beta']]
                input[1] = file('${predictions}', checkIfExists: true)
                """
            }
        }

        then {
            assert function.success
        }
    }

    test("a batch member REGENIE silently dropped from Step 1 fails the run by name") {
        function "validateRegenieFitPredictionCoverage"

        when {
            def predictions = resource(outputDir, 'coverage/dropped_pred.list', 'alpha /work/fit_1.loco.gz\n')
            function {
                """
                input[0] = [id: 'regenie.abc123', phenotype_columns: ['alpha', 'beta']]
                input[1] = file('${predictions}', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.join('\n').contains("produced no prediction for analysis(es) 'beta'") },
                { assert function.stdout.join('\n').contains('fewer than 10 cases') },
            )
        }
    }

    test("a Step 2 column that produced no result fails the run by name") {
        function "validateRegenieStep2Attribution"

        when {
            function {
                """
                input[0] = [id: 'regenie.abc123', phenotype_columns: ['alpha', 'beta']]
                input[1] = ['alpha']
                """
            }
        }

        then {
            assertAll(
                { assert function.failed },
                { assert function.stdout.join('\n').contains("produced no result for analysis(es) 'beta'") },
            )
        }
    }

    // A process output that resolves to one file arrives as a bare `java.nio.file.Path`, which iterates
    // over its own name elements. A one-member batch is exactly when that happens, so the normalisation is
    // pinned on the bare path and not only on the list that is easy to reason about.
    test("a bare path normalises to a one-element file list, not to its path segments") {
        function "normaliseFileList"

        when {
            def prepared = resource(outputDir, 'normalise/alpha.pheno', 'FID\tIID\tPHENO\n')
            function {
                """
                input[0] = file('${prepared}', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result.size() == 1 },
                { assert function.result.first().toString().endsWith('alpha.pheno') },
            )
        }
    }

    test("an absent optional file normalises to an empty list") {
        function "normaliseFileList"

        when {
            function {
                """
                input[0] = []
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == [] },
            )
        }
    }
}

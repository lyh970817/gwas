process {
    // The pipeline's own bare `withName:` blocks for these two processes match this scope too, because
    // nf-test loads the root `nextflow.config` for every test, and their publication closures would evaluate
    // an unset `params.outdir` into a literal `null/` tree beside the test. Publication is pipeline policy
    // rather than this composition's contract, so it is suppressed here; the real-mode pipeline route test is
    // where the published layout is asserted.
    withName: 'MPH_REML|SUMMARISE_MPH_RESULT' {
        publishDir = []
    }
}
